<?xml version="1.0" ?>
<robot name="turtlebot3_rotating_sensor"
  xmlns:xacro="http://ros.org/wiki/xacro">


  <!-- Note the base footprint is used to calculate the
  turtlebot's position in global (x,y) coordinates. -->

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.010" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 3.14"/>
      <geometry>
        <mesh filename="package://turtlebot3_rotating_sensor/meshes/turtlebot_vehicle_model.dae" scale="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.165" rpy="0 0 0"/>
      <geometry>
        <box size="0.140 0.140 0.33"/>
      </geometry>
    </collision>

    <!-- Note that the following inertial calculation is for a simple 
    box like shape. The mass value is the weight of the turtlebot, and
    the dimensions of the collision box were used to arrive at the
    following results. Note that this simple box inertia calculation
    assumes that the mass is equally distributed throughout the shape
    of the box, for the real life vehicle, this is not the case. On
    the vehicle, most of the mass is concentrated near the bottom of
    the vehicle where the driving servos, battery, and various boards
    and wires are housed. By default, the inertial origin is right on
    the base link, near the bottom of the model. We do not shift the
    origin of the inertial model because we would like to keep the
    center of mass for this vehicle near the bottom of the robot
    to more closely match the real life vehicle. -->

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0.13"/>
      <mass value="1.793"/>
      <inertia ixx="1.92e-02" ixy="0" ixz="0" iyy="1.92e-02" iyz="0" izz="5.857e-03" />
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.068" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <sensor name="tb3_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
        <plugin name="turtlebot3_imu" filename="libgazebo_ros_imu_sensor.so">
          <ros>
            <!-- <namespace>/tb3</namespace> -->
            <remapping>~/out:=imu</remapping>
          </ros>
        </plugin>
      </sensor>
  </link>

  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="-0.015 0 0.193" rpy="0 0 0"/>
  </joint>

  <link name="base_scan">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_rotating_sensor/meshes/lds.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0.015 0 -0.0065" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.0315" radius="0.055"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.114" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>

    <sensor name="hls_lfcd_lds" type="ray">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <pose>-0.032 0 0.171 0 0 0</pose>
        <update_rate>5</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1.000000</resolution>
              <min_angle>0.000000</min_angle>
              <max_angle>6.280000</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.120000</min>
            <max>3.5</max>
            <resolution>0.015000</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="turtlebot3_laserscan" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <!-- <namespace>/tb3</namespace> -->
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>base_scan</frame_name>
        </plugin>
      </sensor>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0.032 0.08 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10000" velocity="1000"/>
    <joint_properties damping="1.0" friction="100.0"/>
  </joint>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_rotating_sensor/meshes/tire.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="2.8498940e-02" />
      <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09" iyy="1.1192413e-05" iyz="-1.4400107e-11" izz="2.0712558e-05" />
    </inertial>
  </link>

  <!-- Wheel contact stiffness kp and kd have been adjusted
  These values have been chosen since they are high enough 
  so that the wheel doesn't sink into the ground, but still
  low enough to not be "too rigid" which causes poor contact
  detection between the wheel and the ground. Both the left
  and right wheel should each have two constant (non-flickering)
  points of contact with the ground. Stable contact points
  stop the model from drifting laterally in simulation. -->

  <gazebo reference="wheel_left_link">
    <!-- Set static contact stiffness, higher is more rigid -->
    <kp>5000.0</kp>
    <!-- Set dynamic contact stiffness, higher is more rigid -->
    <kd>5000.0</kd>
    <!-- Set static friction coefficient -->
    <mu1>100000</mu1>
    <!-- Set dynamic friction coefficient -->
    <mu2>10000</mu2>
  </gazebo>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0.032 -0.080 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10000" velocity="1000"/>
    <joint_properties damping="1.0" friction="100.0"/>
  </joint>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_rotating_sensor/meshes/tire.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="2.8498940e-02" />
      <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09" iyy="1.1192413e-05" iyz="-1.4400107e-11" izz="2.0712558e-05" />
    </inertial>
  </link>

  <gazebo reference="wheel_right_link">
    <!-- Set static contact stiffness, higher is more rigid -->
    <kp>5000.0</kp>
    <!-- Set dynamic contact stiffness, higher is more rigid -->
    <kd>5000.0</kd>
    <!-- Set static friction coefficient -->
    <mu1>100000</mu1>
    <!-- Set dynamic friction coefficient -->
    <mu2>10000</mu2>
  </gazebo>

 
  <!-- Note the caster wheel is modeled as a "frictionless" 
  fixed sphere since there is no "ball" joint in URDF files 
  like there is in the SDF format. The caster wheel will not 
  roll in simulation, it is just a placeholder to have three 
  points of contact between the turtlebot and the ground. -->

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="-0.049 0 -0.005" rpy="0 0 0"/>
  </joint>

  <link name="caster_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005" />
      <inertia ixx="7.2e-8" ixy="0.0" ixz="0.0" iyy="7.2e-8" iyz="0.0" izz="7.2e-8" />
    </inertial>
  </link>

  <!-- Setting the caster wheel friction very low, 
  i.e. making it almost "frictionless". -->
  <gazebo reference="caster_wheel">
    <mu1 value="0.001"/>
    <mu2 value="0.001"/>
  </gazebo>


  <!-- Rotating Frame Components -->

  <!-- Here, the rotating frame's joint is modeled to be
  "frictionless". This is done to limit the drifting of
  the turtlebot's trajectory as the frame spins around 
  atop the turtlebot. In real life, as the frame spins,
  the wheels have enough friction to resist the torque
  cased by the rotating frame on the vehicle's body. In 
  simulation we try to mimic this effect by setting this 
  joint friction and damping to be very low. -->

  <joint name="rotating_frame_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotating_frame_link"/>
    <origin xyz="0 0 0.355" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="20" velocity="10"/>
    <dynamics damping="0.00001" friction="0.00001"/>
  </joint>

  <link name="rotating_frame_link">
    <visual>
      <origin xyz="0 0 -0.037" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_rotating_sensor/meshes/rotating_frame_assembly.dae"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.39 0.035 0.03"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0.025 0 1.57"/>
      <mass value="5.4e-02" />
      <inertia ixx="4.683e-4" ixy="0" ixz="0" iyy="4.43e-6" iyz="1.111e-5" izz="4.713e-04" />
    </inertial>
  </link>

  <gazebo reference="rotating_frame_link">
    <!-- Set static contact stiffness, higher is more rigid -->
    <kp>10000000000000000000000.0</kp>
    <!-- Set dynamic contact stiffness, higher is more rigid -->
    <kd>10000000000000000000000.0</kd>
    <!-- Set static friction coefficient -->
    <mu1>1000</mu1>
    <!-- Set dynamic friction coefficient -->
    <mu2>100</mu2>
  </gazebo>

  <joint name="sensor_joint" type="fixed">
    <parent link="rotating_frame_link"/>
    <child link="sensor_link"/>
    <origin xyz="0.18 0 0.015" rpy="0 0 0"/>
  </joint> 

  <link name="sensor_link">
  </link>


  <!-- Plugins -->

  <!-- Differential Drive -->
  <gazebo>
    <plugin name="turtlebot3_diff_drive" filename="libgazebo_ros_diff_drive.so">

      <ros>
        <!-- <namespace>/tb3</namespace> -->
      </ros>

      <update_rate>30</update_rate>

      <!-- wheels -->
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>

      <!-- kinematics -->
      <wheel_separation>0.160</wheel_separation>
      <wheel_diameter>0.066</wheel_diameter>

      <!-- limits -->
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>

      <command_topic>cmd_vel</command_topic>

      <!-- output -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>

      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>

    </plugin>
  </gazebo>

  <!-- Joint Publisher -->
  <gazebo>
    <plugin name="turtlebot3_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <!-- <namespace>/tb3</namespace> -->
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>

      <!-- Publish the rotating frame joints in order here.
      These joints will appead in the joint state message
      denoted by their joint names in the "name" category
      in the order they are listed below. -->
      <joint_name>rotating_frame_joint</joint_name>
    </plugin>    
  </gazebo>

  <!-- Rotating Frame Velocity Controller -->
  <ros2_control name="GazeboSystem" type="system">
      <hardware>
          <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </hardware>

      <joint name="rotating_frame_joint">
          <command_interface name="velocity">
              <param name="min">0</param>
              <param name="max">5</param>
          </command_interface>
          <state_interface name="position">

            <!-- Use this parameter here to set the
            intial angular position of the frame -->
            <param name="initial_value">0.0</param>

          </state_interface>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
      </joint>
  </ros2_control>

  <gazebo>
      <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
          <!-- This is the yaml file that describes the controllers we want to use -->
          <parameters>$(find turtlebot3_rotating_sensor)/controller_config/joint_controller.yaml</parameters>
          <robot_param_node>/robot_state_publisher_node</robot_param_node>
      </plugin>
  </gazebo>

</robot>