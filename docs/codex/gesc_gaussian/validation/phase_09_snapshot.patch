+def validate_physical_evidence_coupling(
+    resolved_files,
+    metadata_input_path,
+    metadata_input,
+    target,
+    *,
+    stationary_preflight=False,
+):
+    """Prove retained physical inputs are the exact inputs being launched."""
+
+    by_label = {
+        item["label"]: Path(item["resolved_path"])
+        for item in resolved_files
+    }
+    assignments = {
+        str(token).split(":=", 1)[0]: str(token).split(":=", 1)[1]
+        for token in target
+        if ":=" in str(token)
+    }
+    assignment_labels = {
+        "calibration": "photoresistor_calibration_file",
+        "controller": "controller_config_filepath",
+        "filter": "filter_config_filepath",
+        "rotation": "rotate_frame_config_filepath",
+    }
+    missing_arguments = sorted(
+        argument
+        for argument in assignment_labels.values()
+        if argument not in assignments
+    )
+    if missing_arguments:
+        raise ValueError(
+            "physical target is missing evidence-coupled arguments: "
+            + ", ".join(missing_arguments)
+        )
+    expected_paths = {"metadata": Path(metadata_input_path)}
+    expected_paths.update({
+        label: Path(assignments[argument])
+        for label, argument in assignment_labels.items()
+    })
+    mismatches = []
+    for label, expected in expected_paths.items():
+        try:
+            expected_resolved = expected.expanduser().resolve(strict=True)
+        except OSError as exc:
+            raise ValueError(
+                f"physical launched input is unavailable: {label}={expected}"
+            ) from exc
+        if by_label[label] != expected_resolved:
+            mismatches.append(label)
+    fixed_names = {
+        "selected_profile": "phase09_selected_profile.yaml",
+        "wrapper": "gesc_gaussian_two_source_voltage.bash",
+        "launch": "gesc_gaussian_two_source.launch.xml",
+        "vicon_server": "phase09_vicon_evidence_server.py",
+    }
+    for label, expected_name in fixed_names.items():
+        if by_label[label].name != expected_name:
+            mismatches.append(label)
+    parameter_names = {
+        Path(str(value)).name
+        for value in metadata_input.get("parameter_files", ())
+    }
+    if by_label["selected_profile"].name not in parameter_names:
+        mismatches.append("selected_profile metadata.parameter_files")
+    tracking = metadata_input.get('evaluation_tracking')
+    commissioned_vicon_hash = (
+        tracking.get('server_script_sha256')
+        if isinstance(tracking, dict)
+        else None
+    )
+    if (
+        not isinstance(commissioned_vicon_hash, str)
+        or not re.fullmatch(r'[0-9a-f]{64}', commissioned_vicon_hash)
+        or _sha256_file(by_label['vicon_server']) != commissioned_vicon_hash
+    ):
+        mismatches.append('vicon_server metadata SHA-256')
+    template_path = by_label['metadata_template']
+    if template_path.name not in {
+        'phase09_primary_metadata.yaml',
+        'phase09_secondary_metadata.yaml',
+    }:
+        mismatches.append('metadata_template')
+    try:
+        template_input = yaml.safe_load(
+            template_path.read_text(encoding='utf-8')
+        )
+        validator = (
+            validate_phase09_stationary_metadata_template
+            if stationary_preflight
+            else validate_phase09_runtime_metadata_template
+        )
+        validator(template_input, metadata_input)
+    except (OSError, yaml.YAMLError, ValueError) as exc:
+        raise ValueError(
+            f'physical runtime metadata/template coupling failed: {exc}'
+        ) from exc
+    try:
+        from turtlebot3_vehicle_nodes.photoresistor_node.photoresistor_adapter import (
+            validate_phase09_motion_inputs,
+            validate_phase09_stationary_preflight_inputs,
+        )
+        scenario_by_id = {
+            'phase09_selected_primary_r1p5_a45_ratio1to4': 'primary',
+            'phase09_selected_secondary_r1p5_a67p5_ratio1to4': 'secondary',
+        }
+        scenario = scenario_by_id[metadata_input.get('scenario_id')]
+        input_validator = (
+            validate_phase09_stationary_preflight_inputs
+            if stationary_preflight
+            else validate_phase09_motion_inputs
+        )
+        input_validator(
+            by_label['calibration'],
+            assignments['photoresistor_serial_port'],
+            metadata_input_path,
+            scenario,
+        )
+    except (ImportError, KeyError, OSError, ValueError) as exc:
+        raise ValueError(
+            f'physical commissioning owner validation failed: {exc}'
+        ) from exc
+    if mismatches:
+        raise ValueError(
+            "physical evidence files do not match launched inputs: "
+            + ", ".join(sorted(set(mismatches)))
+        )
+
