+def rotation_status_error(
+    message,
+    stationary_preflight=False,
+    rotation_authorized=True,
+):
+    """Return why the selected rotation owner is not operational."""
+
+    try:
+        status = parse_rotation_status_message(message)
+        command = status['last_command_rpm']
+        if command is not None and type(command) not in (int, float):
+            raise ValueError('rotation command is not an exact number')
+        command = None if command is None else float(command)
+    except (TypeError, ValueError, KeyError) as exc:
+        return f'operational rotation status heartbeat is invalid: {exc}'
+    booleans_valid = all(
+        isinstance(status[name], bool)
+        for name in (
+            'authorization_active',
+            'ever_authorized',
+            'hardware_initialized',
+            'timekeeper_started',
+        )
+    )
+    schema_valid = bool(
+        type(status['schema_version']) is int
+        and status['schema_version'] == 1
+    )
+    if stationary_preflight:
+        valid = bool(
+            schema_valid
+            and status['state'] == 'PASSIVE_STATIONARY_PREFLIGHT'
+            and booleans_valid
+            and status['authorization_active'] is False
+            and status['ever_authorized'] is False
+            and status['hardware_initialized'] is False
+            and status['timekeeper_started'] is True
+            and command is not None
+            and math.isfinite(command)
+            and math.isclose(command, 0.0, abs_tol=1e-9)
+            and status['fault_reason'] is None
+        )
+    elif not rotation_authorized:
+        # MBuck 2026-08-01: Stage 1 must prove that the selected mechanism is
+        # still passive and has not initialized GPIO before recorder authority.
+        valid = bool(
+            schema_valid
+            and status['state'] == 'WAITING_AUTHORIZATION'
+            and booleans_valid
+            and status['authorization_active'] is False
+            and status['ever_authorized'] is False
+            and status['hardware_initialized'] is False
+            and status['timekeeper_started'] is False
+            and command is None
+            and status['fault_reason'] is None
+        )
+    else:
+        valid = bool(
+            schema_valid
+            and status['state'] == 'RUNNING'
+            and booleans_valid
+            and status['authorization_active'] is True
+            and status['ever_authorized'] is True
+            and status['hardware_initialized'] is True
+            and status['timekeeper_started'] is True
+            and command is not None
+            and math.isfinite(command)
+            and not math.isclose(command, 0.0, abs_tol=1e-9)
+            and status['fault_reason'] is None
+        )
+    return None if valid else 'operational rotation status heartbeat is invalid'
+
