+#!/usr/bin/env python3
+
+"""Phase 09-only Vicon Tracker to TurtleBot evidence server.
+
+Run this standalone script on the Windows Vicon computer. It intentionally
+does not replace or import the historical seven-float lab server.
+"""
+
+import argparse
+import hashlib
+import json
+import math
+from pathlib import Path
+import socket
+import time
+import uuid
+
+
+PROTOCOL_MAGIC = "DSIM_PHASE09_VICON"
+PROTOCOL_VERSION = 1
+DEFAULT_HOST = "192.168.1.6"
+DEFAULT_PORT = 12346
+_NONCE_LENGTH = 32
+
+
+def _script_sha256():
+    digest = hashlib.sha256()
+    with Path(__file__).open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _name(value, label):
+    if not isinstance(value, str) or value != value.strip():
+        raise ValueError(f"{label} must be an explicit normalized string")
+    name = value
+    if not name or len(name) > 128 or any(ord(char) < 32 for char in name):
+        raise ValueError(f"{label} must be a nonempty printable name")
+    return name
+
+
+def _lower_hex(value, length, label):
+    # MBuck 2026-08-01: Reject type-coerced protocol identities.
+    if not isinstance(value, str):
+        raise ValueError(f"{label} must be an explicit string")
+    if len(value) != length or any(
+        character not in "0123456789abcdef" for character in value
+    ):
+        raise ValueError(f"{label} must be {length} lowercase hex digits")
+    return value
+
+
+def _strict_object_pairs(pairs):
+    document = {}
+    for key, value in pairs:
+        if key in document:
+            raise ValueError(f"duplicate JSON key: {key}")
+        document[key] = value
+    return document
+
+
+def strict_json_loads(data):
+    """Decode one strict UTF-8 JSON object without NaN or duplicate keys."""
+
+    if not isinstance(data, (bytes, bytearray, memoryview)):
+        raise ValueError("protocol datagram must be bytes")
+    try:
+        text = bytes(data).decode("utf-8", errors="strict")
+        document = json.loads(
+            text,
+            object_pairs_hook=_strict_object_pairs,
+            parse_constant=lambda value: (_ for _ in ()).throw(
+                ValueError(f"nonfinite JSON number: {value}")
+            ),
+        )
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise ValueError(f"invalid protocol JSON: {exc}") from exc
+    if not isinstance(document, dict):
+        raise ValueError("protocol JSON must be an object")
+    return document
+
+
+def decode_handshake(data, expected_subject, expected_segment):
+    """Validate one Phase 09 client handshake and return its nonce."""
+
+    document = strict_json_loads(data)
+    expected = {
+        "magic": PROTOCOL_MAGIC,
+        "version": PROTOCOL_VERSION,
+        "kind": "hello",
+        "subject_name": _name(expected_subject, "subject"),
+        "segment_name": _name(expected_segment, "segment"),
+    }
+    if type(document.get("version")) is not int:
+        raise ValueError("handshake version must be an exact integer")
+    for key, value in expected.items():
+        if document.get(key) != value:
+            raise ValueError(f"handshake {key} does not match commissioned value")
+    nonce = _lower_hex(
+        document.get("client_nonce"),
+        _NONCE_LENGTH,
+        "handshake client_nonce",
+    )
+    if set(document) != {*expected, "client_nonce"}:
+        raise ValueError("handshake contains unreviewed fields")
+    return nonce
+
+
+def encode_frame(
+    *,
+    client_nonce,
+    server_session,
+    sequence,
+    tracker_frame,
+    subject_name,
+    segment_name,
+    translation_mm,
+    quaternion_xyzw,
+    translation_occluded,
+    rotation_occluded,
+    server_script_sha256,
+    server_time_unix_ns=None,
+):
+    """Encode one identity- and frame-bearing Vicon evidence datagram."""
+
+    translation = list(translation_mm)
+    quaternion = list(quaternion_xyzw)
+    if len(translation) != 3 or len(quaternion) != 4:
+        raise ValueError("Vicon frame requires xyz translation and xyzw quaternion")
+    if any(type(value) not in (int, float) for value in (*translation, *quaternion)):
+        raise ValueError("Vicon frame values must be exact numbers")
+    translation = [float(value) for value in translation]
+    quaternion = [float(value) for value in quaternion]
+    if not all(math.isfinite(value) for value in (*translation, *quaternion)):
+        raise ValueError("Vicon frame values must be finite")
+    integer_values = {
+        "sequence": sequence,
+        "tracker_frame": tracker_frame,
+    }
+    if server_time_unix_ns is not None:
+        integer_values["server_time_unix_ns"] = server_time_unix_ns
+    if any(type(value) is not int or value <= 0 for value in integer_values.values()):
+        raise ValueError("sequence/frame/time values must be positive integers")
+    if type(translation_occluded) is not bool or type(rotation_occluded) is not bool:
+        raise ValueError("Vicon occlusion values must be exact booleans")
+    document = {
+        "magic": PROTOCOL_MAGIC,
+        "version": PROTOCOL_VERSION,
+        "kind": "frame",
+        "client_nonce": _lower_hex(client_nonce, _NONCE_LENGTH, "client_nonce"),
+        "server_session": _lower_hex(server_session, 32, "server_session"),
+        "sequence": sequence,
+        "tracker_frame": tracker_frame,
+        "server_time_unix_ns": (
+            time.time_ns() if server_time_unix_ns is None else server_time_unix_ns
+        ),
+        "subject_name": _name(subject_name, "subject"),
+        "segment_name": _name(segment_name, "segment"),
+        "translation_mm": translation,
+        "quaternion_xyzw": quaternion,
+        "translation_occluded": translation_occluded,
+        "rotation_occluded": rotation_occluded,
+        "valid": not (translation_occluded or rotation_occluded),
+        "server_script_sha256": _lower_hex(
+            server_script_sha256,
+            64,
+            "server_script_sha256",
+        ),
+    }
+    return json.dumps(
+        document,
+        allow_nan=False,
+        separators=(",", ":"),
+        sort_keys=True,
+    ).encode("utf-8")
+
+
+def _vicon_client():
+    # Imported only on the Windows Vicon host so this source remains host-testable.
+    from vicon_dssdk import ViconDataStream  # pylint: disable=import-outside-toplevel
+
+    client = ViconDataStream.Client()
+    client.Connect("localhost:801")
+    if not client.IsConnected():
+        raise RuntimeError("Vicon DataStream connection to localhost:801 failed")
+    client.EnableSegmentData()
+    if not client.GetFrame():
+        raise RuntimeError("Vicon Tracker did not provide an initial frame")
+    return client
+
+
+def list_tracking(client):
+    """Return the live Tracker subjects and their segment names."""
+
+    result = {}
+    for subject in client.GetSubjectNames():
+        result[str(subject)] = [str(name) for name in client.GetSegmentNames(subject)]
+    return result
+
+
+def serve(client, host, port, subject, segment):
+    """Serve advancing frames to the most recent matching Phase 09 client."""
+
+    endpoint = (str(host), int(port))
+    server_hash = _script_sha256()
+    server_session = uuid.uuid4().hex
+    udp = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+    udp.bind(endpoint)
+    udp.settimeout(0.25)
+    print(f"Phase 09 Vicon evidence server listening on {host}:{port}")
+    print(f"subject={subject!r} segment={segment!r} script_sha256={server_hash}")
+    client_address = None
+    client_nonce = None
+    sequence = 0
+    try:
+        while True:
+            if client_address is None:
+                try:
+                    handshake, candidate = udp.recvfrom(4096)
+                    client_nonce = decode_handshake(handshake, subject, segment)
+                    client_address = candidate
+                    print(f"Phase 09 client accepted at {client_address}")
+                except socket.timeout:
+                    continue
+                except ValueError as exc:
+                    print(f"Rejected Phase 09 handshake: {exc}")
+                    continue
+            else:
+                udp.setblocking(False)
+                try:
+                    while True:
+                        handshake, candidate = udp.recvfrom(4096)
+                        nonce = decode_handshake(handshake, subject, segment)
+                        if candidate != client_address or nonce != client_nonce:
+                            client_address = candidate
+                            client_nonce = nonce
+                            server_session = uuid.uuid4().hex
+                            sequence = 0
+                            print(f"Phase 09 client replaced at {client_address}")
+                except BlockingIOError:
+                    pass
+                except ValueError as exc:
+                    print(f"Rejected Phase 09 handshake: {exc}")
+                finally:
+                    udp.settimeout(0.25)
+
+            if not client.GetFrame():
+                continue
+            tracker_frame = int(client.GetFrameNumber())
+            translation_result = client.GetSegmentGlobalTranslation(subject, segment)
+            rotation_result = client.GetSegmentGlobalRotationQuaternion(subject, segment)
+            sequence += 1
+            payload = encode_frame(
+                client_nonce=client_nonce,
+                server_session=server_session,
+                sequence=sequence,
+                tracker_frame=tracker_frame,
+                subject_name=subject,
+                segment_name=segment,
+                translation_mm=translation_result[0],
+                quaternion_xyzw=rotation_result[0],
+                translation_occluded=translation_result[1],
+                rotation_occluded=rotation_result[1],
+                server_script_sha256=server_hash,
+            )
+            udp.sendto(payload, client_address)
+    finally:
+        udp.close()
+
+
+def _parser():
+    parser = argparse.ArgumentParser(
+        description="Serve identity-bearing Phase 09 Vicon evaluation evidence."
+    )
+    parser.add_argument("--host", default=DEFAULT_HOST)
+    parser.add_argument("--port", type=int, default=DEFAULT_PORT)
+    parser.add_argument("--subject")
+    parser.add_argument("--segment")
+    parser.add_argument("--list-tracking", action="store_true")
+    return parser
+
+
+def main(arguments=None):
+    """Connect to Tracker, optionally list identities, then serve evidence."""
+
+    args = _parser().parse_args(arguments)
+    if not 1 <= args.port <= 65535:
+        raise SystemExit("--port must be between 1 and 65535")
+    client = _vicon_client()
+    if args.list_tracking:
+        print(json.dumps(list_tracking(client), indent=2, sort_keys=True))
+        return 0
+    try:
+        subject = _name(args.subject, "--subject")
+        segment = _name(args.segment, "--segment")
+    except ValueError as exc:
+        raise SystemExit(str(exc)) from exc
+    tracking = list_tracking(client)
+    if subject not in tracking or segment not in tracking[subject]:
+        available = json.dumps(tracking, sort_keys=True)
+        raise SystemExit(
+            f"selected subject/segment is not live in Tracker; available={available}"
+        )
+    try:
+        serve(client, args.host, args.port, subject, segment)
+    except KeyboardInterrupt:
+        print("Phase 09 Vicon evidence server stopped")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
