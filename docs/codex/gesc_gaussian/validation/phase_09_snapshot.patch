+from turtlebot3_vehicle_nodes.odometry_node.phase09_vicon_evidence_node import (
+    CANONICAL_VICON_FRAME,
+    CANONICAL_VICON_STATUS_TOPIC,
+    CANONICAL_VICON_TOPIC,
+    decode_vicon_datagram,
+    DEFAULT_VICON_SERVER_IP,
+    DEFAULT_VICON_SERVER_PORT,
+    encode_vicon_handshake,
+    parse_vicon_evidence_arguments,
+    Phase09ViconEvidenceNode,
+    ViconEvaluationFrame,
+    ViconUdpReceiver,
+)
+
+
+NONCE = "a" * 32
+SESSION = "b" * 32
+SERVER_HASH = "c" * 64
+SUBJECT = "TurtleBot3"
+SEGMENT = "TurtleBot3"
+PACKAGE_ROOT = Path(__file__).resolve().parents[1]
+
+
+def _document(**overrides):
+    document = {
+        "magic": "DSIM_PHASE09_VICON",
+        "version": 1,
+        "kind": "frame",
+        "client_nonce": NONCE,
+        "server_session": SESSION,
+        "sequence": 1,
+        "tracker_frame": 100,
+        "server_time_unix_ns": 1_800_000_000_000_000_000,
+        "subject_name": SUBJECT,
+        "segment_name": SEGMENT,
+        "translation_mm": [1250.0, -500.0, 250.0],
+        "quaternion_xyzw": [0.0, 0.0, 0.0, 2.0],
+        "translation_occluded": False,
+        "rotation_occluded": False,
+        "valid": True,
+        "server_script_sha256": SERVER_HASH,
+    }
+    document.update(overrides)
+    return document
+
+
+def _packet(**overrides):
+    return json.dumps(
+        _document(**overrides),
+        allow_nan=False,
+        separators=(",", ":"),
+        sort_keys=True,
+    ).encode("utf-8")
+
+
+def _decode(data, **overrides):
+    arguments = {
+        "expected_nonce": NONCE,
+        "expected_subject": SUBJECT,
+        "expected_segment": SEGMENT,
+        "expected_server_script_sha256": SERVER_HASH,
+    }
+    arguments.update(overrides)
+    return decode_vicon_datagram(data, **arguments)
+
+
+def test_vicon_datagram_converts_mm_once_and_normalizes_quaternion():
+    frame = _decode(_packet())
+
+    assert frame.position_m == pytest.approx((1.25, -0.5, 0.25))
+    assert frame.quaternion_xyzw == pytest.approx((0.0, 0.0, 0.0, 1.0))
+    assert frame.subject_name == SUBJECT
+    assert frame.segment_name == SEGMENT
+    assert frame.sequence == 1
+    assert frame.tracker_frame == 100
+    assert math.isclose(
+        math.sqrt(sum(value * value for value in frame.quaternion_xyzw)),
+        1.0,
+    )
+
+
+def test_stationary_pose_with_advancing_sequence_and_frame_is_valid():
+    first = _decode(_packet())
+    second = _decode(
+        _packet(sequence=2, tracker_frame=101),
+        previous_session=first.server_session,
+        previous_sequence=first.sequence,
+        previous_tracker_frame=first.tracker_frame,
+    )
+
+    assert second.position_m == first.position_m
+    assert second.sequence == 2
+    assert second.tracker_frame == 101
+
+
