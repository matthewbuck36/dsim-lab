+            ],
+            [
+                progress.path_length_m,
+                progress.net_displacement_m,
+                progress.outward_progress_m,
+                (
+                    progress.window_path_length_m
+                    if window_valid
+                    else 0.0
+                ),
+                (
+                    progress.window_displacement_m
+                    if window_valid
+                    else 0.0
+                ),
+                1.0 if window_valid else 0.0,
