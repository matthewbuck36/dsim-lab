+    def _nonnegative_int(self, name):
+        value = int(self.get_parameter(name).value)
+        if value < 0:
+            raise ValueError(f"{name} must be nonnegative")
+        return value
+
+    def _string(self, name):
+        return str(self.get_parameter(name).value)
