+def resolve_evidence_files(specifications, required_labels=()):
+    """Validate labeled evidence inputs before any child process starts."""
+
+    resolved = []
+    labels = set()
+    paths = set()
+    for specification in specifications:
+        value = str(specification)
+        if "=" not in value:
+            raise ValueError(
+                "evidence file must use LABEL=PATH syntax: " + value
+            )
+        label, requested = value.split("=", 1)
+        if not EVIDENCE_LABEL_PATTERN.fullmatch(label):
+            raise ValueError(f"invalid evidence-file label: {label!r}")
+        if label in labels:
+            raise ValueError(f"duplicate evidence-file label: {label}")
+        if not requested:
+            raise ValueError(f"evidence-file path is empty: {label}")
+        requested_path = Path(requested).expanduser()
+        try:
+            resolved_path = requested_path.resolve(strict=True)
+        except OSError as exc:
+            raise ValueError(
+                f"evidence file is unavailable: {label}={requested}"
+            ) from exc
+        if not resolved_path.is_file():
+            raise ValueError(
+                f"evidence file is not a regular file: {label}={requested}"
+            )
+        try:
+            with resolved_path.open("rb"):
+                pass
+        except OSError as exc:
+            raise ValueError(
+                f"evidence file is unreadable: {label}={requested}"
+            ) from exc
+        if resolved_path in paths:
+            raise ValueError(
+                "duplicate resolved evidence-file path: "
+                + str(resolved_path)
+            )
+        labels.add(label)
+        paths.add(resolved_path)
+        resolved.append({
+            "label": label,
+            "requested_path": requested,
+            "resolved_path": str(resolved_path),
+        })
+    missing = sorted(set(required_labels) - labels)
+    if missing:
+        raise ValueError(
+            "required evidence-file labels are missing: " + ", ".join(missing)
+        )
+    return resolved
+
+
+def capture_evidence_files(run_directory, resolved_files, required_labels=()):
+    """Copy and hash immutable run inputs into the unique run directory."""
+
+    run_directory = Path(run_directory).resolve()
+    configuration_directory = run_directory / "configuration"
+    configuration_directory.mkdir()
+    retained = []
+    for item in resolved_files:
+        label = item["label"]
+        source = Path(item["resolved_path"])
+        destination_directory = configuration_directory / label
+        destination_directory.mkdir()
+        destination = destination_directory / source.name
+        temporary = destination.with_name(destination.name + ".tmp")
+        source_hash = _sha256_file(source)
+        shutil.copyfile(source, temporary)
+        os.replace(temporary, destination)
+        retained_hash = _sha256_file(destination)
+        if retained_hash != source_hash:
+            raise RuntimeError(
+                f"evidence-file hash changed during capture: {label}"
+            )
+        retained.append({
+            **item,
+            "retained_path": str(destination.relative_to(run_directory)),
+            "size_bytes": destination.stat().st_size,
+            "sha256": retained_hash,
+        })
+    document = {
+        "schema_version": 1,
+        "captured_at_utc": _iso_now(),
+        "required_labels": list(required_labels),
+        "files": retained,
+    }
+    manifest_path = configuration_directory / "manifest.yaml"
+    atomic_yaml(manifest_path, document)
+    return document
+
