+@dataclass(frozen=True)
+class QuadraticFit:
+    """Weighted local quadratic model and its validation diagnostics."""
+
+    intercept: float
+    gradient: np.ndarray
+    hessian: np.ndarray
+    positive_hessian: np.ndarray
+    residual_rms: float
