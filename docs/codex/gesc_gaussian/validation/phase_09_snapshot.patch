+            self.sent = []
+            self.closed = False
+
+        def bind(self, endpoint):
+            self.endpoint = endpoint
+
+        def settimeout(self, timeout):
+            self.timeout = timeout
+
+        def setblocking(self, blocking):
+            self.blocking = blocking
+
+        def recvfrom(self, _size):
