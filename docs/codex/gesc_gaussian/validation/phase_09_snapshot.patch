+def _finite_value(value):
+    try:
+        number = float(value)
+    except (TypeError, ValueError):
+        return None
+    return number if math.isfinite(number) else None
+
+
+def _first_message_value(message, field, valid_field=None):
+    if message is None:
+        return None
+    if valid_field is not None and not bool(getattr(message, valid_field, False)):
+        return None
+    values = getattr(message, field, ())
+    if not values:
+        return None
+    return _finite_value(values[0])
+
+
+def _format_live_value(value):
+    return "n/a" if value is None else f"{value:.3f}"
+
+
+def _safe_terminal_line(line, stream=None):
+    """Write one best-effort terminal line without endangering evidence."""
+
+    stream = sys.stdout if stream is None else stream
+    try:
+        stream.write(str(line).rstrip() + "\n")
+        stream.flush()
+        return True
+    except (BrokenPipeError, OSError, ValueError):
+        return False
+
