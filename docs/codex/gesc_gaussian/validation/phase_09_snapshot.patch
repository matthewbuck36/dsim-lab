+            "mode": "simulation",
+            "algorithm_profile": "robust_gaussian_v1",
+            "scenario_id": "timing-input-test",
+            "operator_notes": "",
+        },
+    )
+    startup_calls = []
+
+    def forbidden_start(*_args, **_kwargs):
+        startup_calls.append("started")
+        pytest.fail("invalid timing reached ROS/process startup")
+
+    monkeypatch.setattr(recorder.rclpy, "init", forbidden_start)
+    monkeypatch.setattr(recorder, "_process", forbidden_start)
+
+    with pytest.raises(ValueError) as exc_info:
+        recorder.run(arguments)
+
+    option = "--" + field.replace("_", "-")
+    assert option in str(exc_info.value)
+    assert startup_calls == []
+
+
+def test_passive_diagnostic_subscriptions_are_opt_in():
+    entries = {
+        'cost_breakdown': {'alias': 'cost_breakdown'},
+        'gesc_diagnostics': {'alias': 'gesc_diagnostics'},
+    }
+
+    assert select_live_diagnostic_entries(entries, 0.0) == []
+    assert [
+        entry['alias']
+        for entry in select_live_diagnostic_entries(entries, 1.0)
+    ] == ['cost_breakdown', 'gesc_diagnostics']
