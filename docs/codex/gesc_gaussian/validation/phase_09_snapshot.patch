+#!/usr/bin/env bash
+
+# Phase 09 selected physical entry point. The operator ends a run with Ctrl+C.
+set -euo pipefail
+
+usage() {
+    echo "usage: $0 --scenario primary|secondary --serial-device /dev/serial/by-id/... [--calibration-file PATH] [--runs-root PATH]" >&2
+}
+
+PHASE09_SCENARIO=""
+PHASE09_SERIAL_DEVICE=""
+PHASE09_CALIBRATION_FILE=""
+PHASE09_RUNS_ROOT="${HOME}/Experiments/GESC-Gaussian/runs/phase09_physical"
+PHASE09_WORKSPACE="${PHASE09_ROS2_WS:-${HOME}/ros2_ws}"
+
+while (($#)); do
+    case "$1" in
+        --scenario)
+            PHASE09_SCENARIO="${2:-}"
+            shift 2
+            ;;
+        --serial-device)
+            PHASE09_SERIAL_DEVICE="${2:-}"
+            shift 2
+            ;;
+        --calibration-file)
+            PHASE09_CALIBRATION_FILE="${2:-}"
+            shift 2
+            ;;
+        --runs-root)
+            PHASE09_RUNS_ROOT="${2:-}"
+            shift 2
+            ;;
+        -h|--help)
+            usage
+            exit 0
+            ;;
+        *)
+            usage
+            exit 2
+            ;;
+    esac
+done
+
+if [[ "$PHASE09_SCENARIO" != "primary" && "$PHASE09_SCENARIO" != "secondary" ]]; then
+    usage
+    exit 2
+fi
+if [[ "$PHASE09_SERIAL_DEVICE" != /dev/serial/by-id/* ]]; then
+    echo "Phase 09 requires a reviewed stable /dev/serial/by-id/... device." >&2
+    exit 2
+fi
+if [[ ! -f "$PHASE09_WORKSPACE/install/setup.bash" ]]; then
+    echo "Build the reviewed Phase 09 workspace before running this wrapper." >&2
+    exit 2
+fi
+
+set +u
+source "$PHASE09_WORKSPACE/install/setup.bash"
+set -u
+
+PHASE09_TURTLEBOT_SHARE="$(ros2 pkg prefix --share turtlebot3_vehicle_nodes)"
+if [[ -z "$PHASE09_CALIBRATION_FILE" ]]; then
+    PHASE09_CALIBRATION_FILE="$PHASE09_TURTLEBOT_SHARE/config_files/gesc_gaussian/phase09_photoresistor_calibration.yaml"
+fi
+PHASE09_METADATA_FILE="$PHASE09_TURTLEBOT_SHARE/config_files/gesc_gaussian/phase09_${PHASE09_SCENARIO}_metadata.yaml"
+PHASE09_CONTROLLER_CONFIG="$PHASE09_TURTLEBOT_SHARE/config_files/controller_config_files/phase09_gesc_controller_full_rotation_voltage.json"
+PHASE09_FILTER_CONFIG="$PHASE09_WORKSPACE/src/ros_esc/ros_esc/filter_node/filter_config_files/turtlebot_vehicle/gradient_methods/gesc_filter_full_rotation.json"
+PHASE09_ROTATION_CONFIG="$PHASE09_WORKSPACE/src/ros_esc/ros_esc/rotate_frame_node/rotate_frame_config_files/turtlebot_vehicle/full_rotation.json"
+
+for PHASE09_REQUIRED_FILE in \
+    "$PHASE09_CALIBRATION_FILE" \
+    "$PHASE09_METADATA_FILE" \
+    "$PHASE09_CONTROLLER_CONFIG" \
+    "$PHASE09_FILTER_CONFIG" \
+    "$PHASE09_ROTATION_CONFIG"; do
+    if [[ ! -f "$PHASE09_REQUIRED_FILE" ]]; then
+        echo "Missing reviewed Phase 09 input: $PHASE09_REQUIRED_FILE" >&2
+        exit 2
+    fi
+done
+
+PHASE09_SOURCE_SCORE_ENABLED="$({
+    python3 - \
+        "$PHASE09_CALIBRATION_FILE" \
+        "$PHASE09_SERIAL_DEVICE" \
+        "$PHASE09_METADATA_FILE" \
+        "$PHASE09_SCENARIO" <<'PY'
+import pathlib
+import sys
+
+from turtlebot3_vehicle_nodes.photoresistor_node.photoresistor_adapter import (
+    validate_phase09_motion_inputs,
+)
+
+calibration_path = pathlib.Path(sys.argv[1]).resolve()
+serial_device = sys.argv[2]
+metadata_path = pathlib.Path(sys.argv[3]).resolve()
+scenario = sys.argv[4]
+try:
+    score_enabled = validate_phase09_motion_inputs(
+        calibration_path,
+        serial_device,
+        metadata_path,
+        scenario,
+    )
+except ValueError as exc:
+    raise SystemExit(str(exc)) from exc
+print("True" if score_enabled else "False")
+PY
+} 2>&1)" || {
+    echo "$PHASE09_SOURCE_SCORE_ENABLED" >&2
+    exit 2
+}
+
+if [[ ! -c "$PHASE09_SERIAL_DEVICE" ]]; then
+    echo "Reviewed serial device is unavailable or not a character device." >&2
+    exit 2
+fi
+
+exec ros2 run ros_esc record_run \
+    --mode physical \
+    --metadata-input "$PHASE09_METADATA_FILE" \
+    --runs-root "$PHASE09_RUNS_ROOT" \
+    -- \
+    ros2 launch turtlebot3_vehicle_nodes phase09_gesc_gaussian_counted_two_source.launch.xml \
+    sensor_name:=Photoresistor \
+    sensor_datatype:=Voltage \
+    sensor_units:=Volts \
+    input_encoder_data_into_filter:=True \
+    controller_odom_topic:=/odom \
+    pde_odom_topic:=/odom \
+    algorithm_pose_topic:=/odom \
+    gaussian_fill_pose_topic:=/odom \
+    rotating_frame_init_angular_position:=-90 \
+    use_sim_time:=False \
+    supervisor_use_sim_time:=False \
+    algorithm_profile:=robust_gaussian_v1 \
+    use_pde_extensions:=True \
+    enable_observability:=True \
+    observability_source_mode:=physical \
+    source_cost_topic:=/gesc_gaussian/source_cost \
+    recording_ready_required:=True \
+    recording_ready_stale_sec:=0.50 \
+    photoresistor_serial_port:="$PHASE09_SERIAL_DEVICE" \
+    photoresistor_baud_rate:=9600 \
+    photoresistor_serial_timeout_sec:=0.50 \
+    photoresistor_calibration_file:="$PHASE09_CALIBRATION_FILE" \
+    photoresistor_source_score_enabled:="$PHASE09_SOURCE_SCORE_ENABLED" \
+    rotate_frame_config_filepath:="$PHASE09_ROTATION_CONFIG" \
+    filter_config_filepath:="$PHASE09_FILTER_CONFIG" \
+    controller_config_filepath:="$PHASE09_CONTROLLER_CONFIG" \
+    convergence_min_fill_periods:=2.0 \
+    convergence_state_gating_enabled:=True \
+    convergence_minimum_path_length_m:=0.20 \
+    convergence_maximum_path_efficiency:=0.50 \
+    convergence_confirmation_policy:=qualified_dwell \
+    convergence_confirmation_dwell_sec:=6.0 \
+    convergence_confirmation_exit_threshold_scale:=1.5 \
+    robust_search_epoch_reset_enabled:=True \
+    gaussian_fill_covariance_scale:=2.5 \
+    gaussian_fill_sigma_floor_m:=0.50 \
+    gaussian_fill_sigma_ceiling_m:=1.25 \
+    gaussian_fill_amplitude_depth_scale:=1.5 \
+    gaussian_fill_amplitude_max:=6.25 \
+    gaussian_fill_exit_sigma:=2.70 \
+    gaussian_fill_max_fills:=1 \
+    gaussian_fill_minimum_valid_samples:=40 \
+    gaussian_fill_reuse_retained_samples_on_redesign:=True \
+    extremum_classification_mode:=counted_candidates \
+    known_source_count:=2 \
+    candidate_cost_rotation_period_sec:=3.0 \
+    candidate_cost_required_rotations:=3 \
+    candidate_cost_pretrigger_rotations:=6 \
+    candidate_cost_mad_scale:=3.0 \
+    candidate_informed_fill_enabled:=True \
+    candidate_informed_fill_amplitude_scale:=1.25 \
+    operating_bounds_enabled:=False \
+    open_field_escape_assist_enabled:=True \
+    open_field_escape_approach_continuity_enabled:=True \
+    open_field_escape_interior_anchor_fallback_enabled:=True \
+    open_field_escape_interior_anchor_min_displacement_m:=0.50 \
+    open_field_escape_active_fill_transit_enabled:=True \
+    open_field_escape_supervisor_owned_assist_enabled:=True \
+    modified_cost_enable_affine_bias:=True \
+    modified_cost_affine_gain:=0.50 \
+    modified_cost_affine_decay_rate:=0.0000005 \
+    modified_cost_affine_max_age:=35.0 \
+    modified_cost_affine_direction_sign:=1.0 \
+    post_recovery_guidance_enabled:=False \
+    recoverable_navigation_enabled:=False \
+    recenter_after_escape:=False \
+    stall_window_sec:=3.0 \
+    minimum_radial_progress_m:=0.05 \
+    goal_score_threshold:=0.95 \
+    goal_score_rotation_period_sec:=3.0 \
+    goal_score_required_rotations:=2 \
+    goal_hold_sec:=3.0 \
+    undesired_score_hold_sec:=3.0 \
+    verification_max_sec:=12.0 \
+    fill_design_timeout_sec:=5.0 \
+    escape_max_sec:=35.0 \
+    escape_exit_hold_sec:=1.0 \
+    fill_avoidance_margin_m:=0.10 \
+    approach_history_window_sec:=0.5 \
+    stale_pose_sec:=0.50 \
+    stale_sensor_sec:=0.50 \
+    supervisor_state_stale_sec:=0.50 \
+    supervisor_command_stale_sec:=0.50 \
+    zero_command_on_shutdown:=True
