+def validate_phase09_runtime_metadata_template(template, runtime):
+    """Allow only one reviewed per-run attestation delta from the template."""
+
+    if not isinstance(template, dict) or not isinstance(runtime, dict):
+        raise ValueError('Phase 09 runtime/template metadata must be mappings')
+    template_readiness = template.get('physical_readiness')
+    runtime_readiness = runtime.get('physical_readiness')
+    if not isinstance(template_readiness, dict) or not isinstance(
+        runtime_readiness,
+        dict,
+    ):
+        raise ValueError('Phase 09 runtime/template readiness must be mappings')
+    persisted = [
+        name
+        for name in _PHASE09_RUN_READINESS_FIELDS
+        if template_readiness.get(name) is not False
+    ]
+    missing = [
+        name
+        for name in _PHASE09_RUN_READINESS_FIELDS
+        if runtime_readiness.get(name) is not True
+    ]
+    operator = str(runtime.get('operator', '')).strip()
+    observer = str(runtime.get('observer', '')).strip()
+    attestation = runtime.get('run_attestation')
+    if (
+        set(template_readiness) != _PHASE09_ALL_READINESS_FIELDS
+        or set(runtime_readiness) != _PHASE09_ALL_READINESS_FIELDS
+        or persisted
+        or missing
+        or str(template.get('operator', '')).strip().upper()
+        not in {'', 'UNASSIGNED', 'TBD'}
+        or str(template.get('observer', '')).strip().upper()
+        not in {'', 'UNASSIGNED', 'TBD'}
+        or operator.upper() in {'', 'UNASSIGNED', 'TBD'}
+        or observer.upper() in {'', 'UNASSIGNED', 'TBD'}
+        or not isinstance(attestation, dict)
+        or set(attestation) != _PHASE09_RUN_ATTESTATION_FIELDS
+        or attestation.get('schema_version') != 1
+        or attestation.get('confirmation') != 'RUN'
+        or attestation.get('operator') != operator
+        or attestation.get('observer') != observer
+        or not _utc_timestamp_valid(attestation.get('confirmed_at_utc'))
+        or attestation.get('clear_open_floor') is not True
+        or attestation.get('independent_emergency_stop_ready') is not True
+        or attestation.get('vicon_server_ready') is not True
+        or 'stationary_preflight_attestation' in runtime
+        or any(
+            template_readiness.get(name) is not True
+            or runtime_readiness.get(name) is not True
+            for name in _PHASE09_STATIC_READINESS_FIELDS
+        )
+        or not isinstance(template.get('stationary_graph_evidence'), dict)
+    ):
+        raise ValueError(
+            'physical runtime metadata does not contain the exact reviewed '
+            'per-run attestation'
+        )
+
+    normalized = copy.deepcopy(runtime)
+    normalized['operator'] = template.get('operator')
+    if 'observer' in template:
+        normalized['observer'] = template.get('observer')
+    else:
+        normalized.pop('observer', None)
+    normalized.pop('run_attestation', None)
+    for name in _PHASE09_RUN_READINESS_FIELDS:
+        normalized['physical_readiness'][name] = template_readiness[name]
+    if normalized != template:
+        raise ValueError(
+            'physical runtime metadata differs from its template outside '
+            'approved run attestations'
+        )
+    return {
+        'template_scenario_id': template.get('scenario_id'),
+        'operator': operator,
+        'observer': observer,
+        'allowed_readiness_fields': list(_PHASE09_RUN_READINESS_FIELDS),
+    }
+
+
+def validate_phase09_stationary_metadata_template(template, runtime):
+    """Allow only the no-readiness PREFLIGHT identity delta."""
+
+    if not isinstance(template, dict) or not isinstance(runtime, dict):
+        raise ValueError('Phase 09 preflight/template metadata must be mappings')
+    template_readiness = template.get('physical_readiness')
+    runtime_readiness = runtime.get('physical_readiness')
+    if not isinstance(template_readiness, dict) or not isinstance(
+        runtime_readiness,
+        dict,
+    ):
+        raise ValueError('Phase 09 preflight/template readiness must be mappings')
+    operator = str(runtime.get('operator', '')).strip()
+    observer = str(runtime.get('observer', '')).strip()
+    attestation = runtime.get('stationary_preflight_attestation')
+    invalid = bool(
+        set(template_readiness) != _PHASE09_ALL_READINESS_FIELDS
+        or set(runtime_readiness) != _PHASE09_ALL_READINESS_FIELDS
+        or any(
+            template_readiness.get(name) is not False
+            or runtime_readiness.get(name) is not False
+            for name in _PHASE09_STATIC_READINESS_FIELDS
+        )
+        or template.get('stationary_graph_evidence') is not None
+        or any(
+            template_readiness.get(name) is not False
+            or runtime_readiness.get(name) is not False
+            for name in _PHASE09_RUN_READINESS_FIELDS
+        )
+        or str(template.get('operator', '')).strip().upper()
+        not in {'', 'UNASSIGNED', 'TBD'}
+        or str(template.get('observer', '')).strip().upper()
+        not in {'', 'UNASSIGNED', 'TBD'}
+        or operator.upper() in {'', 'UNASSIGNED', 'TBD'}
+        or observer.upper() in {'', 'UNASSIGNED', 'TBD'}
+        or 'run_attestation' in runtime
+        or not isinstance(attestation, dict)
+        or set(attestation) != _PHASE09_STATIONARY_ATTESTATION_FIELDS
+        or attestation.get('schema_version') != 1
+        or attestation.get('confirmation') != 'PREFLIGHT'
+        or attestation.get('operator') != operator
+        or attestation.get('observer') != observer
+        or not _utc_timestamp_valid(attestation.get('confirmed_at_utc'))
+        or attestation.get('base_motion_forbidden') is not True
+        or attestation.get('sensor_actuation_forbidden') is not True
+        or attestation.get('vicon_server_ready') is not True
+    )
+    if invalid:
+        raise ValueError(
+            'physical stationary metadata does not contain the exact reviewed '
+            'PREFLIGHT delta'
+        )
+    normalized = copy.deepcopy(runtime)
+    normalized['operator'] = template.get('operator')
+    if 'observer' in template:
+        normalized['observer'] = template.get('observer')
+    else:
+        normalized.pop('observer', None)
+    normalized.pop('stationary_preflight_attestation', None)
+    if normalized != template:
+        raise ValueError(
+            'physical stationary metadata differs from its template outside '
+            'the approved PREFLIGHT identity'
+        )
+    return {
+        'template_scenario_id': template.get('scenario_id'),
+        'operator': operator,
+        'observer': observer,
+        'readiness_held_false': True,
+    }
