+def _commissioning_evidence_checks(calibration_document, metadata, path):
+    """Return immutable one-time evidence checks beyond readiness booleans."""
+
+    measurements = calibration_document.get("measurements")
+    acceptance = calibration_document.get("acceptance")
+    artifacts = calibration_document.get("artifacts")
+    review = calibration_document.get("review")
+    analysis = calibration_document.get("analysis")
+    sources = metadata.get("sources")
+    metadata_calibration = metadata.get("calibration")
+    response_target = metadata.get("physical_response_target")
+    checks = {
+        "calibration.version": bool(
+            isinstance(calibration_document.get("calibration_version"), str)
+            and calibration_document.get("calibration_version").strip()
+            and calibration_document.get("calibration_version").strip().upper()
+            not in {"TBD", "UNASSIGNED"}
+        ),
+        "calibration.serial_protocol": (
+            calibration_document.get("serial_protocol") == _SERIAL_PROTOCOL
+        ),
+        "calibration.baud_rate": calibration_document.get("baud_rate") == 9600,
+        "calibration.firmware_sha256": (
+            calibration_document.get("firmware_sha256")
+            == _PHOTORESISTOR_FIRMWARE_SHA256
+        ),
+        "calibration.measurements.mapping": isinstance(measurements, dict),
+        "calibration.acceptance.mapping": isinstance(acceptance, dict),
+        "calibration.artifacts.mapping": isinstance(artifacts, dict),
+        "calibration.review.mapping": isinstance(review, dict),
+        "calibration.analysis.mapping": isinstance(analysis, dict),
+        "metadata.sources.two": isinstance(sources, list) and len(sources) == 2,
+    }
+    if not all(
+        isinstance(value, dict)
+        for value in (measurements, acceptance, artifacts, review, analysis)
+    ):
+        return checks
+
+    ambient = _finite_number(measurements.get("ambient_voltage_v"))
+    sample_period = _finite_number(measurements.get("sample_period_sec"))
+    total_lines = measurements.get("total_serial_lines")
+    parser_errors = measurements.get("parser_error_count")
+    parser_error_rate = _finite_number(measurements.get("parser_error_rate"))
+    maximum_gap = _finite_number(
+        measurements.get("maximum_inter_sample_gap_sec")
+    )
+    rotation_period = _finite_number(measurements.get("rotation_period_sec"))
+    rotation_names = (
+        "complete_rotations_per_condition",
+        "ambient_complete_rotations",
+        "weak_complete_rotations",
+        "strong_complete_rotations",
+    )
+    rotations = {
+        name: measurements.get(name)
+        for name in rotation_names
+    }
+    voltage_range = calibration_document.get("voltage_range_v")
+    voltage_min = (
+        _finite_number(voltage_range.get("minimum"))
+        if isinstance(voltage_range, dict)
+        else None
+    )
+    voltage_max = (
+        _finite_number(voltage_range.get("maximum"))
+        if isinstance(voltage_range, dict)
+        else None
+    )
+    weak_response = _finite_number(measurements.get("weak_response_voltage_v"))
+    strong_response = _finite_number(measurements.get("strong_response_voltage_v"))
+    weak_median = _finite_number(analysis.get("weak_median_raw_cost_v"))
+    strong_median = _finite_number(analysis.get("strong_median_raw_cost_v"))
+    ratio = _finite_number(measurements.get("strong_to_weak_response_ratio"))
+    weak_interval = _ordered_interval(measurements.get("weak_raw_cost_interval_v"))
+    strong_interval = _ordered_interval(
+        measurements.get("strong_raw_cost_interval_v")
+    )
+    immutable_acceptance = {
+        "target_strong_to_weak_response_ratio": 4.0,
+        "minimum_strong_to_weak_response_ratio": 3.6,
+        "maximum_strong_to_weak_response_ratio": 4.4,
+        "minimum_complete_rotations_per_condition": 5,
+        "maximum_parser_error_count": 0,
+        "maximum_parser_error_rate": 0.0,
+        "selected_rotation_period_sec": 3.0,
+        "maximum_inter_sample_gap_sec_exclusive": 0.50,
+        "mad_scale": 3.0,
+    }
+    checks.update({
+        "calibration.acceptance.immutable": acceptance == immutable_acceptance,
+        "calibration.analysis.mad_scale": analysis.get("mad_scale") == 3.0,
+        "calibration.measurements.ambient": ambient is not None and ambient >= 0.0,
+        "calibration.measurements.sample_period": (
+            sample_period is not None and 0.0 < sample_period < 0.50
+        ),
+        "calibration.measurements.parser_errors": (
+            isinstance(total_lines, int)
+            and not isinstance(total_lines, bool)
+            and total_lines > 0
+            and isinstance(parser_errors, int)
+            and not isinstance(parser_errors, bool)
+            and parser_errors == 0
+            and parser_error_rate == 0.0
+        ),
+        "calibration.measurements.timestamps": (
+            measurements.get("timestamps_strictly_increasing") is True
+            and maximum_gap is not None
+            and sample_period is not None
+            and sample_period <= maximum_gap < 0.50
+        ),
+        "calibration.measurements.rotation_period": (
+            rotation_period is not None
+            and math.isclose(
+                rotation_period,
+                3.0,
+                rel_tol=0.0,
+                abs_tol=1e-9,
+            )
+            and measurements.get(
+                "all_three_second_windows_cover_complete_rotation"
+            ) is True
+        ),
+        "calibration.measurements.rotations": (
+            all(
+                isinstance(value, int)
+                and not isinstance(value, bool)
+                for value in rotations.values()
+            )
+            and rotations["complete_rotations_per_condition"] >= 5
+            and all(
+                rotations[name] >= rotations["complete_rotations_per_condition"]
+                for name in rotation_names[1:]
+            )
+        ),
+        "calibration.measurements.responses": (
+            weak_response is not None
+            and strong_response is not None
+            and weak_response > 0.0
+            and strong_response > weak_response
+        ),
+        "calibration.measurements.responses_from_raw_cost": (
+            ambient is not None
+            and weak_response is not None
+            and strong_response is not None
+            and weak_median is not None
+            and strong_median is not None
+            and math.isclose(
+                weak_response,
+                -weak_median - ambient,
+                rel_tol=0.0,
+                abs_tol=1e-9,
+            )
+            and math.isclose(
+                strong_response,
+                -strong_median - ambient,
+                rel_tol=0.0,
+                abs_tol=1e-9,
+            )
+        ),
+        "calibration.measurements.ratio": (
+            ratio is not None
+            and 3.6 <= ratio <= 4.4
+            and weak_response is not None
+            and strong_response is not None
+            and weak_response > 0.0
+            and math.isclose(
+                ratio,
+                strong_response / weak_response,
+                rel_tol=0.0,
+                abs_tol=1e-9,
+            )
+        ),
+        "calibration.analysis.weak": _analysis_condition_checks(
+            analysis,
+            measurements,
+            "weak",
+            voltage_min,
+            voltage_max,
+        ),
+        "calibration.analysis.strong": _analysis_condition_checks(
+            analysis,
+            measurements,
+            "strong",
+            voltage_min,
+            voltage_max,
+        ),
+        "calibration.measurements.intervals": (
+            weak_interval is not None
+            and strong_interval is not None
+            and strong_interval[1] < weak_interval[0]
+            and measurements.get("raw_cost_intervals_strictly_separated") is True
+        ),
+        # MBuck 2026-08-01: Hashes alone cannot prove that reviewed values came
+        # from the retained inputs. Require a rosbag directory shape and exact,
+        # hash-linked structured acquisition/calculation artifacts.
+        "calibration.artifacts.raw_bag": _raw_calibration_bag_checks(
+            path,
+            artifacts,
+        ),
+        "calibration.artifacts.resolved_configuration": (
+            _resolved_configuration_checks(
+                calibration_document,
+                path,
+                artifacts,
+            )
+        ),
+        "calibration.artifacts.calculation_output": _calculation_output_checks(
+            calibration_document,
+            path,
+            artifacts,
+        ),
+        "calibration.review.timestamp": _utc_timestamp_valid(
+            review.get("calibrated_at_utc")
+        ),
+        "calibration.review.calibrated_by": bool(
+            str(review.get("calibrated_by", "")).strip()
+            and str(review.get("calibrated_by", "")).strip().upper()
+            not in {"TBD", "UNASSIGNED"}
+        ),
+        "calibration.review.reviewed_by": bool(
+            str(review.get("reviewed_by", "")).strip()
+            and str(review.get("reviewed_by", "")).strip().upper()
+            not in {"TBD", "UNASSIGNED"}
+        ),
+        "metadata.calibration.sha256": (
+            isinstance(metadata_calibration, dict)
+            and metadata_calibration.get("artifact_sha256") == _sha256_file(path)
+        ),
+        "metadata.response.contract": (
+            isinstance(response_target, dict)
+            and response_target.get("weak_to_strong_band") == "1:4"
+            and response_target.get("strong_to_weak_ratio_target") == 4.0
+            and response_target.get("strong_to_weak_ratio_minimum") == 3.6
+            and response_target.get("strong_to_weak_ratio_maximum") == 4.4
+            and response_target.get("measured_and_frozen") is True
+        ),
+    })
+
+    source_peaks = {}
+    source_rotation_counts = {}
+    source_roles = []
+    if isinstance(sources, list):
+        for source in sources:
+            if not isinstance(source, dict):
+                continue
+            role = str(source.get("evaluation_role", ""))
+            source_roles.append(role)
+            settings = source.get("lamp_settings")
+            response = source.get("measured_response")
+            checks[f"metadata.source.{role}.lamp_settings"] = _nonempty_mapping(
+                settings
+            )
+            peak = (
+                _finite_number(response.get("ambient_subtracted_peak_voltage_v"))
+                if isinstance(response, dict)
+                else None
+            )
+            checks[f"metadata.source.{role}.measured_response"] = (
+                peak is not None
+                and peak > 0.0
+                and isinstance(response.get("complete_rotations"), int)
+                and not isinstance(response.get("complete_rotations"), bool)
+                and response.get("complete_rotations") >= 5
+            )
+            if peak is not None:
+                source_peaks[role] = peak
+            if (
+                isinstance(response, dict)
+                and isinstance(response.get("complete_rotations"), int)
+                and not isinstance(response.get("complete_rotations"), bool)
+            ):
+                source_rotation_counts[role] = response["complete_rotations"]
+    checks["metadata.sources.roles"] = sorted(source_roles) == ["global", "local"]
+    metadata_ratio = None
+    if source_peaks.get("local", 0.0) > 0.0 and "global" in source_peaks:
+        metadata_ratio = source_peaks["global"] / source_peaks["local"]
+    checks["metadata.sources.measured_ratio"] = (
+        metadata_ratio is not None
+        and ratio is not None
+        and math.isclose(metadata_ratio, ratio, rel_tol=0.0, abs_tol=1e-9)
+    )
+    checks["metadata.sources.calibration_values"] = bool(
+        weak_response is not None
+        and strong_response is not None
+        and source_peaks.get("local") == weak_response
+        and source_peaks.get("global") == strong_response
+        and source_rotation_counts.get("local")
+        == rotations.get("weak_complete_rotations")
+        and source_rotation_counts.get("global")
+        == rotations.get("strong_complete_rotations")
+    )
+    return checks
+
+
+def load_calibration(path):
+    """Load the inert/calibrated Phase 09 schema without inventing values."""
+
+    document = yaml.safe_load(Path(path).read_text(encoding="utf-8"))
+    if not isinstance(document, dict) or document.get("schema_version") != 1:
+        raise ValueError("photoresistor calibration schema_version must be 1")
+    status = str(document.get("status", "")).strip()
+    if status not in {"uncalibrated", "calibrated"}:
+        raise ValueError("calibration status must be uncalibrated or calibrated")
+    motion_ready = document.get("motion_ready")
+    if not isinstance(motion_ready, bool):
+        raise ValueError("calibration motion_ready must be boolean")
+    serial_device = document.get("serial_device")
+    serial_device = "" if serial_device is None else str(serial_device).strip()
+    voltage_range = document.get("voltage_range_v", {})
+    score = document.get("source_score", {})
+    if not isinstance(voltage_range, dict) or not isinstance(score, dict):
+        raise ValueError("calibration voltage_range_v/source_score must be mappings")
+    voltage_min = _optional_finite(voltage_range, "minimum")
+    voltage_max = _optional_finite(voltage_range, "maximum")
+    score_enabled = score.get("enabled", False)
+    if not isinstance(score_enabled, bool):
+        raise ValueError("source_score.enabled must be boolean")
+    score_min = _optional_finite(score, "minimum_voltage_v")
+    score_max = _optional_finite(score, "maximum_voltage_v")
+    if document.get("raw_sensor_quantity") != "photoresistor_voltage":
+        raise ValueError("raw_sensor_quantity must be photoresistor_voltage")
+    if document.get("raw_sensor_unit") != "V":
+        raise ValueError("raw_sensor_unit must be V")
+    if document.get("raw_cost_convention") != "negative_voltage":
+        raise ValueError("raw_cost_convention must be negative_voltage")
+    if document.get("raw_cost_unit") != "V":
+        raise ValueError("raw_cost_unit must be V")
+    if motion_ready:
+        if status != "calibrated":
+            raise ValueError("motion_ready requires calibrated status")
+        if not serial_device.startswith("/dev/serial/by-id/"):
+            raise ValueError("motion_ready requires a stable serial device-by-id")
+        if voltage_min is None or voltage_max is None or not voltage_min < voltage_max:
+            raise ValueError("motion_ready requires an ordered voltage range")
+    elif status == "uncalibrated" and score_enabled:
+        raise ValueError("uncalibrated input cannot enable source_score")
+    if score_enabled and (
+        score_min is None or score_max is None or not score_min < score_max
+    ):
+        raise ValueError("enabled source_score requires an ordered voltage range")
+    return PhotoresistorCalibration(
+        status=status,
+        motion_ready=motion_ready,
+        serial_device=serial_device,
+        voltage_min_v=voltage_min,
+        voltage_max_v=voltage_max,
+        source_score_enabled=score_enabled,
+        source_score_min_v=score_min,
+        source_score_max_v=score_max,
+    )
+
+
+def _stationary_graph_evidence_checks(metadata):
+    evidence = metadata.get("stationary_graph_evidence")
+    if not isinstance(evidence, dict):
+        return {"metadata.stationary_graph_evidence.mapping": False}
+    run_directory = Path(str(evidence.get("run_directory", ""))).expanduser()
+    retained_paths = {
+        "metadata_sha256": run_directory / "metadata.yaml",
+        "completeness_sha256": run_directory / "completeness.json",
+        "resolved_topics_sha256": run_directory / "resolved_topics.yaml",
+        "resolved_parameters_sha256": run_directory / "resolved_parameters.yaml",
+        "configuration_manifest_sha256": (
+            run_directory / "configuration" / "manifest.yaml"
+        ),
+        "bag_tree_sha256": run_directory / "bag",
+    }
+    checks = {
+        "metadata.stationary_graph_evidence.schema": (
+            evidence.get("schema_version") == 1
+        ),
+        "metadata.stationary_graph_evidence.passed": evidence.get("passed") is True,
+        "metadata.stationary_graph_evidence.readiness_false": (
+            evidence.get("readiness_ever_true") is False
+        ),
+        "metadata.stationary_graph_evidence.reviewed_at": _utc_timestamp_valid(
+            evidence.get("reviewed_at_utc")
+        ),
+        "metadata.stationary_graph_evidence.reviewed_by": bool(
+            str(evidence.get("reviewed_by", "")).strip()
+        ),
+        "metadata.stationary_graph_evidence.template_hash": bool(
+            _SHA256_RE.fullmatch(
+                str(evidence.get("template_sha256_before_approval", ""))
+            )
+        ),
+    }
+    for hash_name, retained_path in retained_paths.items():
+        expected_hash = evidence.get(hash_name)
+        try:
+            matches = bool(
+                isinstance(expected_hash, str)
+                and _SHA256_RE.fullmatch(expected_hash)
+                and _sha256_path(retained_path) == expected_hash
+            )
+        except (OSError, ValueError):
+            matches = False
+        checks[f"metadata.stationary_graph_evidence.{hash_name}"] = matches
+    try:
+        document = json.loads(
+            retained_paths["completeness_sha256"].read_text(encoding="utf-8")
+        )
+    except (OSError, json.JSONDecodeError):
+        document = None
+    checks["metadata.stationary_graph_evidence.completeness"] = bool(
+        isinstance(document, dict) and document.get("passed") is True
+    )
+    return checks
+
+
+def _validate_phase09_inputs(
+    calibration_path,
+    serial_device,
+    metadata_path,
+    scenario,
+    *,
+    runtime_authorized,
+    stationary_preflight=False,
+):
+    """Validate commissioned templates or one ephemeral authorized run copy."""
+
+    calibration_path = Path(calibration_path).resolve()
+    calibration = load_calibration(calibration_path)
+    calibration_document = _load_yaml_mapping(
+        calibration_path,
+        "photoresistor calibration",
+    )
+    metadata = _load_yaml_mapping(metadata_path, "Phase 09 metadata")
+    if scenario not in _PHASE09_SCENARIO_IDS:
+        raise ValueError("Phase 09 scenario must be primary or secondary")
+
+    readiness = metadata.get("physical_readiness")
+    metadata_calibration = metadata.get("calibration")
+    controller_contract = metadata.get("controller_input_contract")
+    response_target = metadata.get("physical_response_target")
+    stop_policy = metadata.get("stop_policy")
+    evaluation_tracking = metadata.get("evaluation_tracking")
+    mappings = {
+        "metadata.physical_readiness": readiness,
+        "metadata.calibration": metadata_calibration,
+        "metadata.controller_input_contract": controller_contract,
+        "metadata.physical_response_target": response_target,
+        "metadata.stop_policy": stop_policy,
+        "metadata.evaluation_tracking": evaluation_tracking,
+    }
+    failed = [
+        name for name, value in mappings.items() if not isinstance(value, dict)
+    ]
+    if failed:
+        raise ValueError(
+            "Phase 09 inputs are motion-blocking; failed: " + ", ".join(failed)
+        )
+
+    operator = str(metadata.get("operator", "")).strip()
+    observer = str(metadata.get("observer", "")).strip()
+    checks = {
+        "calibration.serial_device": calibration.serial_device == serial_device,
+        "calibration.serial_device.stable": serial_device.startswith(
+            "/dev/serial/by-id/"
+        ),
+        "metadata.schema_version": metadata.get("schema_version") == 1,
+        "metadata.mode": metadata.get("mode") == "physical",
+        "metadata.algorithm_profile": (
+            metadata.get("algorithm_profile") == "robust_gaussian_v1"
+        ),
+        "metadata.scenario_id": (
+            metadata.get("scenario_id") == _PHASE09_SCENARIO_IDS[scenario]
+        ),
+        "metadata.controller.known_source_count": (
+            controller_contract.get("known_source_count") == 2
+        ),
+        "metadata.controller.coordinates_hidden": (
+            controller_contract.get("coordinates_visible") is False
+        ),
+        "metadata.controller.roles_hidden": (
+            controller_contract.get("roles_visible") is False
+        ),
+        "metadata.controller.settings_hidden": (
+            controller_contract.get("lamp_settings_visible") is False
+        ),
+        "metadata.controller.vicon_hidden": (
+            controller_contract.get("vicon_visible") is False
+        ),
+        "metadata.controller.no_evaluator_fields": (
+            controller_contract.get("evaluator_fields_forwarded") == []
+        ),
+        "metadata.stop.manual_ctrl_c": (
+            stop_policy.get("run_end") == "manual_operator_ctrl_c"
+        ),
+        "metadata.stop.no_coordinate_stop": (
+            stop_policy.get("automatic_coordinate_stop") is False
+        ),
+    }
+    checks.update(_vicon_evaluation_checks(evaluation_tracking))
+    if stationary_preflight:
+        # MBuck 2026-08-01: This selected-only graph check deliberately runs
+        # before rotating-sensor calibration. It may publish unscored raw
+        # voltage for evidence, but neither recorder-owned actuation gate can
+        # become true.
+        checks.update({
+            "calibration.status": calibration.status == "uncalibrated",
+            "calibration.motion_ready": calibration.motion_ready is False,
+            "calibration.protocol": (
+                calibration_document.get("serial_protocol") == _SERIAL_PROTOCOL
+                and calibration_document.get("baud_rate") == 9600
+                and calibration_document.get("firmware_sha256")
+                == _PHOTORESISTOR_FIRMWARE_SHA256
+            ),
+            "metadata.calibration.status": (
+                metadata_calibration.get("status") == "uncalibrated"
+            ),
+            "metadata.calibration.motion_ready": (
+                metadata_calibration.get("motion_ready") is False
+            ),
+            "metadata.calibration.artifact_inert": (
+                metadata_calibration.get("artifact_sha256") is None
+            ),
+            "metadata.response.inert": (
+                response_target.get("measured_and_frozen") is False
+            ),
+            "metadata.sources.inert": all(
+                isinstance(source, dict)
+                and source.get("lamp_settings") is None
+                and source.get("measured_response") is None
+                for source in metadata.get("sources", ())
+            ),
+        })
+    else:
+        checks.update({
+            "calibration.status": calibration.status == "calibrated",
+            "calibration.motion_ready": calibration.motion_ready is True,
+            "metadata.calibration.status": (
+                metadata_calibration.get("status") == "calibrated"
+            ),
+            "metadata.calibration.motion_ready": (
+                metadata_calibration.get("motion_ready") is True
+            ),
+            "metadata.response.measured": (
+                response_target.get("measured_and_frozen") is True
+            ),
+        })
+        checks.update(
+            _commissioning_evidence_checks(
+                calibration_document,
+                metadata,
+                calibration_path,
+            )
+        )
+    for readiness_name in _PHASE09_STATIC_READINESS_FIELDS:
+        expected = False if stationary_preflight else True
+        checks[f"metadata.physical_readiness.{readiness_name}"] = (
+            readiness.get(readiness_name) is expected
+        )
+    if stationary_preflight:
+        checks["metadata.stationary_graph_evidence.inert"] = (
+            metadata.get("stationary_graph_evidence") is None
+        )
+    else:
+        checks.update(_stationary_graph_evidence_checks(metadata))
+    if runtime_authorized:
+        checks["metadata.operator"] = operator.upper() not in {
+            "",
+            "UNASSIGNED",
+            "TBD",
+        }
+        checks["metadata.observer"] = observer.upper() not in {
+            "",
+            "UNASSIGNED",
+            "TBD",
+        }
+        for readiness_name in _PHASE09_RUN_READINESS_FIELDS:
+            checks[f"metadata.physical_readiness.{readiness_name}"] = (
+                readiness.get(readiness_name) is True
+            )
+        attestation = metadata.get("run_attestation")
+        checks["metadata.run_attestation"] = (
+            isinstance(attestation, dict)
+            and attestation.get("schema_version") == 1
+            and attestation.get("confirmation") == "RUN"
+            and attestation.get("operator") == operator
+            and attestation.get("observer") == observer
+            and _utc_timestamp_valid(attestation.get("confirmed_at_utc"))
+            and attestation.get("clear_open_floor") is True
+            and attestation.get("independent_emergency_stop_ready") is True
+            and attestation.get("vicon_server_ready") is True
+        )
+        checks["metadata.no_stationary_preflight_attestation"] = (
+            "stationary_preflight_attestation" not in metadata
+        )
+    elif stationary_preflight:
+        checks["metadata.operator"] = operator.upper() not in {
+            "", "UNASSIGNED", "TBD"
+        }
+        checks["metadata.observer"] = observer.upper() not in {
+            "", "UNASSIGNED", "TBD"
+        }
+        for readiness_name in _PHASE09_RUN_READINESS_FIELDS:
+            checks[f"metadata.physical_readiness.{readiness_name}"] = (
+                readiness.get(readiness_name) is False
+            )
+        attestation = metadata.get("stationary_preflight_attestation")
+        checks["metadata.stationary_preflight_attestation"] = (
+            isinstance(attestation, dict)
+            and attestation.get("schema_version") == 1
+            and attestation.get("confirmation") == "PREFLIGHT"
+            and attestation.get("operator") == operator
+            and attestation.get("observer") == observer
+            and _utc_timestamp_valid(attestation.get("confirmed_at_utc"))
+            and attestation.get("base_motion_forbidden") is True
+            and attestation.get("sensor_actuation_forbidden") is True
+            and attestation.get("vicon_server_ready") is True
+        )
+        checks["metadata.no_run_attestation"] = "run_attestation" not in metadata
+    else:
+        checks["metadata.operator_unassigned_in_template"] = operator.upper() in {
+            "",
+            "UNASSIGNED",
+            "TBD",
+        }
+        checks["metadata.observer_unassigned_in_template"] = observer.upper() in {
+            "",
+            "UNASSIGNED",
+            "TBD",
+        }
+        checks["metadata.no_run_attestation"] = "run_attestation" not in metadata
+        checks["metadata.no_stationary_preflight_attestation"] = (
+            "stationary_preflight_attestation" not in metadata
+        )
+        for readiness_name in _PHASE09_RUN_READINESS_FIELDS:
+            checks[f"metadata.physical_readiness.{readiness_name}"] = (
+                readiness.get(readiness_name) is False
+            )
+    failed = [name for name, passed in checks.items() if not passed]
+    if failed:
+        raise ValueError(
+            "Phase 09 inputs are motion-blocking; failed: " + ", ".join(failed)
+        )
+    return calibration.source_score_enabled
+
