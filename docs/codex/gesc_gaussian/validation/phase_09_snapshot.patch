+def _absolute_message_stamp_valid(message):
+    """Require one nonzero, normalized ROS stamp on a typed message."""
+
+    stamp = getattr(message, 'stamp', None)
+    if stamp is None:
+        stamp = getattr(getattr(message, 'header', None), 'stamp', None)
+    if stamp is None:
+        return False
+    try:
+        sec = int(stamp.sec)
+        nanosec = int(stamp.nanosec)
+    except (AttributeError, TypeError, ValueError):
+        return False
+    return sec >= 0 and 0 <= nanosec < 1_000_000_000 and (sec > 0 or nanosec > 0)
+
