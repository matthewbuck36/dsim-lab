+"""Host-side parity checks for the Phase 09 shared algorithm port."""
+
+from hashlib import sha256
+import os
+from pathlib import Path
+
+import pytest
+
+
+SNAPSHOT_SOURCE_ROOT = Path(__file__).resolve().parents[2]
+DSIM_SOURCE_ROOT = Path(
+    os.environ.get(
+        "PHASE09_DSIM_SOURCE_ROOT",
+        "/home/mattb/dsim-lab/ros2_ws/src",
+    )
+).resolve()
+
+SHARED_PATHS = (
+    "ros_esc_interfaces/CMakeLists.txt",
+    "ros_esc_interfaces/package.xml",
+    "ros_esc_interfaces/msg/AlgorithmEvent.msg",
+    "ros_esc_interfaces/msg/AlgorithmState.msg",
+    "ros_esc_interfaces/msg/ControlDiagnostics.msg",
+    "ros_esc_interfaces/msg/CostBreakdown.msg",
+    "ros_esc_interfaces/msg/GaussianFill.msg",
+    "ros_esc_interfaces/msg/GescDiagnostics.msg",
+    "ros_esc/ros_esc/config_parsing.py",
+    "ros_esc/ros_esc/deferred_signal_shutdown.py",
+    "ros_esc/ros_esc/search_epoch.py",
+    "ros_esc/ros_esc/controller_node/controller_node_script.py",
+    "ros_esc/ros_esc/controller_node/controller_objects/turtlebot_vehicle.py",
+    "ros_esc/ros_esc/convergence_detector_node/"
+    "convergence_detector_node_script.py",
+    "ros_esc/ros_esc/filter_node/filter_node_script.py",
+    "ros_esc/ros_esc/gaussian_fill_node/__init__.py",
+    "ros_esc/ros_esc/gaussian_fill_node/basin_estimator.py",
+    "ros_esc/ros_esc/gaussian_fill_node/fill_designer.py",
+    "ros_esc/ros_esc/gaussian_fill_node/fill_registry.py",
+    "ros_esc/ros_esc/gaussian_fill_node/gaussian_fill_script.py",
+    "ros_esc/ros_esc/modified_cost_node/modified_cost_script.py",
+    "ros_esc/ros_esc/pde_history_node/pde_history_script.py",
+    "ros_esc/ros_esc/pde_cost_history_node/pde_cost_history_script.py",
+    "ros_esc/ros_esc/supervisor_node/__init__.py",
+    "ros_esc/ros_esc/supervisor_node/escape_recenter.py",
+    "ros_esc/ros_esc/supervisor_node/state_machine.py",
+    "ros_esc/ros_esc/supervisor_node/supervisor_node_script.py",
+)
+
+
+def _digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+@pytest.mark.parametrize("relative_path", SHARED_PATHS)
+def test_shared_source_matches_terminal_dsim_runtime(relative_path):
+    """Every shared owner must remain byte-identical to terminal Phase 08."""
+
+    if not DSIM_SOURCE_ROOT.is_dir():
+        pytest.skip("host dsim source root is unavailable")
+    expected = DSIM_SOURCE_ROOT / relative_path
+    observed = SNAPSHOT_SOURCE_ROOT / relative_path
+    assert expected.is_file(), relative_path
+    assert observed.is_file(), relative_path
+    assert _digest(observed) == _digest(expected), relative_path
+
+
+def test_simulation_scenario_runner_was_not_copied():
+    """Physical packaging must not acquire simulation orchestration owners."""
+
+    assert not (
+        SNAPSHOT_SOURCE_ROOT / "ros_esc/ros_esc/scenario_runner"
+    ).exists()
