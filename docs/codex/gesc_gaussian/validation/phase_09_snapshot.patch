+def operational_message_error(
+    alias,
+    message,
+    mode,
+    algorithm_profile,
+    require_search_state=True,
+    stationary_preflight=False,
+    rotation_authorized=True,
+):
+    """Return why a fresh operational heartbeat is not usable."""  # noqa: Q000
+    if message is None:
+        return f'operational heartbeat has no message: {alias}'
+    if alias in ('pose', 'simulation_pose_delayed'):
+        pose = message.pose.pose
+        numeric = (
+            pose.position.x,
+            pose.position.y,
+            pose.position.z,
+            pose.orientation.x,
+            pose.orientation.y,
+            pose.orientation.z,
+            pose.orientation.w,
+        )
+        quaternion_norm = math.sqrt(sum(float(value) ** 2 for value in numeric[3:]))
+        x_value, y_value, z_value, w_value = (
+            float(value) for value in numeric[3:]
+        )
+        pitch_argument = 2.0 * (
+            w_value * y_value - x_value * z_value
+        )
+        if (
+            not all(math.isfinite(float(value)) for value in numeric)
+            or quaternion_norm <= 1e-9
+            or not -1.0 <= pitch_argument <= 1.0
+            or mode == 'physical'
+            and not _absolute_message_stamp_valid(message)
+        ):
+            return 'operational pose heartbeat is invalid'
+    elif alias == 'vicon_evaluation_pose':
+        pose = message.pose
+        numeric = (
+            pose.position.x,
+            pose.position.y,
+            pose.position.z,
+            pose.orientation.x,
+            pose.orientation.y,
+            pose.orientation.z,
+            pose.orientation.w,
+        )
+        quaternion_norm = math.sqrt(
+            sum(float(value) ** 2 for value in numeric[3:])
+        )
+        if (
+            not _absolute_message_stamp_valid(message)
+            or str(getattr(message.header, 'frame_id', '')) != 'vicon_world'
+            or not all(math.isfinite(float(value)) for value in numeric)
+            or not math.isclose(
+                quaternion_norm,
+                1.0,
+                rel_tol=0.0,
+                abs_tol=1e-3,
+            )
+        ):
+            return 'operational Vicon evaluation heartbeat is invalid'
+    elif alias == 'vicon_evaluation_status':
+        return vicon_status_error(message)
+    elif alias == 'encoder':
+        values = tuple(message.data)
+        if (
+            len(values) != 1
+            or not math.isfinite(float(values[0]))
+            or not -1e-9 <= float(values[0]) <= 2.0 * math.pi + 1e-9
+        ):
+            return 'operational encoder heartbeat is invalid'
+    elif alias == 'rotation_status':
+        return rotation_status_error(
+            message,
+            stationary_preflight,
+            rotation_authorized,
+        )
+    elif alias == 'rotation_command':
+        try:
+            value = float(message.data)
+        except (AttributeError, TypeError, ValueError):
+            return 'operational rotation command heartbeat is invalid'
+        if (
+            not math.isfinite(value)
+            or (stationary_preflight or not rotation_authorized)
+            and not math.isclose(value, 0.0, abs_tol=1e-9)
+            or not stationary_preflight
+            and rotation_authorized
+            and math.isclose(value, 0.0, abs_tol=1e-9)
+        ):
+            return 'operational rotation command heartbeat is invalid'
+    elif (
+        alias in ('source_cost', 'simulation_source_cost_delayed')
+        and mode == 'simulation'
+    ):
+        raw_cost = tuple(message.raw_cost)
+        source_score = tuple(message.source_score)
+        if (
+            message.source_mode != message.SOURCE_SIMULATION
+            or not message.source_timestamp_valid
+            or not math.isfinite(float(message.source_timestamp))
+            or not message.raw_cost_valid
+            or not message.source_score_valid
+            or not raw_cost
+            or int(message.channel_count) != len(raw_cost)
+            or len(raw_cost) != len(source_score)
+            or not all(
+                math.isfinite(float(value))
+                for value in (*raw_cost, *source_score)
+            )
+        ):
+            return 'operational simulation source-cost heartbeat is invalid'
+    elif alias == 'source_cost' and mode == 'physical':
+        raw_sensor = tuple(message.raw_sensor_value)
+        raw_cost = tuple(message.raw_cost)
+        source_score = tuple(message.source_score)
+        score_valid = bool(message.source_score_valid)
+        if (
+            message.source_mode != message.SOURCE_PHYSICAL
+            or not _absolute_message_stamp_valid(message)
+            or not message.source_timestamp_valid
+            or not math.isfinite(float(message.source_timestamp))
+            or float(message.source_timestamp) < 0.0
+            or not message.raw_sensor_valid
+            or not message.raw_cost_valid
+            or int(message.channel_count) != 1
+            or len(raw_sensor) != 1
+            or len(raw_cost) != 1
+            or not all(
+                math.isfinite(float(value))
+                for value in (*raw_sensor, *raw_cost)
+            )
+            or not math.isclose(
+                float(raw_cost[0]),
+                -float(raw_sensor[0]),
+                rel_tol=0.0,
+                abs_tol=1e-9,
+            )
+            or score_valid
+            and (
+                len(source_score) != 1
+                or not math.isfinite(float(source_score[0]))
+                or not 0.0 <= float(source_score[0]) <= 1.0
+            )
+        ):
+            return 'operational physical source-cost heartbeat is invalid'
+    elif alias == 'imu':
+        orientation = message.orientation
+        angular = message.angular_velocity
+        linear = message.linear_acceleration
+        quaternion = (
+            orientation.x,
+            orientation.y,
+            orientation.z,
+            orientation.w,
+        )
+        numeric = (
+            *quaternion,
+            angular.x,
+            angular.y,
+            angular.z,
+            linear.x,
+            linear.y,
+            linear.z,
+        )
+        if (
+            not _absolute_message_stamp_valid(message)
+            or not all(math.isfinite(float(value)) for value in numeric)
+            or math.sqrt(
+                sum(float(value) ** 2 for value in quaternion)
+            ) <= 1e-9
+        ):
+            return 'operational IMU heartbeat is invalid'
+    elif alias == 'filter_output_legacy':
+        values = tuple(message.data)
+        if (
+            not math.isfinite(float(message.timestamp))
+            or len(values) < 2
+            or not all(math.isfinite(float(value)) for value in values)
+        ):
+            return 'operational filter-output heartbeat is invalid'
+    elif alias == 'supervisor_command':
+        values = (
+            message.linear.x,
+            message.linear.y,
+            message.linear.z,
+            message.angular.x,
+            message.angular.y,
+            message.angular.z,
+        )
+        if not all(math.isfinite(float(value)) for value in values):
+            return 'operational supervisor-command heartbeat is invalid'
+    elif alias == 'timekeeper':
+        if (
+            not math.isfinite(float(message.start_time))
+            or (
+                mode == 'simulation'
+                and str(message.mode) != 'sim time'
+            )
+            or (
+                mode == 'physical'
+                and str(message.mode) != 'real time'
+            )
+        ):
+            return 'operational timekeeper heartbeat is invalid'
+    elif (
+        alias == 'algorithm_state'
+        and algorithm_profile == 'robust_gaussian_v1'
+    ):
+        weights = (
+            message.sensor_weight,
+            message.gaussian_weight,
+            message.affine_weight,
+        )
+        if (
+            message.algorithm_profile != algorithm_profile
+            or not message.state_valid
+            or not message.weights_valid
+            or require_search_state
+            and message.state != message.STATE_SEARCH
+            or not message.failsafe_valid
+            or message.failsafe
+            or not all(math.isfinite(float(value)) for value in weights)
+        ):
+            return 'operational robust algorithm-state heartbeat is invalid'
+    return None
+
+
+def preauthorization_lifecycle_errors(message, algorithm_profile):
+    """Return robust lifecycle evidence that predates motion authorization."""
+    if message is None or algorithm_profile != 'robust_gaussian_v1':
+        return []
+    errors = []
+    state_valid = bool(getattr(message, 'state_valid', False))
+    state = int(getattr(message, 'state', AlgorithmState.STATE_UNAVAILABLE))
+    state_name = str(getattr(message, 'state_name', state))
+    if state_valid and state != AlgorithmState.STATE_SEARCH:
+        errors.append(
+            'algorithm state advanced before readiness: '
+            f'{state_name} ({state})'
+        )
+    if (
+        bool(getattr(message, 'failsafe_valid', False))
+        and bool(getattr(message, 'failsafe', False))
+    ):
+        errors.append('algorithm entered failsafe before readiness')
+    if bool(getattr(message, 'previous_state_valid', False)):
+        previous_state = int(
+            getattr(
+                message,
+                'previous_state',
+                AlgorithmState.STATE_UNAVAILABLE,
+            )
+        )
+        previous_name = str(
+            getattr(message, 'previous_state_name', previous_state)
+        )
+        errors.append(
+            'algorithm transition history observed before readiness: '
+            f'{previous_name} ({previous_state}) -> {state_name} ({state})'
+        )
+    if (
+        bool(getattr(message, 'active_fill_count_valid', False))
+        and int(getattr(message, 'active_fill_count', 0)) > 0
+    ):
+        errors.append(
+            'active Gaussian fill lifecycle observed before readiness: '
+            f"{int(getattr(message, 'active_fill_count', 0))}"
+        )
+    if bool(getattr(message, 'active_escape_fill_id_valid', False)):
+        errors.append(
+            'active escape fill observed before readiness: '
+            f"{int(getattr(message, 'active_escape_fill_id', 0))}"
+        )
+    return errors
+
+
+def controller_state_error(
+    controllers,
+    required_controllers=REQUIRED_SIMULATION_CONTROLLERS,
+):
+    """Return why required simulation controllers are not active."""  # noqa: Q000
+    states = {
+        str(controller.name): str(controller.state)
+        for controller in controllers
+    }
+    unavailable = [
+        f"{name}={states.get(name, 'missing')}"
+        for name in required_controllers
+        if states.get(name) != 'active'
+    ]
+    if unavailable:
+        return 'controller manager not operational: ' + ', '.join(unavailable)
+    return None
+
+
+class RecordingCoordinator(Node):
+    """Own readiness/stop publications and shutdown-zero observations."""
+
+    def __init__(
+        self,
+        ready_topic,
+        stop_topic,
+        ready_rate_hz,
+        rotation_authorized_topic=None,
+        heartbeat_entries=(),
+        heartbeat_stale_sec=OPERATIONAL_HEARTBEAT_STALE_SEC,
+        controller_manager_service=None,
+        required_controllers=(),
+        mode=None,
+        algorithm_profile=None,
+        stationary_preflight=False,
+        vicon_expected_subject_name=None,
+        vicon_expected_segment_name=None,
+        vicon_expected_server_script_sha256=None,
+        diagnostic_entries=(),
+        live_diagnostics_period_sec=0.0,
+        live_diagnostics_callback=None,
+    ):
+        super().__init__("gesc_gaussian_recording_coordinator")
+        self._state_lock = threading.RLock()
+        self.ready = False
+        self.ready_topic = ready_topic
+        self.ready_publisher = self.create_publisher(Bool, ready_topic, 10)
+        self.rotation_authorized = False
+        self.rotation_authorized_ever = False
+        self.rotation_authorized_topic = rotation_authorized_topic
+        self.rotation_authorized_publisher = (
+            self.create_publisher(Bool, rotation_authorized_topic, 10)
+            if rotation_authorized_topic else None
+        )
+        self.stop_publisher = self.create_publisher(Bool, stop_topic, 10)
+        self.zero_observed_at = {topic: None for topic in ZERO_TOPICS}
+        self.nonzero_observed_at = {topic: None for topic in ZERO_TOPICS}
+        self.pre_ready_nonzero_observed_at = {
+            topic: None for topic in ZERO_TOPICS
+        }
+        self.authorization_ever_succeeded = False
+        self.preauthorization_monitoring_closed = False
+        self.pre_ready_lifecycle_violations = []
+        self.heartbeat_observed_at = {
+            entry['alias']: None for entry in heartbeat_entries
+        }
+        self.heartbeat_messages = {
+            entry['alias']: None for entry in heartbeat_entries
+        }
+        self.vicon_status_progression_error = None
+        self.vicon_status_fault = None
+        self.vicon_status_valid_samples = 0
+        self.vicon_status_last_valid = None
+        self.rotation_zero_observed_at = None
+        self.rotation_nonzero_observed_at = None
+        self.pre_rotation_authorization_nonzero_observed_at = None
+        self.diagnostic_observed_at = {}
+        self.diagnostic_messages = {}
+        self.live_diagnostics_callback = live_diagnostics_callback
+        self.heartbeat_stale_sec = float(heartbeat_stale_sec)
+        self.mode = mode
+        self.algorithm_profile = algorithm_profile
+        self.stationary_preflight = bool(stationary_preflight)
+        self.vicon_expected_subject_name = vicon_expected_subject_name
+        self.vicon_expected_segment_name = vicon_expected_segment_name
+        self.vicon_expected_server_script_sha256 = (
+            vicon_expected_server_script_sha256
+        )
+        self.operational_epoch_monotonic = None
+        self.controller_manager_service = controller_manager_service
+        self.required_controllers = tuple(required_controllers)
+        self.last_operational_snapshot = {}
+        self.heartbeat_subscriptions = []
+        for entry in heartbeat_entries:
+            alias = entry['alias']
+            self.heartbeat_subscriptions.append(
+                self.create_subscription(
+                    get_message(entry['type']),
+                    entry['topic'],
+                    partial(self._record_heartbeat, alias),
+                    10,
+                )
+            )
+        self.diagnostic_subscriptions = []
+        heartbeat_aliases = set(self.heartbeat_messages)
+        for entry in diagnostic_entries:
+            alias = entry['alias']
+            if alias in heartbeat_aliases:
+                continue
+            self.diagnostic_observed_at[alias] = None
+            self.diagnostic_messages[alias] = None
+            self.diagnostic_subscriptions.append(
+                self.create_subscription(
+                    get_message(entry['type']),
+                    entry['topic'],
+                    partial(self._record_diagnostic, alias),
+                    10,
+                )
+            )
+        self.controller_manager_service_type = None
+        self.controller_manager_client = None
+        if controller_manager_service:
+            from controller_manager_msgs.srv import ListControllers
+            self.controller_manager_service_type = ListControllers
+            self.controller_manager_client = self.create_client(
+                ListControllers,
+                controller_manager_service,
+            )
+        self.create_subscription(Twist, ZERO_TOPICS[0], self._twist_callback, 10)
+        self.create_subscription(
+            StampedFloat64MultiArray, ZERO_TOPICS[1], self._array_callback, 10
+        )
+        self.create_subscription(
+            ControlDiagnostics, ZERO_TOPICS[2], self._diagnostics_callback, 10
+        )
+        self.create_timer(1.0 / max(1e-6, ready_rate_hz), self.publish_ready)
+        if live_diagnostics_period_sec > 0.0:
+            self.create_timer(
+                live_diagnostics_period_sec,
+                self._emit_live_diagnostics,
+            )
+        self.publish_ready()
+
+    def publish_ready(self):
+        message = Bool()
+        rotation_message = Bool()
+        with self._state_lock:
+            message.data = bool(self.ready)
+            rotation_message.data = bool(self.rotation_authorized)
+        self.ready_publisher.publish(message)
+        if self.rotation_authorized_publisher is not None:
+            self.rotation_authorized_publisher.publish(rotation_message)
+
+    def request_stop(self):
+        with self._state_lock:
+            self.ready = False
+            self.rotation_authorized = False
+            # Begin a fresh shutdown-zero epoch. Subsequent repeated zeros
+            # retain the start of the uninterrupted interval; any nonzero
+            # clears it and forces a complete new stability dwell.
+            self.zero_observed_at = {topic: None for topic in ZERO_TOPICS}
+            self.rotation_zero_observed_at = None
+            # The robust supervisor intentionally enters FAILSAFE on stop.
+            # Close lifecycle monitoring here, while _record_command keeps the
+            # stationary no-actuation latch alive through the shutdown tail.
+            self.preauthorization_monitoring_closed = True
+        self.publish_ready()
+        message = Bool()
+        message.data = True
+        self.stop_publisher.publish(message)
+
+    def _record_command(self, topic, values):
+        observed = time.monotonic()
+        with self._state_lock:
+            if _is_zero(values):
+                if self.zero_observed_at[topic] is None:
+                    self.zero_observed_at[topic] = observed
+            else:
+                self.nonzero_observed_at[topic] = observed
+                self.zero_observed_at[topic] = None
+                if not getattr(
+                    self,
+                    'preauthorization_monitoring_closed',
+                    False,
+                ) or getattr(self, 'stationary_preflight', False):
+                    self.pre_ready_nonzero_observed_at[topic] = observed
+
+    def _record_heartbeat(self, alias, message):
+        with self._state_lock:
+            observed = time.monotonic()
+            if alias == 'rotation_command':
+                try:
+                    value = float(message.data)
+                except (AttributeError, TypeError, ValueError):
+                    value = None
+                if (
+                    value is not None
+                    and math.isfinite(value)
+                    and math.isclose(value, 0.0, abs_tol=1e-9)
+                ):
+                    if self.rotation_zero_observed_at is None:
+                        self.rotation_zero_observed_at = observed
+                else:
+                    self.rotation_nonzero_observed_at = observed
+                    self.rotation_zero_observed_at = None
+                    if not getattr(self, 'rotation_authorized_ever', False):
+                        # A later zero cannot erase pre-gate mechanism motion.
+                        self.pre_rotation_authorization_nonzero_observed_at = (
+                            observed
+                        )
+            if alias == 'vicon_evaluation_status':
+                current_error = vicon_status_error(
+                    message,
+                    getattr(self, 'vicon_expected_subject_name', None),
+                    getattr(self, 'vicon_expected_segment_name', None),
+                    getattr(
+                        self,
+                        'vicon_expected_server_script_sha256',
+                        None,
+                    ),
+                )
+                if current_error is not None:
+                    self.vicon_status_fault = current_error
+                else:
+                    current = parse_vicon_status_message(message)
+                    previous = getattr(self, 'vicon_status_last_valid', None)
+                    if previous is None:
+                        self.vicon_status_valid_samples = 1
+                        self.vicon_status_last_valid = current
+                    elif (
+                        current['server_session'] != previous['server_session']
+                        or current['sequence'] <= previous['sequence']
+                        or current['tracker_frame'] <= previous['tracker_frame']
+                    ):
+                        self.vicon_status_progression_error = (
+                            'Vicon status session/sequence/frame did not advance'
+                        )
+                    else:
+                        self.vicon_status_valid_samples = (
+                            getattr(self, 'vicon_status_valid_samples', 0) + 1
+                        )
+                        self.vicon_status_last_valid = current
+            self.heartbeat_observed_at[alias] = observed
+            self.heartbeat_messages[alias] = message
+            if (
+                alias == 'algorithm_state'
+                and not getattr(
+                    self,
+                    'preauthorization_monitoring_closed',
+                    False,
+                )
+            ):
+                known_errors = {
+                    violation['error']
+                    for violation in getattr(
+                        self,
+                        'pre_ready_lifecycle_violations',
+                        (),
+                    )
+                }
+                for error in preauthorization_lifecycle_errors(
+                    message,
+                    self.algorithm_profile,
+                ):
+                    if error not in known_errors:
+                        self.pre_ready_lifecycle_violations.append({
+                            'alias': alias,
+                            'observed_at_monotonic': observed,
+                            'error': error,
+                        })
+                        known_errors.add(error)
+
+    def _record_diagnostic(self, alias, message):
+        with self._state_lock:
+            self.diagnostic_observed_at[alias] = time.monotonic()
+            self.diagnostic_messages[alias] = message
+
+    def _emit_live_diagnostics(self):
+        callback = self.live_diagnostics_callback
+        if callback is None:
+            return
+        with self._state_lock:
+            messages = {
+                **self.heartbeat_messages,
+                **self.diagnostic_messages,
+            }
+            messages['control_diagnostics'] = getattr(
+                self,
+                'latest_control_diagnostics',
+                None,
+            )
+            observed_at = {
+                **self.heartbeat_observed_at,
+                **self.diagnostic_observed_at,
+            }
+            observed_at['control_diagnostics'] = getattr(
+                self,
+                'latest_control_diagnostics_observed_at',
+                None,
+            )
+            ready = bool(self.ready)
+        try:
+            callback(format_live_diagnostics(messages, observed_at, ready))
+        except Exception:
+            # Operator display is never part of readiness or command control.
+            return
+
+    def begin_operational_epoch(self, aliases=None):
+        """Require fresh heartbeat receipts after graph preflight."""  # noqa: Q000
+        with self._state_lock:
+            self.operational_epoch_monotonic = time.monotonic()
+            selected = (
+                set(self.heartbeat_observed_at)
+                if aliases is None else set(aliases)
+            )
+            for alias in selected:
+                if alias not in self.heartbeat_observed_at:
+                    continue
+                self.heartbeat_observed_at[alias] = None
+                self.heartbeat_messages[alias] = None
+            if 'vicon_evaluation_status' in selected:
+                self.vicon_status_progression_error = None
+                self.vicon_status_fault = None
+                self.vicon_status_valid_samples = 0
+                self.vicon_status_last_valid = None
+
+    def pre_ready_nonzero_seen(self):
+        """Return whether any command representation moved before readiness."""  # noqa: Q000
+        with self._state_lock:
+            return bool(
+                getattr(
+                    self,
+                    'pre_rotation_authorization_nonzero_observed_at',
+                    None,
+                )
+                is not None
+                or any(
+                    observed is not None
+                    for observed in self.pre_ready_nonzero_observed_at.values()
+                )
+            )
+
+    def zero_seen(self, topic):
+        """Return whether one command representation has emitted zero."""  # noqa: Q000
+        with self._state_lock:
+            return self.zero_observed_at.get(topic) is not None
+
+    def _heartbeat_status(self, now, aliases=None):
+        with self._state_lock:
+            selected = (
+                set(self.heartbeat_observed_at)
+                if aliases is None else set(aliases)
+            )
+            observed_at = {
+                alias: observed
+                for alias, observed in self.heartbeat_observed_at.items()
+                if alias in selected
+            }
+            heartbeat_messages = {
+                alias: message
+                for alias, message in self.heartbeat_messages.items()
+                if alias in selected
+            }
+            authorization_active = bool(
+                getattr(self, 'authorization_ever_succeeded', False)
+                and getattr(self, 'ready', False)
+            )
+            rotation_authorized = bool(
+                getattr(self, 'rotation_authorized', False)
+            )
+            lifecycle_violations = list(
+                getattr(self, 'pre_ready_lifecycle_violations', ())
+            )
+            vicon_progression_error = getattr(
+                self,
+                'vicon_status_progression_error',
+                None,
+            )
+            vicon_status_fault = getattr(
+                self,
+                'vicon_status_fault',
+                None,
+            )
+            vicon_status_valid_samples = getattr(
+                self,
+                'vicon_status_valid_samples',
+                0,
+            )
+        errors = operational_heartbeat_errors(
+            observed_at,
+            now,
+            self.heartbeat_stale_sec,
+        )
+        errors.extend(
+            'pre-readiness lifecycle violation: ' + violation['error']
+            for violation in lifecycle_violations
+        )
+        if (
+            'vicon_evaluation_status' in selected
+            and vicon_progression_error is not None
+        ):
+            errors.append(vicon_progression_error)
+        if (
+            'vicon_evaluation_status' in selected
+            and vicon_status_fault is not None
+        ):
+            errors.append(vicon_status_fault)
+        if (
+            'vicon_evaluation_status' in selected
+            and vicon_status_valid_samples < 2
+        ):
+            errors.append(
+                'Vicon status requires two advancing samples in the current '
+                'readiness epoch'
+            )
+        validity = {}
+        for alias, observed in observed_at.items():
+            message_error = (
+                operational_message_error(
+                    alias,
+                    heartbeat_messages.get(alias),
+                    self.mode,
+                    self.algorithm_profile,
+                    require_search_state=not authorization_active,
+                    stationary_preflight=getattr(
+                        self,
+                        'stationary_preflight',
+                        False,
+                    ),
+                    rotation_authorized=rotation_authorized,
+                )
+                if observed is not None
+                else None
+            )
+            validity[alias] = observed is not None and message_error is None
+            if message_error is not None:
+                errors.append(message_error)
+        ages = {
+            alias: None if observed is None else now - observed
+            for alias, observed in observed_at.items()
+        }
+        return errors, ages, validity
+
+    def _save_operational_snapshot(self, snapshot):
+        with self._state_lock:
+            self.last_operational_snapshot = snapshot
+
+    def operational_snapshot(self):
+        """Return an isolated copy of the latest readiness evidence."""  # noqa: Q000
+        with self._state_lock:
+            return dict(self.last_operational_snapshot)
+
+    def pre_ready_nonzero_snapshot(self):
+        """Return all permanently retained pre-authorization motion."""  # noqa: Q000
+        with self._state_lock:
+            snapshot = {
+                topic: observed
+                for topic, observed in (
+                    self.pre_ready_nonzero_observed_at.items()
+                )
+                if observed is not None
+            }
+            if (
+                getattr(
+                    self,
+                    'pre_rotation_authorization_nonzero_observed_at',
+                    None,
+                )
+                is not None
+            ):
+                snapshot['/gesc_gaussian/rotation_command_rpm'] = (
+                    self.pre_rotation_authorization_nonzero_observed_at
+                )
+            return snapshot
+
+    def pre_ready_lifecycle_snapshot(self):
+        """Return permanently retained pre-authorization lifecycle evidence."""
+        with self._state_lock:
+            return [
+                dict(violation)
+                for violation in getattr(
+                    self,
+                    'pre_ready_lifecycle_violations',
+                    (),
+                )
+            ]
+
+    def gate_snapshot(self):
+        """Return the two recorder-owned physical authorization states."""
+
+        with self._state_lock:
+            return {
+                'recording_ready': bool(self.ready),
+                'recording_ready_ever': bool(
+                    getattr(self, 'authorization_ever_succeeded', False)
+                ),
+                'rotation_authorized': bool(
+                    getattr(self, 'rotation_authorized', False)
+                ),
+                'rotation_authorized_ever': bool(
+                    getattr(self, 'rotation_authorized_ever', False)
+                ),
+            }
+
+    def operational_errors(self, deadline=None, aliases=None):
+        """Return current heartbeat and simulation-controller faults."""  # noqa: Q000
+        now = time.monotonic()
+        errors, heartbeat_ages, heartbeat_validity = (
+            self._heartbeat_status(now, aliases=aliases)
+        )
+        snapshot = {
+            'checked_at_monotonic': now,
+            'epoch_monotonic': self.operational_epoch_monotonic,
+            'heartbeat_stale_sec': self.heartbeat_stale_sec,
+            'heartbeat_ages_sec': heartbeat_ages,
+            'heartbeat_valid': heartbeat_validity,
+            'pre_ready_lifecycle_violations': (
+                self.pre_ready_lifecycle_snapshot()
+            ),
+            'controller_manager_service': self.controller_manager_service,
+            'required_active_controllers': list(self.required_controllers),
+            'controller_states': {},
+        }
+        if self.controller_manager_client is None:
+            snapshot['errors'] = list(errors)
+            snapshot['passed'] = not errors
+            self._save_operational_snapshot(snapshot)
+            return errors
+        if not self.controller_manager_client.service_is_ready():
+            errors = [
+                *errors,
+                f'controller manager service unavailable: '
+                f'{self.controller_manager_service}',
+            ]
+            snapshot['errors'] = list(errors)
+            snapshot['passed'] = False
+            self._save_operational_snapshot(snapshot)
+            return errors
+        future = self.controller_manager_client.call_async(
+            self.controller_manager_service_type.Request()
+        )
+        response_deadline = (
+            time.monotonic() + CONTROLLER_MANAGER_RESPONSE_TIMEOUT_SEC
+        )
+        if deadline is not None:
+            response_deadline = min(response_deadline, float(deadline))
+        while not future.done() and time.monotonic() < response_deadline:
+            time.sleep(0.01)
+        if not future.done():
+            future.cancel()
+            errors = [
+                *errors,
+                'controller manager response timed out: '
+                f'{self.controller_manager_service}',
+            ]
+            snapshot['errors'] = list(errors)
+            snapshot['passed'] = False
+            self._save_operational_snapshot(snapshot)
+            return errors
+        completed_at = time.monotonic()
+        if (
+            completed_at > response_deadline
+            or deadline is not None
+            and completed_at > float(deadline)
+        ):
+            errors = [
+                *errors,
+                'controller manager response completed after deadline: '
+                f'{self.controller_manager_service}',
+            ]
+            snapshot['checked_at_monotonic'] = completed_at
+            snapshot['errors'] = list(errors)
+            snapshot['passed'] = False
+            self._save_operational_snapshot(snapshot)
+            return errors
+        if future.exception() is not None:
+            errors = [
+                *errors,
+                'controller manager call failed: '
+                f'{future.exception()}',
+            ]
+            snapshot['errors'] = list(errors)
+            snapshot['passed'] = False
+            self._save_operational_snapshot(snapshot)
+            return errors
+        controllers = list(future.result().controller)
+        now = time.monotonic()
+        errors, heartbeat_ages, heartbeat_validity = (
+            self._heartbeat_status(now, aliases=aliases)
+        )
+        snapshot['checked_at_monotonic'] = now
+        snapshot['heartbeat_ages_sec'] = heartbeat_ages
+        snapshot['heartbeat_valid'] = heartbeat_validity
+        snapshot['controller_states'] = {
+            str(controller.name): str(controller.state)
+            for controller in controllers
+        }
+        controller_error = controller_state_error(
+            controllers,
+            self.required_controllers,
+        )
+        if controller_error is not None:
+            errors.append(controller_error)
+        snapshot['errors'] = list(errors)
+        snapshot['passed'] = not errors
+        self._save_operational_snapshot(snapshot)
+        return errors
+
+    def authorize_if_safe(self, deadline=None, aliases=None):
+        """Atomically authorize only after a final live safety snapshot."""  # noqa: Q000
+        errors = list(self.operational_errors(deadline, aliases=aliases))
+        now = time.monotonic()
+        with self._state_lock:
+            heartbeat_errors, heartbeat_ages, heartbeat_validity = (
+                self._heartbeat_status(now, aliases=aliases)
+            )
+            errors.extend(
+                error for error in heartbeat_errors if error not in errors
+            )
+            if any(
+                observed is not None
+                for observed in self.pre_ready_nonzero_observed_at.values()
+            ):
+                errors.append(
+                    'nonzero command observed before readiness authorization'
+                )
+            if self.mode == 'physical' and not self.rotation_authorized:
+                errors.append(
+                    'sensor rotation was not authorized before base readiness'
+                )
+            if deadline is not None and now > float(deadline):
+                errors.append(
+                    'preflight deadline expired before readiness authorization'
+                )
+            if getattr(
+                self,
+                'preauthorization_monitoring_closed',
+                False,
+            ):
+                errors.append(
+                    'preauthorization monitoring closed before readiness '
+                    'authorization'
+                )
+            snapshot = dict(self.last_operational_snapshot)
+            snapshot['authorization_checked_at_monotonic'] = now
+            snapshot['heartbeat_ages_sec'] = heartbeat_ages
+            snapshot['heartbeat_valid'] = heartbeat_validity
+            snapshot['authorization_errors'] = list(errors)
+            snapshot['authorization_passed'] = not errors
+            self.last_operational_snapshot = snapshot
+            if not errors:
+                self.ready = True
+                self.authorization_ever_succeeded = True
+                self.preauthorization_monitoring_closed = True
+        return errors
+
+    def authorize_rotation_if_safe(self, aliases, deadline=None):
+        """Authorize only the selected sensor mechanism after passive checks."""
+
+        errors = list(self.operational_errors(deadline, aliases=aliases))
+        now = time.monotonic()
+        with self._state_lock:
+            if any(
+                observed is not None
+                for observed in self.pre_ready_nonzero_observed_at.values()
+            ):
+                errors.append(
+                    'nonzero base command observed before rotation authorization'
+                )
+            if (
+                getattr(
+                    self,
+                    'pre_rotation_authorization_nonzero_observed_at',
+                    None,
+                )
+                is not None
+            ):
+                errors.append(
+                    'nonzero rotation command observed before rotation '
+                    'authorization'
+                )
+            if deadline is not None and now > float(deadline):
+                errors.append('preflight deadline expired before rotation authorization')
+            if self.preauthorization_monitoring_closed:
+                errors.append(
+                    'preauthorization monitoring closed before rotation authorization'
+                )
+            if not errors:
+                self.rotation_authorized = True
+                self.rotation_authorized_ever = True
+        if not errors:
+            self.publish_ready()
+        return errors
+
+    def revoke_if_unsafe(self):
+        """Fail a live physical run closed when operational evidence drifts."""
+
+        errors = list(self.operational_errors())
+        if not errors:
+            return []
+        with self._state_lock:
+            was_ready = bool(self.ready)
+            snapshot = dict(self.last_operational_snapshot)
+            snapshot['runtime_revocation_errors'] = list(errors)
+            snapshot['runtime_revoked_at_monotonic'] = time.monotonic()
+            self.last_operational_snapshot = snapshot
+        if was_ready:
+            self.request_stop()
+        return errors
+
+    def _twist_callback(self, message):
+        self._record_command(
+            ZERO_TOPICS[0],
+            (message.linear.x, message.linear.y, message.linear.z,
+             message.angular.x, message.angular.y, message.angular.z),
+        )
+
+    def _array_callback(self, message):
+        self._record_command(ZERO_TOPICS[1], message.data)
+
+    def _diagnostics_callback(self, message):
+        # Invalid typed diagnostics often contain six default zeros. Treat
+        # those as invalid/nonzero evidence so they cannot prove shutdown.
+        values = (
+            message.final_command
+            if getattr(message, 'final_command_valid', False) is True else ()
+        )
+        self._record_command(ZERO_TOPICS[2], values)
+        with self._state_lock:
+            self.latest_control_diagnostics = message
+            self.latest_control_diagnostics_observed_at = time.monotonic()
+
+    def final_zero_since(self, monotonic_time):
+        """Return when every command became stably zero, else ``None``."""
+
+        with self._state_lock:
+            nonzero_observed_at = getattr(self, 'nonzero_observed_at', {})
+            base_zero = all(
+                observed is not None and observed >= monotonic_time
+                and (
+                    nonzero_observed_at.get(topic) is None
+                    or observed >= nonzero_observed_at[topic]
+                )
+                for topic, observed in self.zero_observed_at.items()
+            )
+            rotation_zero = (
+                getattr(self, 'mode', None) != 'physical'
+                or getattr(self, 'rotation_zero_observed_at', None) is not None
+                and self.rotation_zero_observed_at >= monotonic_time
+                and (
+                    getattr(self, 'rotation_nonzero_observed_at', None) is None
+                    or self.rotation_zero_observed_at
+                    >= self.rotation_nonzero_observed_at
+                )
+            )
+            if not base_zero or not rotation_zero:
+                return None
+            zero_times = list(self.zero_observed_at.values())
+            if getattr(self, 'mode', None) == 'physical':
+                zero_times.append(self.rotation_zero_observed_at)
+            return max(float(observed) for observed in zero_times)
+
+    def final_zero_after(self, monotonic_time):
+        """Return whether every command has fresh zero evidence."""
+
+        return self.final_zero_since(monotonic_time) is not None
+
+
+class _ConsoleCapture:
+    """Line-buffer subprocess output into one durable console log."""
+
+    def __init__(self, path):
+        self._stream = Path(path).open("a", encoding="utf-8", buffering=1)
+        self._lock = threading.Lock()
+        self._threads = []
+        self.fatal_lines = []
+        self._terminal_stream = None
+        self._terminal_queue = None
+        self._terminal_thread = None
+        self._terminal_failed = False
+        self._terminal_sentinel = object()
+
+    def enable_terminal(self, stream=None):
+        """Tee future durable lines to an operator terminal when available."""
+
+        self._terminal_stream = sys.stdout if stream is None else stream
+        self._terminal_queue = queue.Queue(maxsize=256)
+
+        def consume_terminal():
+            while True:
+                rendered = self._terminal_queue.get()
+                if rendered is self._terminal_sentinel:
+                    return
+                try:
+                    self._terminal_stream.write(rendered)
+                    self._terminal_stream.flush()
+                except (BrokenPipeError, OSError, ValueError):
+                    self._terminal_failed = True
+                    return
+
+        self._terminal_thread = threading.Thread(
+            target=consume_terminal,
+            daemon=True,
+        )
+        self._terminal_thread.start()
+
+    def _enqueue_terminal(self, rendered):
+        if self._terminal_queue is None or self._terminal_failed:
+            return
+        try:
+            self._terminal_queue.put_nowait(rendered)
+            return
+        except queue.Full:
+            pass
+        try:
+            self._terminal_queue.get_nowait()
+        except queue.Empty:
+            return
+        try:
+            self._terminal_queue.put_nowait(rendered)
+        except queue.Full:
+            return
+
+    def log(self, source, line):
+        timestamp = _iso_now()
+        rendered = f"[{timestamp}] [{source}] {line.rstrip()}\n"
+        with self._lock:
+            self._stream.write(rendered)
+            lowered = line.lower()
+            if source == "target" and (
+                "process has died" in lowered
+                or "traceback (most recent call last)" in lowered
+                or "rclerror" in lowered
+            ):
+                self.fatal_lines.append(line.rstrip())
+        self._enqueue_terminal(rendered)
+
+    def attach(self, source, process):
+        def consume():
+            for line in iter(process.stdout.readline, ""):
+                self.log(source, line)
+        thread = threading.Thread(target=consume, daemon=True)
+        thread.start()
+        self._threads.append(thread)
+
+    def close(self):
+        for thread in self._threads:
+            thread.join(timeout=2.0)
+        if self._terminal_queue is not None:
+            self._enqueue_terminal(self._terminal_sentinel)
+        if self._terminal_thread is not None:
+            self._terminal_thread.join(timeout=2.0)
+        self._stream.close()
+
+
+def _process(command, cwd):
+    return subprocess.Popen(
+        command, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+        text=True, bufsize=1, start_new_session=True,
+    )
+
+
+def _process_tree(root_pid):
+    """Snapshot descendants with start ticks so PID reuse cannot be signaled."""
+
+    snapshot = {}
+    pending = [int(root_pid)]
+    while pending:
+        pid = pending.pop()
+        try:
+            stat = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8").split()
+            command = Path(f"/proc/{pid}/comm").read_text(encoding="utf-8").strip()
+            children_text = Path(
+                f"/proc/{pid}/task/{pid}/children"
+            ).read_text(encoding="utf-8")
+        except OSError:
+            continue
+        children = [int(value) for value in children_text.split()]
+        snapshot[pid] = {
+            "start_ticks": stat[21],
+            "command": command,
+            "children": children,
+        }
+        pending.extend(children)
+    return snapshot
+
+
+def _same_process(pid, start_ticks):
+    try:
+        fields = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8").split()
+    except OSError:
+        return False
+    return len(fields) > 21 and fields[21] == start_ticks
+
+
+def _signal_snapshot(snapshot, names, signum, interval_sec=0.0):
+    targets = [
+        (pid, identity)
+        for pid, identity in sorted(snapshot.items())
+        if identity["command"] in names
+    ]
+    for index, (pid, identity) in enumerate(targets):
+        if identity["command"] not in names:
+            continue
+        if _same_process(pid, identity["start_ticks"]):
+            try:
+                os.kill(pid, signum)
+            except ProcessLookupError:
+                pass
+        if interval_sec > 0.0 and index + 1 < len(targets):
+            time.sleep(interval_sec)
+
+
+def _live_snapshot_processes(snapshot, names=None):
+    return {
+        pid: identity for pid, identity in snapshot.items()
+        if (names is None or identity["command"] in names)
+        and _same_process(pid, identity["start_ticks"])
+    }
+
+
+def _live_leaf_processes(snapshot):
+    live = _live_snapshot_processes(snapshot)
+    live_pids = set(live)
+    return {
+        pid: identity
+        for pid, identity in live.items()
+        if not live_pids.intersection(identity.get("children", ()))
+    }
+
+
+def _stop_process(
+    process,
+    timeout_sec,
+    stop_named_descendants=(),
+    signal_descendant_leaves=False,
+):
+    if process is None:
+        return None, True
+    descendants = {}
+    clean = True
+    if process.poll() is None:
+        descendants = _process_tree(process.pid)
+        if stop_named_descendants:
+            names = set(stop_named_descendants)
+            _signal_snapshot(descendants, names, signal.SIGINT)
+            deadline = time.monotonic() + min(3.0, max(0.0, timeout_sec))
+            while (
+                time.monotonic() < deadline
+                and _live_snapshot_processes(descendants, names)
+            ):
+                time.sleep(0.05)
+        if signal_descendant_leaves:
+            leaves = _live_leaf_processes(descendants)
+            _signal_snapshot(
+                leaves,
+                {identity["command"] for identity in leaves.values()},
+                signal.SIGINT,
+                interval_sec=LEAF_SHUTDOWN_STAGGER_SEC,
+            )
+        else:
+            os.killpg(process.pid, signal.SIGINT)
+        try:
+            process.wait(timeout=timeout_sec)
+        except subprocess.TimeoutExpired:
+            os.killpg(process.pid, signal.SIGTERM)
+            try:
+                process.wait(timeout=3.0)
+            except subprocess.TimeoutExpired:
+                os.killpg(process.pid, signal.SIGKILL)
+                process.wait(timeout=3.0)
+            clean = False
+    if descendants:
+        # Launch can exit before all of its children. The start-time identity
+        # prevents signaling a reused PID while ensuring no run contaminates
+        # the next experiment.
+        deadline = time.monotonic() + 3.0
+        while time.monotonic() < deadline and _live_snapshot_processes(descendants):
+            time.sleep(0.05)
+        survivors = _live_snapshot_processes(descendants)
+        if survivors:
+            _signal_snapshot(
+                survivors,
+                {identity["command"] for identity in survivors.values()},
+                signal.SIGTERM,
+            )
+            clean = False
+    return process.returncode, clean
+
+
+def _cleanup_call(errors, label, callback, default=None):
+    """Run one cleanup step, retaining its error without aborting teardown."""
+    try:
+        return callback()
+    except Exception as exc:  # Cleanup must continue after a local failure.
+        errors.append(f'{label}: {type(exc).__name__}: {exc}')
+        return default
+
+
+def _wait_for_stable_final_zero(
+    node,
+    shutdown_started,
+    zero_timeout_sec,
+    stable_dwell_sec,
+    errors,
+    label,
+):
+    """Require a full zero dwell that restarts after every later command."""
+
+    discovery_deadline = time.monotonic() + max(0.0, zero_timeout_sec)
+    final_deadline = discovery_deadline + max(0.0, stable_dwell_sec)
+    compatibility_candidate = None
+    while time.monotonic() <= final_deadline:
+        def observe_stable_since():
+            nonlocal compatibility_candidate
+            stable_method = getattr(node, 'final_zero_since', None)
+            if stable_method is not None:
+                return stable_method(shutdown_started)
+            # Shared Phase 05 doubles expose only the earlier boolean API.
+            # The production coordinator always takes the timestamped path.
+            if node.final_zero_after(shutdown_started):
+                if compatibility_candidate is None:
+                    compatibility_candidate = time.monotonic()
+                return compatibility_candidate
+            compatibility_candidate = None
+            return None
+
+        stable_since = _cleanup_call(
+            errors,
+            label,
+            observe_stable_since,
+            default=None,
+        )
+        if errors and errors[-1].startswith(f'{label}:'):
+            return False
+        now = time.monotonic()
+        if (
+            stable_since is not None
+            and stable_since <= discovery_deadline
+            and now - stable_since >= max(0.0, stable_dwell_sec)
+        ):
+            return True
+        if stable_since is None and now > discovery_deadline:
+            return False
+        if stable_since is not None and stable_since > discovery_deadline:
+            return False
+        time.sleep(0.05)
+    return False
+
+
+def _shutdown_recording_resources(
+    *,
+    node,
+    executor,
+    spin_thread,
+    target_process,
+    bag_process,
+    shutdown_zero_timeout_sec,
+    post_zero_record_sec,
+    target_exit_timeout_sec,
+):
+    """Stop recording resources in signal-safe dependency order."""
+    errors = []
+    shutdown_started = time.monotonic()
+    zero_complete = False
+    if node is not None:
+        _cleanup_call(
+            errors,
+            'publish readiness false and stop true',
+            node.request_stop,
+        )
+        zero_complete = _wait_for_stable_final_zero(
+            node,
+            shutdown_started,
+            shutdown_zero_timeout_sec,
+            post_zero_record_sec,
+            errors,
+            'observe stable final zero',
+        )
+
+    target_code, target_clean = _cleanup_call(
+        errors,
+        'stop target process',
+        lambda: _stop_process(
+            target_process,
+            target_exit_timeout_sec,
+            stop_named_descendants=('gazebo', 'gzserver', 'gzclient'),
+            signal_descendant_leaves=True,
+        ),
+        default=(None, False),
+    )
+    if (
+        node is not None
+        and zero_complete
+        and getattr(node, 'final_zero_since', None) is not None
+    ):
+        # Target teardown can emit another command. If it does, require a new
+        # complete dwell while rosbag remains active.
+        zero_complete = _wait_for_stable_final_zero(
+            node,
+            shutdown_started,
+            shutdown_zero_timeout_sec,
+            post_zero_record_sec,
+            errors,
+            'recheck stable final zero after target shutdown',
+        )
+    bag_code, bag_clean = _cleanup_call(
+        errors,
+        'stop rosbag process',
+        lambda: _stop_process(bag_process, 15.0),
+        default=(None, False),
+    )
+
+    if executor is not None and node is not None:
+        _cleanup_call(
+            errors,
+            'remove coordinator from executor',
+            lambda: executor.remove_node(node),
+        )
+    if executor is not None:
+        shutdown_result = _cleanup_call(
+            errors,
+            'stop coordinator executor',
+            lambda: executor.shutdown(timeout_sec=2.0),
+            default=False,
+        )
+        if shutdown_result is False and not any(
+            item.startswith('stop coordinator executor:')
+            for item in errors
+        ):
+            errors.append(
+                'stop coordinator executor: executor did not stop in 2.0 s'
+            )
+    if spin_thread is not None:
+        _cleanup_call(
+            errors,
+            'join coordinator spin thread',
+            lambda: spin_thread.join(timeout=2.0),
+        )
+        is_alive = _cleanup_call(
+            errors,
+            'inspect coordinator spin thread',
+            spin_thread.is_alive,
+            default=True,
+        )
+        if is_alive:
+            errors.append(
+                'join coordinator spin thread: thread remained alive'
+            )
+    if node is not None:
+        _cleanup_call(
+            errors,
+            'destroy recording coordinator',
+            node.destroy_node,
+        )
+    context_ok = _cleanup_call(
+        errors,
+        'inspect rclpy context',
+        rclpy.ok,
+        default=False,
+    )
+    if context_ok:
+        _cleanup_call(
+            errors,
+            'shutdown rclpy context',
+            rclpy.try_shutdown,
+        )
+    return {
+        'shutdown_started': shutdown_started,
+        'zero_complete': zero_complete,
+        'target_code': target_code,
+        'target_clean': target_clean,
+        'bag_code': bag_code,
+        'bag_clean': bag_clean,
+        'errors': errors,
+    }
+
+
+def _graph_snapshot(node, entries):
+    graph_types = dict(node.get_topic_names_and_types())
+    publishers = {}
+    recorder_subscriptions = set()
+    for entry in entries:
+        topic = entry["topic"]
+        publishers[topic] = [
+            _endpoint_name(endpoint)
+            for endpoint in node.get_publishers_info_by_topic(topic)
+        ]
+        for endpoint in node.get_subscriptions_info_by_topic(topic):
+            if endpoint.node_name == "rosbag2_recorder":
+                recorder_subscriptions.add(topic)
+    ready_subscribers = {
+        _endpoint_name(endpoint)
+        for endpoint in node.get_subscriptions_info_by_topic(node.ready_topic)
+    }
+    return graph_types, publishers, recorder_subscriptions, ready_subscribers
+
+
+def physical_rotation_subscriber_error(node, stationary_preflight):
+    """Require the selected gate consumer, or prove it is omitted entirely."""
+
+    if not node.rotation_authorized_topic:
+        return 'physical rotation authorization publisher is unavailable'
+    subscribers = {
+        _endpoint_name(endpoint)
+        for endpoint in node.get_subscriptions_info_by_topic(
+            node.rotation_authorized_topic
+        )
+        if endpoint.node_name != 'rosbag2_recorder'
+    }
+    expected = (
+        set()
+        if stationary_preflight
+        else {'/phase09_rotation'}
+    )
+    if subscribers == expected:
+        return None
+    return (
+        f'{node.rotation_authorized_topic}: expected selected gate '
+        f'subscribers {sorted(expected)}, found {sorted(subscribers)}'
+    )
+
+
+def _full_node_name(name, namespace):
+    namespace = namespace.rstrip("/")
+    return f"{namespace}/{name}" if namespace else f"/{name}"
+
+
+def _bounded_timeout(deadline, maximum):
+    """Return a positive timeout capped by an optional absolute deadline."""  # noqa: Q000
+    if deadline is None:
+        return float(maximum)
+    remaining = float(deadline) - time.monotonic()
+    if remaining <= 0.0:
+        raise PreflightDeadlineExceeded('preflight deadline expired')
+    return min(float(maximum), remaining)
+
+
+def _wait_for_parameter_response(client, request, deadline=None):
+    service_name = client.srv_name
+    if not client.wait_for_service(
+        timeout_sec=_bounded_timeout(
+            deadline,
+            PARAMETER_SERVICE_AVAILABILITY_TIMEOUT_SEC,
+        )
+    ):
+        raise TimeoutError(f"service unavailable after timeout: {service_name}")
+    future = client.call_async(request)
+    response_deadline = (
+        time.monotonic() + PARAMETER_SNAPSHOT_TIMEOUT_SEC
+    )
+    if deadline is not None:
+        response_deadline = min(response_deadline, float(deadline))
+    while not future.done() and time.monotonic() < response_deadline:
+        time.sleep(0.01)
+    if not future.done():
+        future.cancel()
+        if deadline is not None and time.monotonic() >= float(deadline):
+            raise PreflightDeadlineExceeded(
+                f'preflight deadline expired waiting for {service_name}'
+            )
+        raise TimeoutError(f"service response timed out: {service_name}")
+    if deadline is not None and time.monotonic() > float(deadline):
+        raise PreflightDeadlineExceeded(
+            f'preflight deadline expired waiting for {service_name}'
+        )
+    if future.exception() is not None:
+        raise RuntimeError(
+            f"service call failed for {service_name}: {future.exception()}"
+        )
+    return future.result()
+
+
+def required_node_parameter_errors(observed, required):
+    """Return missing or mismatched physical parameter values."""
+
+    errors = []
+    for full_name, parameters in required.items():
+        observed_parameters = observed.get(full_name, {})
+        for name, expected in parameters.items():
+            if name not in observed_parameters:
+                errors.append(
+                    f'physical required parameter missing: {full_name}.{name}'
+                )
+                continue
+            actual = observed_parameters[name]
+            if type(actual) is not type(expected) or actual != expected:
+                errors.append(
+                    'physical required parameter mismatch: '
+                    f'{full_name}.{name} expected={expected!r} '
+                    f'observed={actual!r}'
+                )
+    return errors
+
+
+def enforce_required_node_parameters(node, required, deadline=None):
+    """Set and immediately verify required physical node parameters."""
+
+    evidence = {
+        'attempted_at_utc': _iso_now(),
+        'required': {
+            name: dict(parameters)
+            for name, parameters in required.items()
+        },
+        'observed': {},
+        'set_results': {},
+        'errors': [],
+        'passed': False,
+    }
+    for full_name, parameters in sorted(required.items()):
+        set_client = node.create_client(
+            SetParameters,
+            f'{full_name}/set_parameters',
+        )
+        get_client = node.create_client(
+            GetParameters,
+            f'{full_name}/get_parameters',
+        )
+        try:
+            set_request = SetParameters.Request()
+            set_request.parameters = [
+                Parameter(name=name, value=value).to_parameter_msg()
+                for name, value in sorted(parameters.items())
+            ]
+            set_response = _wait_for_parameter_response(
+                set_client,
+                set_request,
+                deadline,
+            )
+            results = list(set_response.results)
+            evidence['set_results'][full_name] = [
+                {
+                    'successful': bool(result.successful),
+                    'reason': str(result.reason),
+                }
+                for result in results
+            ]
+            if len(results) != len(set_request.parameters):
+                evidence['errors'].append(
+                    'physical parameter set response length mismatch for '
+                    f'{full_name}'
+                )
+                continue
+            failures = [
+                str(result.reason) or 'unspecified rejection'
+                for result in results
+                if not result.successful
+            ]
+            if failures:
+                evidence['errors'].append(
+                    f'physical parameter set rejected for {full_name}: '
+                    + '; '.join(failures)
+                )
+                continue
+            get_request = GetParameters.Request()
+            get_request.names = sorted(parameters)
+            get_response = _wait_for_parameter_response(
+                get_client,
+                get_request,
+                deadline,
+            )
+            values = list(get_response.values)
+            if len(values) != len(get_request.names):
+                evidence['errors'].append(
+                    'physical parameter get response length mismatch for '
+                    f'{full_name}'
+                )
+                continue
+            evidence['observed'][full_name] = {
+                name: parameter_value_to_python(value)
+                for name, value in zip(get_request.names, values)
+            }
+        except PreflightDeadlineExceeded:
+            raise
+        except (RuntimeError, TimeoutError, TypeError, ValueError) as exc:
+            evidence['errors'].append(
+                f'{full_name}: {type(exc).__name__}: {exc}'
+            )
+        finally:
+            node.destroy_client(set_client)
+            node.destroy_client(get_client)
+    evidence['errors'].extend(
+        required_node_parameter_errors(evidence['observed'], required)
+    )
+    evidence['passed'] = not evidence['errors']
+    return evidence
+
+
+def required_parameter_snapshot_errors(snapshot, required):
+    """Verify the later full parameter snapshot still contains required values."""
+
+    observed = {}
+    for full_name in required:
+        entry = snapshot.get('nodes', {}).get(full_name, {})
+        parameters = entry.get('parameters', {})
+        observed[full_name] = (
+            parameters.get(full_name, {}).get('ros__parameters', {})
+            if entry.get('available')
+            else {}
+        )
+    return required_node_parameter_errors(observed, required)
+
+
+def _insert_parameter(parameters, name, value):
+    target = parameters
+    components = name.split(".")
+    for component in components[:-1]:
+        target = target.setdefault(component, {})
+    target[components[-1]] = value
+
+
+def _capture_node_parameters_once(node, full_name, deadline=None):
+    service_types = (
+        (ListParameters, "list_parameters"),
+        (GetParameters, "get_parameters"),
+        (DescribeParameters, "describe_parameters"),
+    )
+    clients = {
+        suffix: node.create_client(service_type, f"{full_name}/{suffix}")
+        for service_type, suffix in service_types
+    }
+    try:
+        listed = _wait_for_parameter_response(
+            clients["list_parameters"],
+            ListParameters.Request(),
+            deadline,
+        )
+        names = sorted(listed.result.names)
+        get_request = GetParameters.Request()
+        get_request.names = names
+        values = _wait_for_parameter_response(
+            clients["get_parameters"],
+            get_request,
+            deadline,
+        ).values
+        describe_request = DescribeParameters.Request()
+        describe_request.names = names
+        descriptors = _wait_for_parameter_response(
+            clients["describe_parameters"],
+            describe_request,
+            deadline,
+        ).descriptors
+    finally:
+        for client in clients.values():
+            node.destroy_client(client)
+
+    if len(values) != len(names) or len(descriptors) != len(names):
+        raise RuntimeError(
+            f"parameter response length mismatch for {full_name}: "
+            f"{len(names)} names, {len(values)} values, "
+            f"{len(descriptors)} descriptors"
+        )
+    parameters = {}
+    parameter_types = {}
+    for name, value, descriptor in zip(names, values, descriptors):
+        _insert_parameter(parameters, name, parameter_value_to_python(value))
+        parameter_types[name] = Parameter.Type(descriptor.type).name.lower()
+    return {
+        full_name: {
+            "ros__parameters": parameters,
+        }
+    }, parameter_types
+
+
+def _capture_node_parameters(node, full_name, attempts=1, deadline=None):
+    attempts = max(1, int(attempts))
+    for attempt in range(attempts):
+        try:
+            return _capture_node_parameters_once(
+                node,
+                full_name,
+                deadline,
+            )
+        except PreflightDeadlineExceeded:
+            raise
+        except (RuntimeError, TimeoutError, ValueError):
+            if attempt + 1 >= attempts:
+                raise
+            time.sleep(
+                _bounded_timeout(
+                    deadline,
+                    PARAMETER_CAPTURE_RETRY_DELAY_SEC,
+                )
+            )
+
+
+def _capture_parameters(
+    node,
+    node_names,
+    required_publishers,
+    parameter_service_nodes,
+    deadline=None,
+):
+    snapshot = {"captured_at_utc": _iso_now(), "nodes": {}, "failures": []}
+    required_publishers = set(required_publishers)
+    for name, namespace in sorted(node_names):
+        _bounded_timeout(deadline, PARAMETER_SNAPSHOT_TIMEOUT_SEC)
+        full_name = _full_node_name(name, namespace)
+        if full_name not in parameter_service_nodes:
+            snapshot["nodes"][full_name] = {
+                "parameter_services_exposed": False,
+                "available": False,
+                "parameters": {},
+            }
+            continue
+        try:
+            parameters, parameter_types = _capture_node_parameters(
+                node,
+                full_name,
+                attempts=(
+                    REQUIRED_PARAMETER_CAPTURE_ATTEMPTS
+                    if full_name in required_publishers
+                    else 1
+                ),
+                deadline=deadline,
+            )
+            snapshot["nodes"][full_name] = {
+                "parameter_services_exposed": True,
+                "available": True,
+                "parameters": parameters,
+                "parameter_types": parameter_types,
+            }
+        except PreflightDeadlineExceeded:
+            raise
+        except (RuntimeError, TimeoutError, ValueError) as exc:
+            snapshot["nodes"][full_name] = {
+                "parameter_services_exposed": True,
+                "available": False,
+                "parameters": {},
+            }
+            snapshot["failures"].append({
+                "node": full_name,
+                "required_topic_publisher": full_name in required_publishers,
+                "parameter_services_exposed": True,
+                "error": f"{type(exc).__name__}: {exc}",
+            })
+    _bounded_timeout(deadline, PARAMETER_SNAPSHOT_TIMEOUT_SEC)
+    return snapshot
+
+
+def _default_asset(name):
+    return Path(get_package_share_directory("ros_esc")) / "experiment_recording" / name
+
+
+def _parser():
+    parser = argparse.ArgumentParser(
+        description="Record one simulation or physical GESC/Gaussian run."
+    )
+    parser.add_argument("--mode", choices=sorted(VALID_MODES), required=True)
+    parser.add_argument("--metadata-input", required=True)
+    parser.add_argument(
+        "--runs-root", default="~/Experiments/GESC-Gaussian/runs"
+    )
+    parser.add_argument("--manifest", default=str(_default_asset("topic_manifest.yaml")))
+    parser.add_argument(
+        "--evidence-file",
+        action="append",
+        default=[],
+        metavar="LABEL=PATH",
+        help="retain and hash one labeled file-backed run input",
+    )
+    parser.add_argument(
+        "--stream-console",
+        action="store_true",
+        help="tee managed subprocess and recorder lines to this terminal",
+    )
+    parser.add_argument(
+        "--live-diagnostics-period-sec",
+        type=float,
+        default=0.0,
+        help="emit a passive operator summary at this period; zero disables",
+    )
+    parser.add_argument("--run-id")
+    parser.add_argument("--storage-id", default="sqlite3")
+    parser.add_argument("--duration-sec", type=float, default=0.0)
+    parser.add_argument("--preflight-timeout-sec", type=float, default=45.0)
+    parser.add_argument(
+        "--rotation-startup-timeout-sec",
+        type=float,
+        default=45.0,
+        help=(
+            "physical-only bound after passive checks for sensor alignment, "
+            "settling, and full data-plane startup"
+        ),
+    )
+    parser.add_argument("--recorder-ready-timeout-sec", type=float, default=15.0)
+    parser.add_argument("--shutdown-zero-timeout-sec", type=float, default=3.0)
+    parser.add_argument("--target-exit-timeout-sec", type=float, default=15.0)
+    parser.add_argument("--post-zero-record-sec", type=float, default=0.5)
+    parser.add_argument("--recording-ready-rate-hz", type=float, default=10.0)
+    parser.add_argument("--recording-ready-topic", default="/gesc_gaussian/recording_ready")
+    parser.add_argument(
+        "--rotation-authorized-topic",
+        default="/gesc_gaussian/rotation_authorized",
+    )
+    parser.add_argument(
+        "--stationary-preflight",
+        action="store_true",
