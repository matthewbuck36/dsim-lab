+"""Pure parsing and calibration helpers for the physical photoresistor."""
+
+from dataclasses import dataclass
+import math
+from pathlib import Path
+import re
+
+import yaml
+
+
+_NUMBER = r"[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?"
+_READING = re.compile(
+    rf"^\s*v:\s*({_NUMBER})\s*,\s*r:\s*({_NUMBER})\s*$"
+)
+_PHASE09_SCENARIO_IDS = {
+    "primary": "phase09_selected_primary_r1p5_a45_ratio1to4",
+    "secondary": "phase09_selected_secondary_r1p5_a67p5_ratio1to4",
+}
+_PHASE09_READINESS_FIELDS = (
+    "motion_ready",
+    "operator_assigned",
+    "calibration_complete",
+    "live_pi_transfer_verified",
+    "stationary_graph_verified",
+    "emergency_stop_verified",
+    "observer_assigned",
+    "open_field_verified",
+    "explicit_motion_authorization",
+)
+
+
+@dataclass(frozen=True)
+class PhotoresistorReading:
+    """One finite Arduino reading in physical units."""
+
+    voltage_v: float
+    resistance_ohm: float
+
+
+@dataclass(frozen=True)
+class PhotoresistorCalibration:
+    """Validated, motion-gating subset of the calibration document."""
+
+    status: str
+    motion_ready: bool
+    serial_device: str
+    voltage_min_v: float | None
+    voltage_max_v: float | None
+    source_score_enabled: bool
+    source_score_min_v: float | None
+    source_score_max_v: float | None
+
+    def accepts(self, voltage_v):
+        """Return whether a voltage is finite and inside the frozen range."""
+
+        value = float(voltage_v)
+        if not math.isfinite(value):
+            return False
+        if self.voltage_min_v is None or self.voltage_max_v is None:
+            return not self.motion_ready
+        return self.voltage_min_v <= value <= self.voltage_max_v
+
+    def source_score(self, voltage_v):
+        """Return the calibrated dimensionless score, or ``None``."""
+
+        if not self.source_score_enabled:
+            return None
+        value = float(voltage_v)
+        low = self.source_score_min_v
+        high = self.source_score_max_v
+        if low is None or high is None or not low < high:
+            return None
+        if not math.isfinite(value) or value < low or value > high:
+            return None
+        return min(1.0, max(0.0, (value - low) / (high - low)))
+
+
+@dataclass(frozen=True)
+class PhotoresistorPayload:
+    """One validated voltage reading in the public physical cost convention."""
+
+    raw_sensor_v: float
+    raw_cost_v: float
+    resistance_ohm: float
+    source_score: float | None
+
+
+def parse_photoresistor_line(text):
+    """Parse exactly ``v: <float>, r: <float>`` and reject nonfinite data."""
+
+    if not isinstance(text, str):
+        raise ValueError("photoresistor input must be text")
+    match = _READING.fullmatch(text)
+    if match is None:
+        raise ValueError("photoresistor input does not match the Arduino protocol")
+    voltage_v, resistance_ohm = (float(value) for value in match.groups())
+    if not math.isfinite(voltage_v) or not math.isfinite(resistance_ohm):
+        raise ValueError("photoresistor values must be finite")
+    return PhotoresistorReading(voltage_v, resistance_ohm)
+
+
+def build_voltage_payload(reading, calibration=None, source_score_enabled=False):
+    """Apply range validation and the preserved negative-voltage cost sign."""
+
+    if not isinstance(reading, PhotoresistorReading):
+        raise ValueError("reading must be a PhotoresistorReading")
+    if calibration is not None and not isinstance(
+        calibration, PhotoresistorCalibration
+    ):
+        raise ValueError("calibration must be a PhotoresistorCalibration or None")
+    if (
+        calibration is not None
+        and calibration.motion_ready
+        and not calibration.accepts(reading.voltage_v)
+    ):
+        raise ValueError("voltage is outside the calibrated range")
+    score = None
+    if source_score_enabled and calibration is not None:
+        score = calibration.source_score(reading.voltage_v)
+    return PhotoresistorPayload(
+        raw_sensor_v=float(reading.voltage_v),
+        raw_cost_v=-float(reading.voltage_v),
+        resistance_ohm=float(reading.resistance_ohm),
+        source_score=score,
+    )
+
+
+def _optional_finite(mapping, key):
+    value = mapping.get(key)
+    if value is None:
+        return None
+    value = float(value)
+    if not math.isfinite(value):
+        raise ValueError(f"{key} must be finite or null")
+    return value
+
+
+def load_calibration(path):
+    """Load the inert/calibrated Phase 09 schema without inventing values."""
+
+    document = yaml.safe_load(Path(path).read_text(encoding="utf-8"))
+    if not isinstance(document, dict) or document.get("schema_version") != 1:
+        raise ValueError("photoresistor calibration schema_version must be 1")
+    status = str(document.get("status", "")).strip()
+    if status not in {"uncalibrated", "calibrated"}:
+        raise ValueError("calibration status must be uncalibrated or calibrated")
+    motion_ready = document.get("motion_ready")
+    if not isinstance(motion_ready, bool):
+        raise ValueError("calibration motion_ready must be boolean")
+    serial_device = document.get("serial_device")
+    serial_device = "" if serial_device is None else str(serial_device).strip()
+    voltage_range = document.get("voltage_range_v", {})
+    score = document.get("source_score", {})
+    if not isinstance(voltage_range, dict) or not isinstance(score, dict):
+        raise ValueError("calibration voltage_range_v/source_score must be mappings")
+    voltage_min = _optional_finite(voltage_range, "minimum")
+    voltage_max = _optional_finite(voltage_range, "maximum")
+    score_enabled = score.get("enabled", False)
+    if not isinstance(score_enabled, bool):
+        raise ValueError("source_score.enabled must be boolean")
+    score_min = _optional_finite(score, "minimum_voltage_v")
+    score_max = _optional_finite(score, "maximum_voltage_v")
+    if document.get("raw_sensor_quantity") != "photoresistor_voltage":
+        raise ValueError("raw_sensor_quantity must be photoresistor_voltage")
+    if document.get("raw_sensor_unit") != "V":
+        raise ValueError("raw_sensor_unit must be V")
+    if document.get("raw_cost_convention") != "negative_voltage":
+        raise ValueError("raw_cost_convention must be negative_voltage")
+    if document.get("raw_cost_unit") != "V":
+        raise ValueError("raw_cost_unit must be V")
+    if motion_ready:
+        if status != "calibrated":
+            raise ValueError("motion_ready requires calibrated status")
+        if not serial_device.startswith("/dev/serial/by-id/"):
+            raise ValueError("motion_ready requires a stable serial device-by-id")
+        if voltage_min is None or voltage_max is None or not voltage_min < voltage_max:
+            raise ValueError("motion_ready requires an ordered voltage range")
+    elif status == "uncalibrated" and score_enabled:
+        raise ValueError("uncalibrated input cannot enable source_score")
+    if score_enabled and (
+        score_min is None or score_max is None or not score_min < score_max
+    ):
+        raise ValueError("enabled source_score requires an ordered voltage range")
+    return PhotoresistorCalibration(
+        status=status,
+        motion_ready=motion_ready,
+        serial_device=serial_device,
+        voltage_min_v=voltage_min,
+        voltage_max_v=voltage_max,
+        source_score_enabled=score_enabled,
+        source_score_min_v=score_min,
+        source_score_max_v=score_max,
+    )
+
+
+def validate_phase09_motion_inputs(
+    calibration_path,
+    serial_device,
+    metadata_path,
+    scenario,
+):
+    """Fail closed until calibration and all future live gates are reviewed."""
+
+    calibration = load_calibration(calibration_path)
+    metadata = yaml.safe_load(Path(metadata_path).read_text(encoding="utf-8"))
+    if not isinstance(metadata, dict):
+        raise ValueError("Phase 09 metadata must be a YAML mapping")
+    if scenario not in _PHASE09_SCENARIO_IDS:
+        raise ValueError("Phase 09 scenario must be primary or secondary")
+
+    readiness = metadata.get("physical_readiness")
+    metadata_calibration = metadata.get("calibration")
+    controller_contract = metadata.get("controller_input_contract")
+    response_target = metadata.get("physical_response_target")
+    stop_policy = metadata.get("stop_policy")
+    mappings = {
+        "metadata.physical_readiness": readiness,
+        "metadata.calibration": metadata_calibration,
+        "metadata.controller_input_contract": controller_contract,
+        "metadata.physical_response_target": response_target,
+        "metadata.stop_policy": stop_policy,
+    }
+    failed = [
+        name for name, value in mappings.items() if not isinstance(value, dict)
+    ]
+    if failed:
+        raise ValueError(
+            "Phase 09 inputs are motion-blocking; failed: " + ", ".join(failed)
+        )
+
+    operator = str(metadata.get("operator", "")).strip()
+    checks = {
+        "calibration.status": calibration.status == "calibrated",
+        "calibration.motion_ready": calibration.motion_ready is True,
+        "calibration.serial_device": calibration.serial_device == serial_device,
+        "metadata.schema_version": metadata.get("schema_version") == 1,
+        "metadata.mode": metadata.get("mode") == "physical",
+        "metadata.algorithm_profile": (
+            metadata.get("algorithm_profile") == "robust_gaussian_v1"
+        ),
+        "metadata.scenario_id": (
+            metadata.get("scenario_id") == _PHASE09_SCENARIO_IDS[scenario]
+        ),
+        "metadata.operator": operator.upper() not in {"", "UNASSIGNED", "TBD"},
+        "metadata.calibration.status": (
+            metadata_calibration.get("status") == "calibrated"
+        ),
+        "metadata.calibration.motion_ready": (
+            metadata_calibration.get("motion_ready") is True
+        ),
+        "metadata.response.measured": (
+            response_target.get("measured_and_frozen") is True
+        ),
+        "metadata.controller.known_source_count": (
+            controller_contract.get("known_source_count") == 2
+        ),
+        "metadata.controller.coordinates_hidden": (
+            controller_contract.get("coordinates_visible") is False
+        ),
+        "metadata.controller.roles_hidden": (
+            controller_contract.get("roles_visible") is False
+        ),
+        "metadata.controller.settings_hidden": (
+            controller_contract.get("lamp_settings_visible") is False
+        ),
+        "metadata.controller.no_evaluator_fields": (
+            controller_contract.get("evaluator_fields_forwarded") == []
+        ),
+        "metadata.stop.manual_ctrl_c": (
+            stop_policy.get("run_end") == "manual_operator_ctrl_c"
+        ),
+        "metadata.stop.no_coordinate_stop": (
+            stop_policy.get("automatic_coordinate_stop") is False
+        ),
+    }
+    for readiness_name in _PHASE09_READINESS_FIELDS:
+        checks[f"metadata.physical_readiness.{readiness_name}"] = (
+            readiness.get(readiness_name) is True
+        )
+    failed = [name for name, passed in checks.items() if not passed]
+    if failed:
+        raise ValueError(
+            "Phase 09 inputs are motion-blocking; failed: " + ", ".join(failed)
+        )
+    return calibration.source_score_enabled
