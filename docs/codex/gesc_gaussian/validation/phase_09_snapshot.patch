+            return (1000.0, 2000.0, 0.0), True
+
+        def GetSegmentGlobalRotationQuaternion(self, subject, segment):
+            self.pose_queries.append(("rotation", subject, segment))
+            return (0.0, 0.0, 0.0, 1.0), False
