+def _write_calibration(tmp_path, **updates):
+    document = {
+        "schema_version": 1,
+        "status": "uncalibrated",
+        "motion_ready": False,
+        "raw_sensor_quantity": "photoresistor_voltage",
+        "raw_sensor_unit": "V",
+        "raw_cost_convention": "negative_voltage",
+        "raw_cost_unit": "V",
+        "serial_device": None,
+        "voltage_range_v": {"minimum": None, "maximum": None},
+        "source_score": {
+            "enabled": False,
+            "minimum_voltage_v": None,
+            "maximum_voltage_v": None,
+        },
+    }
+    document.update(updates)
+    path = tmp_path / "calibration.yaml"
+    path.write_text(yaml.safe_dump(document, sort_keys=False), encoding="utf-8")
+    return path
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    (
+        ("v: 2.75, r: 1234.5", (2.75, 1234.5)),
+        ("  v: -1.25e-1 , r: +4.0E3  ", (-0.125, 4000.0)),
+    ),
+)
+def test_parser_accepts_only_finite_protocol_values(text, expected):
+    reading = parse_photoresistor_line(text)
+    assert (reading.voltage_v, reading.resistance_ohm) == expected
+
+
+@pytest.mark.parametrize(
