+            "record one finite physical no-actuation qualification while "
+            "holding both authorization gates false"
+        ),
+    )
+    parser.add_argument("--stop-topic", default="/gesc_gaussian/stop_requested")
+    parser.add_argument("target", nargs=argparse.REMAINDER)
+    return parser
+
+
+def run(arguments):
+    """Execute a managed recording and return a process exit code."""
+
+    manifest = load_manifest(arguments.manifest)
+    entries = applicable_topics(manifest, arguments.mode)
+    operational_config = operational_config_for_mode(
+        manifest,
+        arguments.mode,
+    )
+    if arguments.mode == 'physical' and not operational_config:
+        raise ValueError(
+            'physical record_run requires the Phase 09 operational readiness '
+            'contract'
+        )
+    metadata_input = load_metadata_input(arguments.metadata_input, arguments.mode)
+    stationary_preflight = bool(
+        getattr(arguments, "stationary_preflight", False)
+    )
+    metadata_stationary = (
+        "stationary_preflight_attestation" in metadata_input
+    )
+    if stationary_preflight != metadata_stationary:
+        raise ValueError(
+            "--stationary-preflight must exactly match the metadata "
+            "PREFLIGHT attestation"
+        )
+    if stationary_preflight and arguments.mode != "physical":
+        raise ValueError("--stationary-preflight is physical-only")
+    if arguments.mode == "physical":
+        entries = resolve_physical_variant_topics(
+            entries,
+            stationary_preflight,
+        )
+    duration_sec = float(arguments.duration_sec)
+    if not math.isfinite(duration_sec) or duration_sec < 0.0:
+        raise ValueError("--duration-sec must be finite and nonnegative")
+    if stationary_preflight and not 5.0 <= duration_sec <= 60.0:
+        raise ValueError(
+            "stationary preflight requires --duration-sec within [5, 60]"
+        )
+    timing_bounds = {
+        'preflight_timeout_sec': (45.0, 1.0, 300.0),
+        'recorder_ready_timeout_sec': (15.0, 0.1, 120.0),
+        'shutdown_zero_timeout_sec': (
+            3.0,
+            0.1 if arguments.mode == 'physical' else 0.0,
+            30.0,
+        ),
+        'target_exit_timeout_sec': (
+            15.0,
+            0.1 if arguments.mode == 'physical' else 0.0,
+            60.0,
+        ),
+        'post_zero_record_sec': (
+            0.5,
+            0.1 if arguments.mode == 'physical' else 0.0,
+            10.0,
+        ),
+        'recording_ready_rate_hz': (10.0, 1.0, 100.0),
+    }
+    for name, (default, minimum, maximum) in timing_bounds.items():
+        value = float(getattr(arguments, name, default))
+        if not math.isfinite(value) or not minimum <= value <= maximum:
+            option = '--' + name.replace('_', '-')
+            raise ValueError(
+                f'{option} must be finite and within '
+                f'[{minimum:g}, {maximum:g}]'
+            )
+    rotation_startup_timeout_sec = float(
+        getattr(arguments, "rotation_startup_timeout_sec", 45.0)
+    )
+    if (
+        not math.isfinite(rotation_startup_timeout_sec)
+        or not 12.0 <= rotation_startup_timeout_sec <= 120.0
+    ):
+        raise ValueError(
+            "--rotation-startup-timeout-sec must be within [12, 120]"
+        )
+    rotation_authorized_topic = str(
+        getattr(
+            arguments,
+            "rotation_authorized_topic",
+            "/gesc_gaussian/rotation_authorized",
+        )
+    )
+    if (
+        arguments.mode == "physical"
+        and rotation_authorized_topic
+        != "/gesc_gaussian/rotation_authorized"
+    ):
+        raise ValueError(
+            "physical rotation authorization topic must remain canonical"
+        )
+    live_diagnostics_period_sec = float(
+        getattr(arguments, "live_diagnostics_period_sec", 0.0)
+    )
+    if (
+        not math.isfinite(live_diagnostics_period_sec)
+        or live_diagnostics_period_sec < 0.0
+        or 0.0 < live_diagnostics_period_sec < 0.1
+        or live_diagnostics_period_sec > 60.0
+    ):
+        raise ValueError(
+            "--live-diagnostics-period-sec must be zero or within [0.1, 60]"
+        )
+    stream_console = bool(getattr(arguments, "stream_console", False))
+    target = list(arguments.target)
+    if target and target[0] == "--":
+        target.pop(0)
+    if not target:
+        raise ValueError("a target command is required after --")
+    heartbeat_aliases = resolve_operational_heartbeat_aliases(
+        operational_config,
+        metadata_input,
+    )
+    rotation_prestart_aliases = []
+    if arguments.mode == "physical":
+        rotation_prestart_aliases = list(
+            operational_config.get(
+                "rotation_prestart_heartbeat_aliases",
+                (),
+            )
+        )
+    subscribed_heartbeat_aliases = list(dict.fromkeys([
+        *heartbeat_aliases,
+        *rotation_prestart_aliases,
+    ]))
+    entries = require_operational_topics(
+        entries,
+        subscribed_heartbeat_aliases,
+    )
+    entries_by_alias = {entry['alias']: entry for entry in entries}
+    heartbeat_entries = [
+        entries_by_alias[alias]
+        for alias in subscribed_heartbeat_aliases
+    ]
+    initial_heartbeat_aliases = list(heartbeat_aliases)
+    if arguments.mode == "physical" and not stationary_preflight:
+        initial_heartbeat_aliases = list(rotation_prestart_aliases)
+    diagnostic_entries = select_live_diagnostic_entries(
+        entries_by_alias,
+        live_diagnostics_period_sec,
+    )
+    required_node_parameters = dict(
+        operational_config.get('required_node_parameters', {})
+    )
+    if operational_config:
+        operational_config['resolved_heartbeat_aliases'] = heartbeat_aliases
+        if arguments.mode == "physical":
+            operational_config['resolved_rotation_prestart_aliases'] = (
+                list(rotation_prestart_aliases)
+            )
+        operational_config['target_disturbance_coupling'] = (
+            validate_operational_target_coupling(
+                operational_config,
+                metadata_input,
+                target,
+            )
+        )
+    if arguments.storage_id != manifest.get('storage_id', 'sqlite3'):
+        raise ValueError('requested storage backend is not allowed by the manifest')
+    if arguments.storage_id not in rosbag2_py.get_registered_writers():
+        raise ValueError(f'rosbag writer is unavailable: {arguments.storage_id}')
+    qos_overrides = _default_asset("qos_overrides.yaml")
+    evidence_specifications = list(
+        getattr(arguments, "evidence_file", ())
+    )
+    required_evidence_labels = ()
+    if arguments.mode == "physical":
+        required_evidence_labels = PHYSICAL_REQUIRED_EVIDENCE_LABELS
+        evidence_specifications = [
+            f"metadata={arguments.metadata_input}",
+            f"topic_manifest={arguments.manifest}",
+            f"qos_overrides={qos_overrides}",
+            *evidence_specifications,
+        ]
+    resolved_evidence_files = resolve_evidence_files(
+        evidence_specifications,
+        required_evidence_labels,
+    )
+    if arguments.mode == "physical":
+        validate_physical_evidence_coupling(
+            resolved_evidence_files,
+            arguments.metadata_input,
+            metadata_input,
+            target,
+            stationary_preflight=stationary_preflight,
+        )
+    run_id = validate_run_id(
+        arguments.run_id or generate_run_id(arguments.mode, metadata_input["scenario_id"])
+    )
+    now = _utc_now()
+    run_directory = (
+        Path(arguments.runs_root).expanduser().resolve()
+        / now.strftime("%Y-%m-%d") / run_id
+    )
+    if run_directory.exists():
+        raise FileExistsError(f"run directory already exists: {run_directory}")
+    run_directory.mkdir(parents=True)
+    bag_directory = run_directory / "bag"
+    (run_directory / "notes.md").write_text(
+        f"# Run notes: {run_id}\n\n{metadata_input['operator_notes']}\n",
+        encoding="utf-8",
+    )
+    configuration_evidence = None
+    if resolved_evidence_files:
+        configuration_evidence = capture_evidence_files(
+            run_directory,
+            resolved_evidence_files,
+            required_evidence_labels,
+        )
+
+    metadata = dict(metadata_input)
+    metadata.update({
+        "schema_version": 1,
+        "run_id": run_id,
+        "created_at_utc": now.isoformat().replace("+00:00", "Z"),
+        "target_argv": target,
+        "working_directory": str(Path.cwd()),
+        "host": socket.gethostname(),
+        "ros_distribution": os.environ.get("ROS_DISTRO", "unknown"),
+        "rmw_implementation": os.environ.get("RMW_IMPLEMENTATION", "default"),
+        "git": git_state(Path.cwd()),
+        "recording": {
+            "storage_id": arguments.storage_id,
+            "status": "initializing",
+            'infrastructure_status': 'initializing',
+            'failure_stage': None,
+            'preflight_passed': False,
+            'initial_barrier_passed': False,
+            'initial_operational_readiness_passed': (
+                False if operational_config else None
+            ),
+            'operational_readiness_passed': (
+                False if operational_config else None
+            ),
+            'operational_readiness_required': bool(operational_config),
+            'readiness_ever_true': False,
+            'stationary_preflight': stationary_preflight,
+            'stationary_preflight_passed': False,
+            'rotation_authorization_ever_true': False,
+            'rotation_authorized_at_utc': None,
+            'stationary_hold_start_ros_ns': None,
+            'stationary_hold_end_ros_ns': None,
+            "stream_console": stream_console,
