+def _install_fake_offline_validator(monkeypatch, validator):
+    ros_esc_module = types.ModuleType("ros_esc")
+    ros_esc_module.__path__ = []
+    recording_module = types.ModuleType("ros_esc.experiment_recording")
+    recording_module.__path__ = []
+    validate_module = types.ModuleType(
+        "ros_esc.experiment_recording.validate_run"
+    )
+    validate_module.validate_run_directory = validator
+    ros_esc_module.experiment_recording = recording_module
+    recording_module.validate_run = validate_module
+    monkeypatch.setitem(sys.modules, "ros_esc", ros_esc_module)
+    monkeypatch.setitem(
+        sys.modules,
+        "ros_esc.experiment_recording",
+        recording_module,
+    )
+    monkeypatch.setitem(
+        sys.modules,
+        "ros_esc.experiment_recording.validate_run",
+        validate_module,
+    )
