+#!/usr/bin/env python3
+
+"""Publish identity-bearing Phase 09 Vicon evaluation evidence."""
+
+import argparse
+from dataclasses import dataclass
+import ipaddress
+import json
+import math
+import secrets
+import socket
+import sys
+import time
+
+from geometry_msgs.msg import PoseStamped
+import rclpy
+from rclpy.node import Node
+from rclpy.utilities import remove_ros_args
+from std_msgs.msg import String
+
+
+PROTOCOL_MAGIC = "DSIM_PHASE09_VICON"
+PROTOCOL_VERSION = 1
+CANONICAL_VICON_TOPIC = "/gesc_gaussian/evaluation/vicon_pose"
+CANONICAL_VICON_STATUS_TOPIC = "/gesc_gaussian/evaluation/vicon_status"
+CANONICAL_VICON_FRAME = "vicon_world"
+DEFAULT_VICON_SERVER_IP = "192.168.1.6"
+DEFAULT_VICON_SERVER_PORT = 12346
+_SHA256_LENGTH = 64
+
+
+@dataclass(frozen=True)
+class ViconEvaluationFrame:
+    """One strictly validated and advancing Vicon evaluation frame."""
+
+    position_m: tuple[float, float, float]
+    quaternion_xyzw: tuple[float, float, float, float]
+    server_session: str
+    sequence: int
+    tracker_frame: int
+    server_time_unix_ns: int
+    subject_name: str
+    segment_name: str
+    translation_occluded: bool
+    rotation_occluded: bool
+    server_script_sha256: str
+
+
+def _strict_object_pairs(pairs):
+    document = {}
+    for key, value in pairs:
+        if key in document:
+            raise ValueError(f"duplicate JSON key: {key}")
+        document[key] = value
+    return document
+
+
+def _strict_json(data):
+    if not isinstance(data, (bytes, bytearray, memoryview)):
+        raise ValueError("Vicon datagram must be bytes")
+    try:
+        decoded = bytes(data).decode("utf-8", errors="strict")
+        document = json.loads(
+            decoded,
+            object_pairs_hook=_strict_object_pairs,
+            parse_constant=lambda value: (_ for _ in ()).throw(
+                ValueError(f"nonfinite JSON number: {value}")
+            ),
+        )
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise ValueError(f"invalid Vicon JSON: {exc}") from exc
+    if not isinstance(document, dict):
+        raise ValueError("Vicon datagram must contain a JSON object")
+    return document
+
+
+def _lower_hex(value, length, label):
+    # MBuck 2026-08-01: Identity fields are exact wire types; never make a
+    # numeric/bool value look commissioned by coercing it to text.
+    if not isinstance(value, str):
+        raise ValueError(f"{label} must be an explicit string")
+    if len(value) != length or any(
+        char not in "0123456789abcdef" for char in value
+    ):
+        raise ValueError(f"{label} must be {length} lowercase hex digits")
+    return value
+
+
+def _normalized_name(value, label):
+    if not isinstance(value, str) or value != value.strip():
+        raise ValueError(f"{label} must be an explicit normalized string")
+    if not value or len(value) > 128 or any(ord(char) < 32 for char in value):
+        raise ValueError(f"{label} must be a nonempty printable name")
+    return value
+
+
+def encode_vicon_handshake(client_nonce, subject_name, segment_name):
+    """Create the exact Phase 09 identity handshake."""
+
+    document = {
+        "magic": PROTOCOL_MAGIC,
+        "version": PROTOCOL_VERSION,
+        "kind": "hello",
+        "client_nonce": _lower_hex(client_nonce, 32, "client_nonce"),
+        "subject_name": _normalized_name(subject_name, "subject_name"),
+        "segment_name": _normalized_name(segment_name, "segment_name"),
+    }
+    return json.dumps(
+        document,
+        allow_nan=False,
+        separators=(",", ":"),
+        sort_keys=True,
+    ).encode("utf-8")
+
+
+def decode_vicon_datagram(
+    data,
+    *,
+    expected_nonce,
+    expected_subject,
+    expected_segment,
+    expected_server_script_sha256,
+    previous_session=None,
+    previous_sequence=None,
+    previous_tracker_frame=None,
+):
+    """Decode one exact Phase 09 frame and enforce identity/progression."""
+
+    document = _strict_json(data)
+    expected_keys = {
+        "magic",
+        "version",
+        "kind",
+        "client_nonce",
+        "server_session",
+        "sequence",
+        "tracker_frame",
+        "server_time_unix_ns",
+        "subject_name",
+        "segment_name",
+        "translation_mm",
+        "quaternion_xyzw",
+        "translation_occluded",
+        "rotation_occluded",
+        "valid",
+        "server_script_sha256",
+    }
+    if set(document) != expected_keys:
+        raise ValueError("Vicon frame fields do not match protocol version 1")
+    if type(document["version"]) is not int:
+        raise ValueError("Vicon frame version must be an exact integer")
+    exact = {
+        "magic": PROTOCOL_MAGIC,
+        "version": PROTOCOL_VERSION,
+        "kind": "frame",
+        "client_nonce": _lower_hex(expected_nonce, 32, "expected nonce"),
+        "subject_name": _normalized_name(expected_subject, "expected subject"),
+        "segment_name": _normalized_name(expected_segment, "expected segment"),
+        "server_script_sha256": _lower_hex(
+            expected_server_script_sha256,
+            _SHA256_LENGTH,
+            "expected server script SHA-256",
+        ),
+    }
+    for key, value in exact.items():
+        if document.get(key) != value:
+            raise ValueError(f"Vicon frame {key} does not match commissioned value")
+    session = _lower_hex(document.get("server_session"), 32, "server_session")
+    if previous_session is not None and session != previous_session:
+        raise ValueError("Vicon server session changed during one client run")
+
+    integer_values = {
+        "sequence": document["sequence"],
+        "tracker_frame": document["tracker_frame"],
+        "server_time_unix_ns": document["server_time_unix_ns"],
+    }
+    if any(type(value) is not int for value in integer_values.values()):
+        raise ValueError("Vicon sequence/frame/time must be exact integers")
+    sequence = integer_values["sequence"]
+    tracker_frame = integer_values["tracker_frame"]
+    server_time = integer_values["server_time_unix_ns"]
+    if sequence <= 0 or tracker_frame <= 0 or server_time <= 0:
+        raise ValueError("Vicon sequence/frame/time must be positive")
+    if previous_sequence is not None and sequence <= previous_sequence:
+        raise ValueError("Vicon packet sequence did not advance")
+    if previous_tracker_frame is not None and tracker_frame <= previous_tracker_frame:
+        raise ValueError("Vicon Tracker frame did not advance")
+
+    translation_occluded = document["translation_occluded"]
+    rotation_occluded = document["rotation_occluded"]
+    valid = document["valid"]
+    if not all(
+        isinstance(value, bool)
+        for value in (translation_occluded, rotation_occluded, valid)
+    ):
+        raise ValueError("Vicon validity and occlusion fields must be booleans")
+    if translation_occluded or rotation_occluded or not valid:
+        raise ValueError("Vicon subject/segment is occluded or invalid")
+
+    translation = document["translation_mm"]
+    quaternion = document["quaternion_xyzw"]
+    if not isinstance(translation, list) or len(translation) != 3:
+        raise ValueError("Vicon translation_mm must contain xyz")
+    if not isinstance(quaternion, list) or len(quaternion) != 4:
+        raise ValueError("Vicon quaternion_xyzw must contain xyzw")
+    if any(type(value) not in (int, float) for value in (*translation, *quaternion)):
+        raise ValueError("Vicon pose values must be exact JSON numbers")
+    translation = tuple(float(value) for value in translation)
+    quaternion = tuple(float(value) for value in quaternion)
+    if not all(math.isfinite(value) for value in (*translation, *quaternion)):
+        raise ValueError("Vicon pose values must be finite")
+    position_m = tuple(value / 1000.0 for value in translation)
+    if any(abs(value) > 100.0 for value in position_m):
+        raise ValueError("Vicon position is outside the reviewed evidence range")
+    quaternion_norm = math.sqrt(sum(value * value for value in quaternion))
+    if not math.isfinite(quaternion_norm) or quaternion_norm <= 1e-9:
+        raise ValueError("Vicon quaternion must be finite and nonzero")
+    normalized = tuple(value / quaternion_norm for value in quaternion)
+    return ViconEvaluationFrame(
+        position_m=position_m,
+        quaternion_xyzw=normalized,
+        server_session=session,
+        sequence=sequence,
+        tracker_frame=tracker_frame,
+        server_time_unix_ns=server_time,
+        subject_name=str(document["subject_name"]),
+        segment_name=str(document["segment_name"]),
+        translation_occluded=translation_occluded,
+        rotation_occluded=rotation_occluded,
+        server_script_sha256=str(document["server_script_sha256"]),
+    )
+
+
+def parse_vicon_evidence_arguments(arguments=None):
+    """Parse selected-only evidence options; no option can publish `/odom`."""
+
+    parser = argparse.ArgumentParser(
+        description="Publish Vicon ground truth for Phase 09 evaluation only."
+    )
+    parser.add_argument("--server-ip", default=DEFAULT_VICON_SERVER_IP)
+    parser.add_argument("--server-port", type=int, default=DEFAULT_VICON_SERVER_PORT)
+    parser.add_argument("--subject-name", required=True)
+    parser.add_argument("--segment-name", required=True)
+    parser.add_argument("--server-script-sha256", required=True)
+    parser.add_argument("--output-topic", default=CANONICAL_VICON_TOPIC)
+    parser.add_argument("--status-topic", default=CANONICAL_VICON_STATUS_TOPIC)
+    parser.add_argument("--frame-id", default=CANONICAL_VICON_FRAME)
+    parser.add_argument("--poll-period-sec", type=float, default=0.01)
+    parser.add_argument("--stale-sec", type=float, default=0.50)
+    parsed = parser.parse_args(arguments)
+    try:
+        ipaddress.ip_address(parsed.server_ip)
+    except ValueError as exc:
+        parser.error(f"--server-ip must be a numeric IP address: {exc}")
+    if not 1 <= parsed.server_port <= 65535:
+        parser.error("--server-port must be between 1 and 65535")
+    if parsed.output_topic != CANONICAL_VICON_TOPIC:
+        parser.error("--output-topic must remain the canonical evaluation topic")
+    if parsed.status_topic != CANONICAL_VICON_STATUS_TOPIC:
+        parser.error("--status-topic must remain the canonical evaluation status")
+    if parsed.frame_id != CANONICAL_VICON_FRAME:
+        parser.error("--frame-id must remain the canonical Vicon frame")
+    for value, label in (
+        (parsed.subject_name, "--subject-name"),
+        (parsed.segment_name, "--segment-name"),
+    ):
+        try:
+            _normalized_name(value, label)
+        except ValueError as exc:
+            parser.error(str(exc))
+    try:
+        _lower_hex(parsed.server_script_sha256, 64, "server script SHA-256")
+    except ValueError as exc:
+        parser.error(str(exc))
+    if not math.isfinite(parsed.poll_period_sec) or not (
+        0.001 <= parsed.poll_period_sec <= 0.5
+    ):
+        parser.error("--poll-period-sec must be within [0.001, 0.5]")
+    if not math.isfinite(parsed.stale_sec) or not 0.1 <= parsed.stale_sec <= 2.0:
+        parser.error("--stale-sec must be within [0.1, 2.0]")
+    return parsed
+
+
+class ViconUdpReceiver:
+    """Nonblocking versioned UDP owner with bounded handshake retries."""
+
+    def __init__(
+        self,
+        server_ip,
+        server_port,
+        subject_name,
+        segment_name,
+        server_script_sha256,
+        socket_factory=socket.socket,
+        nonce=None,
+        handshake_period_sec=1.0,
+    ):
+        self.server_endpoint = (str(server_ip), int(server_port))
+        self.subject_name = _normalized_name(subject_name, "subject_name")
+        self.segment_name = _normalized_name(segment_name, "segment_name")
+        self.server_script_sha256 = str(server_script_sha256)
+        self.client_nonce = secrets.token_hex(16) if nonce is None else str(nonce)
+        self.handshake_period_sec = float(handshake_period_sec)
+        self.socket = socket_factory(socket.AF_INET, socket.SOCK_DGRAM)
+        self.closed = False
+        self.server_session = None
+        self.sequence = None
+        self.tracker_frame = None
+        self.last_valid_at = None
+        self.last_handshake_at = None
+        self.socket.connect(self.server_endpoint)
+        self.socket.setblocking(False)
+        self.send_handshake(force=True)
+
+    def send_handshake(self, force=False):
+        """Send a bounded retry handshake while no valid frame is arriving."""
+
+        if self.closed:
+            return False
+        now = time.monotonic()
+        if (
+            not force
+            and self.last_valid_at is not None
+            and now - self.last_valid_at < self.handshake_period_sec
+        ):
+            return False
+        if not force and self.last_handshake_at is not None and (
+            now - self.last_handshake_at < self.handshake_period_sec
+        ):
+            return False
+        payload = encode_vicon_handshake(
+            self.client_nonce,
+            self.subject_name,
+            self.segment_name,
+        )
+        self.socket.send(payload)
+        self.last_handshake_at = now
+        return True
+
+    def receive(self):
+        """Return one advancing frame or ``None`` when no datagram is waiting."""
+
+        if self.closed:
+            return None
+        try:
+            data = self.socket.recv(65535)
+        except BlockingIOError:
+            self.send_handshake()
+            return None
+        frame = decode_vicon_datagram(
+            data,
+            expected_nonce=self.client_nonce,
+            expected_subject=self.subject_name,
+            expected_segment=self.segment_name,
+            expected_server_script_sha256=self.server_script_sha256,
+            previous_session=self.server_session,
+            previous_sequence=self.sequence,
+            previous_tracker_frame=self.tracker_frame,
+        )
+        self.server_session = frame.server_session
+        self.sequence = frame.sequence
+        self.tracker_frame = frame.tracker_frame
+        self.last_valid_at = time.monotonic()
+        return frame
+
+    def close(self):
+        """Close idempotently; there is no receive thread to join."""
+
+        if self.closed:
+            return
+        self.closed = True
+        self.socket.close()
+
+
+class Phase09ViconEvidenceNode(Node):
+    """Publish Vicon pose/status without exposing either to control."""
+
+    def __init__(self, options, receiver_factory=ViconUdpReceiver):
+        super().__init__("phase09_vicon_evidence")
+        self.options = options
+        self.pose_publisher = self.create_publisher(
+            PoseStamped, options.output_topic, 10
+        )
+        self.status_publisher = self.create_publisher(String, options.status_topic, 10)
+        self.receiver = receiver_factory(
+            options.server_ip,
+            options.server_port,
+            options.subject_name,
+            options.segment_name,
+            options.server_script_sha256,
+        )
+        self.rejected_packets = 0
+        self.accepted_packets = 0
+        self.last_rejection = "awaiting advancing Phase 09 Vicon frame"
+        self.last_rejection_log = 0.0
+        self.timer = self.create_timer(options.poll_period_sec, self.poll_vicon)
+        self.get_logger().info(
+            "Phase 09 Vicon evaluation client configured for "
+            f"{options.subject_name}/{options.segment_name} at "
+            f"{options.server_ip}:{options.server_port}"
+        )
+
+    def _publish_status(self, frame=None, invalid_reason=None):
+        now = time.monotonic()
+        last_valid = getattr(self.receiver, "last_valid_at", None)
+        age = None if last_valid is None else max(0.0, now - last_valid)
+        valid = (
+            invalid_reason is None
+            and age is not None
+            and age <= self.options.stale_sec
+        )
+        document = {
+            "schema_version": 1,
+            "protocol_magic": PROTOCOL_MAGIC,
+            "protocol_version": PROTOCOL_VERSION,
+            "valid": valid,
+            "reason": "ok" if valid else str(
+                invalid_reason or self.last_rejection
+            ),
+            "subject_name": self.options.subject_name,
+            "segment_name": self.options.segment_name,
+            "server_script_sha256": self.options.server_script_sha256,
+            "server_session": getattr(self.receiver, "server_session", None),
+            "sequence": getattr(self.receiver, "sequence", None),
+            "tracker_frame": getattr(self.receiver, "tracker_frame", None),
+            "translation_occluded": False if valid else None,
+            "rotation_occluded": False if valid else None,
+            "last_valid_age_sec": age,
+            "accepted_packets": self.accepted_packets,
+            "rejected_packets": self.rejected_packets,
+        }
+        message = String()
+        message.data = json.dumps(
+            document, allow_nan=False, separators=(",", ":"), sort_keys=True
+        )
+        self.status_publisher.publish(message)
+
+    def poll_vicon(self):
+        """Drain a bounded batch, publishing only advancing valid poses."""
+
+        last_frame = None
+        for _ in range(32):
+            try:
+                frame = self.receiver.receive()
+            except (ValueError, OSError) as exc:
+                self.rejected_packets += 1
+                self.last_rejection = str(exc)
+                now = time.monotonic()
+                if now - self.last_rejection_log >= 2.0:
+                    self.get_logger().warning(
+                        "Rejected Vicon evaluation packet "
+                        f"(total={self.rejected_packets}): {exc}"
+                    )
+                    self.last_rejection_log = now
+                # MBuck 2026-08-01: An occluded/malformed frame is retained as
+                # an immediate invalid heartbeat; it cannot hide inside the
+                # stale allowance inherited from the preceding valid frame.
+                self._publish_status(invalid_reason=self.last_rejection)
+                continue
+            if frame is None:
+                break
+            self.accepted_packets += 1
+            self.last_rejection = "ok"
+            last_frame = frame
+            stamp = self.get_clock().now().to_msg()
+            message = PoseStamped()
+            message.header.stamp = stamp
+            message.header.frame_id = self.options.frame_id
+            message.pose.position.x = frame.position_m[0]
+            message.pose.position.y = frame.position_m[1]
+            message.pose.position.z = frame.position_m[2]
+            message.pose.orientation.x = frame.quaternion_xyzw[0]
+            message.pose.orientation.y = frame.quaternion_xyzw[1]
+            message.pose.orientation.z = frame.quaternion_xyzw[2]
+            message.pose.orientation.w = frame.quaternion_xyzw[3]
+            self.pose_publisher.publish(message)
+        if last_frame is None:
+            last_valid = getattr(self.receiver, "last_valid_at", None)
+            if last_valid is None or time.monotonic() - last_valid > self.options.stale_sec:
+                self.last_rejection = "Vicon frame stream is stale"
+                self._publish_status()
+        else:
+            self._publish_status(last_frame)
+
+    def close(self):
+        """Stop polling and close the selected-only UDP client."""
+
+        if getattr(self, "timer", None) is not None:
+            self.timer.cancel()
+        if getattr(self, "receiver", None) is not None:
+            self.receiver.close()
+
+    def destroy_node(self):
+        self.close()
+        return super().destroy_node()
+
+
+def main(args=None):
+    """Run the Phase 09-only Vicon evidence node."""
+
+    process_arguments = sys.argv if args is None else [sys.argv[0], *args]
+    options = parse_vicon_evidence_arguments(
+        remove_ros_args(args=process_arguments)[1:]
+    )
+    rclpy.init(args=args)
+    node = Phase09ViconEvidenceNode(options)
+    try:
+        rclpy.spin(node)
+    except KeyboardInterrupt:
+        pass
+    finally:
+        node.destroy_node()
+        rclpy.try_shutdown()
+
+
+if __name__ == "__main__":
+    main()
