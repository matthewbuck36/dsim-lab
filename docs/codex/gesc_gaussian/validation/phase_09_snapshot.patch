+def parse_vicon_status_message(message):
+    """Return one strict canonical Vicon status document or raise."""
+
+    if message is None or not isinstance(getattr(message, 'data', None), str):
+        raise ValueError('Vicon status must be std_msgs/String JSON')
+    duplicates = []
+
+    def pairs_hook(pairs):
+        document = {}
+        for key, value in pairs:
+            if key in document:
+                duplicates.append(key)
+            document[key] = value
+        return document
+
+    try:
+        document = json.loads(
+            message.data,
+            object_pairs_hook=pairs_hook,
+            parse_constant=lambda value: (_ for _ in ()).throw(
+                ValueError(f'nonfinite JSON number: {value}')
+            ),
+        )
+    except (json.JSONDecodeError, ValueError) as exc:
+        raise ValueError(f'Vicon status JSON is invalid: {exc}') from exc
+    expected_keys = {
+        'schema_version',
+        'protocol_magic',
+        'protocol_version',
+        'valid',
+        'reason',
+        'subject_name',
+        'segment_name',
+        'server_script_sha256',
+        'server_session',
+        'sequence',
+        'tracker_frame',
+        'translation_occluded',
+        'rotation_occluded',
+        'last_valid_age_sec',
+        'accepted_packets',
+        'rejected_packets',
+    }
+    if duplicates or not isinstance(document, dict) or set(document) != expected_keys:
+        raise ValueError('Vicon status fields are invalid')
+    return document
+
+
+def vicon_status_error(
+    message,
+    expected_subject_name=None,
+    expected_segment_name=None,
+    expected_server_script_sha256=None,
+):
+    """Return why one status is unusable as advancing evaluation evidence."""
+
+    try:
+        status = parse_vicon_status_message(message)
+        integer_fields = {
+            name: status[name]
+            for name in (
+                'sequence',
+                'tracker_frame',
+                'accepted_packets',
+                'rejected_packets',
+            )
+        }
+        if any(type(value) is not int for value in integer_fields.values()):
+            raise ValueError('Vicon status counters must be exact integers')
+        if type(status['last_valid_age_sec']) not in (int, float):
+            raise ValueError('Vicon status age must be an exact number')
+        age = float(status['last_valid_age_sec'])
+        sequence = integer_fields['sequence']
+        tracker_frame = integer_fields['tracker_frame']
+        accepted = integer_fields['accepted_packets']
+        rejected = integer_fields['rejected_packets']
+    except (TypeError, ValueError, KeyError) as exc:
+        return f'operational Vicon status heartbeat is invalid: {exc}'
+    valid = bool(
+        type(status['schema_version']) is int
+        and status['schema_version'] == 1
+        and status['protocol_magic'] == 'DSIM_PHASE09_VICON'
+        and type(status['protocol_version']) is int
+        and status['protocol_version'] == 1
+        and status['valid'] is True
+        and status['reason'] == 'ok'
+        and isinstance(status['subject_name'], str)
+        and status['subject_name']
+        and status['subject_name'] == status['subject_name'].strip()
+        and isinstance(status['segment_name'], str)
+        and status['segment_name']
+        and status['segment_name'] == status['segment_name'].strip()
+        and isinstance(status['server_script_sha256'], str)
+        and re.fullmatch(r'[0-9a-f]{64}', status['server_script_sha256'])
+        and isinstance(status['server_session'], str)
+        and re.fullmatch(r'[0-9a-f]{32}', status['server_session'])
+        and (
+            expected_subject_name is None
+            or status['subject_name'] == expected_subject_name
+        )
+        and (
+            expected_segment_name is None
+            or status['segment_name'] == expected_segment_name
+        )
+        and (
+            expected_server_script_sha256 is None
+            or status['server_script_sha256']
+            == expected_server_script_sha256
+        )
+        and sequence > 0
+        and tracker_frame > 0
+        and status['translation_occluded'] is False
+        and status['rotation_occluded'] is False
+        and math.isfinite(age)
+        and 0.0 <= age <= OPERATIONAL_HEARTBEAT_STALE_SEC
+        and accepted > 0
+        and rejected >= 0
+    )
+    return None if valid else 'operational Vicon status heartbeat is invalid'
+
