+def _reviewed_person(value, label):
+    name = str(value).strip()
+    if not name or name.upper() in {"UNASSIGNED", "TBD"}:
+        raise ValueError(f"{label} must identify an assigned person")
+    if "\n" in name or "\r" in name or len(name) > 128:
+        raise ValueError(f"{label} is invalid")
+    return name
+
+
+def create_phase09_run_metadata(
+    template_path,
+    output_path,
+    operator,
+    observer,
+    *,
+    confirmed_at_utc=None,
+):
+    """Create the only allowed transient authorization delta for one run."""
+
+    template = _load_yaml_mapping(template_path, "Phase 09 metadata template")
+    if Path(template_path).resolve() == Path(output_path).resolve():
+        raise ValueError("runtime metadata output must not overwrite its template")
+    readiness = template.get("physical_readiness")
+    if not isinstance(readiness, dict):
+        raise ValueError("Phase 09 metadata physical_readiness must be a mapping")
+    dirty_run_fields = [
+        name
+        for name in _PHASE09_RUN_READINESS_FIELDS
+        if readiness.get(name) is not False
+    ]
+    if (
+        dirty_run_fields
+        or "run_attestation" in template
+        or "stationary_preflight_attestation" in template
+    ):
+        raise ValueError(
+            "Phase 09 template contains persisted run authorization: "
+            + ", ".join(dirty_run_fields or ["run_attestation"])
+        )
+
+    operator_name = _reviewed_person(operator, "operator")
+    observer_name = _reviewed_person(observer, "observer")
+    confirmed = (
+        str(confirmed_at_utc).strip()
+        if confirmed_at_utc is not None
+        else dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z")
+    )
+    if not _utc_timestamp_valid(confirmed):
+        raise ValueError("confirmation requires a UTC timestamp")
+
+    # MBuck 2026-08-01: Never mutate the commissioned template. Only these
+    # named per-run attestations become true in a temporary metadata copy.
+    runtime = copy.deepcopy(template)
+    runtime["operator"] = operator_name
+    runtime["observer"] = observer_name
+    for name in _PHASE09_RUN_READINESS_FIELDS:
+        runtime["physical_readiness"][name] = True
+    runtime["run_attestation"] = {
+        "schema_version": 1,
+        "confirmed_at_utc": confirmed,
+        "operator": operator_name,
+        "observer": observer_name,
+        "confirmation": "RUN",
+        "clear_open_floor": True,
+        "independent_emergency_stop_ready": True,
+        "vicon_server_ready": True,
+    }
+    output = Path(output_path)
+    output.write_text(
+        yaml.safe_dump(runtime, sort_keys=False),
+        encoding="utf-8",
+    )
+    return runtime
+
+
+def create_phase09_stationary_preflight_metadata(
+    template_path,
+    output_path,
+    operator,
+    observer,
+    *,
+    confirmed_at_utc=None,
+):
+    """Create a temporary PREFLIGHT copy with every readiness flag false."""
+
+    template_path = Path(template_path).resolve()
+    output_path = Path(output_path).resolve()
+    if template_path == output_path:
+        raise ValueError("preflight metadata output must not overwrite its template")
+    template = _load_yaml_mapping(template_path, "Phase 09 metadata template")
+    readiness = template.get("physical_readiness")
+    if not isinstance(readiness, dict):
+        raise ValueError("Phase 09 metadata physical_readiness must be a mapping")
+    if readiness.get("stationary_graph_verified") is not False:
+        raise ValueError("stationary preflight requires its persistent gate false")
+    dirty_run_fields = [
+        name for name in _PHASE09_RUN_READINESS_FIELDS
+        if readiness.get(name) is not False
+    ]
+    if (
+        dirty_run_fields
+        or "run_attestation" in template
+        or "stationary_preflight_attestation" in template
+    ):
+        raise ValueError("Phase 09 template contains persisted run authorization")
+    operator_name = _reviewed_person(operator, "operator")
+    observer_name = _reviewed_person(observer, "observer")
+    confirmed = (
+        str(confirmed_at_utc).strip()
+        if confirmed_at_utc is not None
+        else dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z")
+    )
+    if not _utc_timestamp_valid(confirmed):
+        raise ValueError("preflight confirmation requires a UTC timestamp")
+
+    # MBuck 2026-08-01: This copy identifies the humans and no-actuation
+    # contract but deliberately leaves all five run-readiness booleans false.
+    runtime = copy.deepcopy(template)
+    runtime["operator"] = operator_name
+    runtime["observer"] = observer_name
+    runtime["stationary_preflight_attestation"] = {
+        "schema_version": 1,
+        "confirmed_at_utc": confirmed,
+        "operator": operator_name,
