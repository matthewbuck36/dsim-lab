+def wrap_angle(angle):
+    """Wrap a finite angle to [-pi, pi)."""
+
+    if not math.isfinite(angle):
+        raise ValueError("angle must be finite")
+    return (float(angle) + math.pi) % (2.0 * math.pi) - math.pi
