+    raw_sensor_value: float
+    raw_sensor_valid: bool
+    raw_cost: float
+    source_score: float
+    source_score_valid: bool
+    algorithm_state: int
+    algorithm_state_valid: bool
+
+
+@dataclass(frozen=True)
+class BasinSample:
+    """One immutable synchronized estimator sample."""
+
+    stamp_sec: float
+    x: float
+    y: float
+    yaw: float
+    raw_sensor_value: float
+    raw_sensor_valid: bool
+    raw_cost: float
+    source_score: float
+    source_score_valid: bool
