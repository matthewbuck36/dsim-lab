+    untracked = git_state(tmp_path)
+
+    assert clean["available"] is True
+    assert clean["dirty"] is False
+    assert dirty["dirty"] is True
+    assert untracked["untracked_paths"] == ["new.txt"]
+    assert len({
+        clean["diff_hash_sha256"],
