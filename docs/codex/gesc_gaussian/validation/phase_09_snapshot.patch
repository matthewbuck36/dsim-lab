+def test_required_parameter_checks_reject_missing_type_or_value():
+    required = {"/custom_controller": {"use_sim_time": False}}
+    assert required_node_parameter_errors(
+        {"/custom_controller": {"use_sim_time": False}},
+        required,
+    ) == []
+    assert required_node_parameter_errors({}, required)
+    assert required_node_parameter_errors(
+        {"/custom_controller": {"use_sim_time": 0}},
+        required,
+    )
+    assert required_node_parameter_errors(
+        {"/custom_controller": {"use_sim_time": True}},
+        required,
+    )
+
+
+@pytest.mark.parametrize("observed", (False, True))
+def test_parameter_service_enforcement_sets_and_verifies_false(monkeypatch, observed):
+    class FakeNode:
+        def create_client(self, _service_type, name):
+            return SimpleNamespace(srv_name=name)
+
+        def destroy_client(self, _client):
+            return None
+
+    def response(client, request, _deadline=None):
+        if client.srv_name.endswith("/set_parameters"):
+            values = [Parameter.from_parameter_msg(item).value for item in request.parameters]
+            assert values == [False]
+            return SimpleNamespace(
+                results=[SimpleNamespace(successful=True, reason="")]
+            )
+        return SimpleNamespace(
+            values=[Parameter(name="use_sim_time", value=observed).to_parameter_msg().value]
+        )
+
+    monkeypatch.setattr(recorder, "_wait_for_parameter_response", response)
+    evidence = enforce_required_node_parameters(
+        FakeNode(),
+        {"/custom_controller": {"use_sim_time": False}},
+    )
+    assert evidence["passed"] is (observed is False)
+    assert bool(evidence["errors"]) is (observed is True)
+
+
+def test_full_parameter_snapshot_rechecks_required_values():
+    required = {"/custom_controller": {"use_sim_time": False}}
+    snapshot = {
+        "nodes": {
+            "/custom_controller": {
+                "available": True,
+                "parameters": {
+                    "/custom_controller": {
+                        "ros__parameters": {"use_sim_time": False}
+                    }
+                },
+            }
+        }
+    }
+    assert required_parameter_snapshot_errors(snapshot, required) == []
+    snapshot["nodes"]["/custom_controller"]["parameters"][
+        "/custom_controller"
+    ]["ros__parameters"]["use_sim_time"] = True
+    assert required_parameter_snapshot_errors(snapshot, required)
