+def _launch():
+    root = ET.parse(LAUNCH_PATH).getroot()
+    args = {item.attrib["name"]: item.attrib.get("default") for item in root.findall("arg")}
+    executables = root.findall("executable")
+    return root, args, executables
+
+
+def _commands(executables):
+    return [item.attrib.get("cmd", "") for item in executables]
+
+
+def test_launch_defaults_are_legacy_compatible_and_motion_gated():
+    _, args, _ = _launch()
+    assert args["algorithm_profile"] == "legacy"
+    assert args["use_pde_extensions"] == "False"
+    assert args["enable_observability"] == "False"
+    assert args["observability_source_mode"] == "physical"
+    assert args["use_sim_time"] == "False"
+    assert args["supervisor_use_sim_time"] == "False"
+    assert args["recording_ready_required"] == "True"
+    assert args["known_source_count"] == "0"
+    assert args["extremum_classification_mode"] == "absolute_source_score"
+    assert args["gaussian_fill_max_fills"] == "1"
+    assert args["open_field_escape_interior_anchor_fallback_enabled"] == "False"
+    assert args["open_field_escape_interior_anchor_min_displacement_m"] == "0.50"
+    assert args["recenter_after_escape"] == "True"
+    assert args["operating_bounds_enabled"] == "True"
+    assert args["enable_vicon_evaluation"] == "False"
+    assert args["vicon_evaluation_topic"] == (
+        "/gesc_gaussian/evaluation/vicon_pose"
+    )
+    assert args["vicon_server_ip"] == "192.168.1.6"
+    assert args["vicon_server_port"] == "12346"
