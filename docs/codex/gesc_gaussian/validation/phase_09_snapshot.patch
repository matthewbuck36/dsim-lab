+@dataclass(frozen=True)
+class BasinEstimate:
+    """Complete robust basin estimate consumed by the fill designer."""
+
+    center: np.ndarray
+    weights: np.ndarray
+    sample_covariance: np.ndarray
+    quadratic: QuadraticFit
+    center_cost: float
+    shoulder_cost: float
+    depth: float
