+def test_each_bash_entry_point_has_valid_syntax_and_launch_arguments():
+    wrappers = sorted((PACKAGE_ROOT / "bash_scripts").rglob("*.bash"))
+    assert len(wrappers) == len(LEGACY_WRAPPER_SHA256) + 1
+    for wrapper in wrappers:
+        syntax = subprocess.run(
+            ["bash", "-n", str(wrapper)],
+            check=False,
+            capture_output=True,
+            text=True,
+            timeout=5,
+        )
+        assert syntax.returncode == 0, f"{wrapper}: {syntax.stderr}"
+
+        text = wrapper.read_text(encoding="utf-8")
+        matches = re.findall(
+            r"\bros2\s+launch\s+turtlebot3_vehicle_nodes\s+([^\s\\]+)",
+            text,
+        )
+        assert len(matches) == 1, wrapper
+        launch_name = matches[0]
+        launch_path = PACKAGE_ROOT / "launch" / launch_name
+        assert launch_path.is_file(), wrapper
+        root = ET.parse(launch_path).getroot()
+        declared = {
+            item.attrib["name"]: item.attrib.get("default")
+            for item in root.findall("arg")
+        }
+        supplied = set(re.findall(r"\b([A-Za-z_][A-Za-z0-9_]*):=", text))
+        unknown = supplied - set(declared)
+        if unknown:
+            # Inherited acoustic typo is behavior-neutral: every wrapper asks
+            # for True and the correctly named launch argument defaults True.
+            assert launch_name == "acoustic_esc_experiment.launch.xml", wrapper
+            assert unknown == {"input_encoder_data_to_filter"}, wrapper
