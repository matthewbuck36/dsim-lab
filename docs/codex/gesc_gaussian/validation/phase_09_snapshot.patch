+        "",
+        "2.0, 4000",
+        "voltage: 2.0, r: 4000",
+        "v: 2.0, r: 4000, extra: 1",
+        "v: nan, r: 4000",
+        "v: 2.0, r: inf",
+    ),
+)
+def test_parser_rejects_malformed_or_nonfinite_input(text):
+    with pytest.raises(ValueError):
+        parse_photoresistor_line(text)
+
