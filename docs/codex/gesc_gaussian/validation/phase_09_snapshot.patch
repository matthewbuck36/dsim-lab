+class _SpinProfile:
+    def __init__(self, speed_rad_sec=2.0 * math.pi / 3.0):
+        self.speed_rad_sec = speed_rad_sec
+        self.calls = []
+
+    def velocity_output(self, elapsed, angle, direction):
+        self.calls.append((elapsed, angle, direction))
+        return self.speed_rad_sec
+
+
+class _Command:
+    def __init__(self):
+        self.speeds = []
+        self.stop_count = 0
+
+    def set_speed(self, speed):
+        self.speeds.append(float(speed))
+
+    def stop(self):
+        self.stop_count += 1
+
+
+class _Pi:
+    def __init__(self):
+        self.stop_count = 0
+
+    def stop(self):
+        self.stop_count += 1
+
+
+def _machine(starting_angle_deg=0.0):
+    calls = []
+    pi_object = _Pi()
+    command = _Command()
+
+    def factory():
+        calls.append("factory")
+        return pi_object, command
+
+    published = []
+    machine = RotationStateMachine(
+        _SpinProfile(),
+        factory,
+        published.append,
+        starting_angle_deg=starting_angle_deg,
+        authorization_stale_sec=0.5,
+        settle_sec=10.0,
+    )
+    return machine, calls, pi_object, command, published
+
+
+def test_pre_authorization_tick_and_close_never_open_or_write_hardware():
+    machine, factory_calls, pi_object, command, published = _machine()
+
+    machine.tick(1.0, now=0.0, wall_now=100.0)
+    machine.update_authorization(False, observed_at=0.1)
+    machine.close()
+
+    assert factory_calls == []
+    assert command.speeds == []
+    assert command.stop_count == 0
+    assert pi_object.stop_count == 0
+    assert published == []
+    assert machine.state == machine.STOPPED
+
+
+def test_first_true_lazily_opens_once_and_repeated_true_does_not_restart():
+    machine, factory_calls, _, _, _ = _machine()
+
+    machine.update_authorization(True, observed_at=1.0)
+    machine.update_authorization(True, observed_at=1.1)
+
+    assert factory_calls == ["factory"]
+    assert machine.state == machine.ALIGNING
+    assert machine.ever_authorized is True
