+def test_uncalibrated_document_is_inert_and_has_no_score(tmp_path):
+    calibration = load_calibration(_write_calibration(tmp_path))
+    reading = parse_photoresistor_line("v: 2.75, r: 1234.5")
+    payload = build_voltage_payload(
+        reading,
+        calibration=calibration,
+        source_score_enabled=False,
+    )
+
+    assert calibration.status == "uncalibrated"
+    assert calibration.motion_ready is False
+    assert calibration.serial_device == ""
+    assert payload.raw_sensor_v == 2.75
+    assert payload.raw_cost_v == -2.75
+    assert payload.resistance_ohm == 1234.5
+    assert payload.source_score is None
