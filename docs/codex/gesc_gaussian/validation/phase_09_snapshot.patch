+#!/usr/bin/env python3
+
+"""Phase 09-only two-stage, recorder-gated physical sensor rotation."""
+
+import argparse
+import json
+import math
+from pathlib import Path
+import sys
+import time
+
+import rclpy
+from rclpy.node import Node
+from rclpy.utilities import remove_ros_args
+from ros_esc.config_parsing import parse_object_config
+from ros_esc_interfaces.msg import StampedFloat64MultiArray, Timekeeper
+from std_msgs.msg import Bool, Float64, String
+
+
+CANONICAL_ROTATION_AUTHORIZED_TOPIC = "/gesc_gaussian/rotation_authorized"
+CANONICAL_ROTATION_STATUS_TOPIC = "/gesc_gaussian/rotation_status"
+CANONICAL_ROTATION_COMMAND_TOPIC = "/gesc_gaussian/rotation_command_rpm"
+CANONICAL_ROTATION_AUTHORITY = "/gesc_gaussian_recording_coordinator"
+
+
+def _endpoint_name(endpoint):
+    namespace = str(endpoint.node_namespace).rstrip("/")
+    return (
+        f"{namespace}/{endpoint.node_name}"
+        if namespace
+        else f"/{endpoint.node_name}"
+    )
+
+
+def load_spin_profile(path):
+    """Load the single reviewed spin-profile object from a JSON config."""
+
+    document = json.loads(Path(path).expanduser().read_text(encoding="utf-8"))
+    if not isinstance(document, dict) or len(document) != 1:
+        raise ValueError("rotation configuration must contain exactly one profile")
+    profile = parse_object_config(next(iter(document.values())))
+    if not callable(getattr(profile, "velocity_output", None)):
+        raise ValueError("rotation profile must provide velocity_output")
+    return profile
+
+
+def _physical_hardware_factory():
+    """Lazily open GPIO only after recorder rotation authorization."""
+
+    import pigpio  # pylint: disable=import-outside-toplevel
+    from turtlebot3_vehicle_nodes.parallax_360_servo_communication import (
+        write_pwm,
+    )
+
+    pi_object = pigpio.pi()
+    try:
+        if hasattr(pi_object, "connected") and not pi_object.connected:
+            raise RuntimeError("pigpio daemon is unavailable")
+        return pi_object, write_pwm(pi_object, 18)
+    except Exception:
+        pi_object.stop()
+        raise
+
+
+class RotationStateMachine:
+    """Pure fail-closed rotation state machine with lazy hardware ownership."""
+
+    WAITING = "WAITING_AUTHORIZATION"
+    ALIGNING = "ALIGNING"
+    SETTLING = "SETTLING"
+    RUNNING = "RUNNING"
+    STOPPED = "STOPPED"
+    FAULT = "FAULT"
+
+    def __init__(
+        self,
+        spin_profile,
+        hardware_factory,
+        command_callback,
+        *,
+        starting_angle_deg=-90.0,
+        authorization_stale_sec=0.50,
+        encoder_stale_sec=0.50,
+        settle_sec=10.0,
+        monotonic_clock=time.monotonic,
+        wall_clock=time.time,
+    ):
+        self.spin_profile = spin_profile
+        self.hardware_factory = hardware_factory
+        self.command_callback = command_callback
+        self.starting_angle = math.radians(float(starting_angle_deg) % 360.0)
+        self.authorization_stale_sec = float(authorization_stale_sec)
+        self.encoder_stale_sec = float(encoder_stale_sec)
+        self.settle_sec = float(settle_sec)
+        if not 0.1 <= self.authorization_stale_sec <= 2.0:
+            raise ValueError("rotation authorization stale bound must be [0.1, 2.0]")
+        if not 0.1 <= self.encoder_stale_sec <= 2.0:
+            raise ValueError("rotation encoder stale bound must be [0.1, 2.0]")
+        if not 0.0 <= self.settle_sec <= 30.0:
+            raise ValueError("rotation settle time must be within [0, 30] seconds")
+        self.monotonic_clock = monotonic_clock
+        self.wall_clock = wall_clock
+        self.state = self.WAITING
+        self.pi_object = None
+        self.command = None
+        self.hardware_initialized = False
+        self.ever_authorized = False
+        self.authorization_active = False
+        self.last_authorization_at = None
+        self.spin_direction = None
+        self.settle_until = None
+        self.start_time = None
+        self.fault_reason = None
+        self.closed = False
+        self.last_command_rpm = None
+
+    def status(self):
+        """Return the bounded state used by the recorded status topic."""
+
+        return {
+            "schema_version": 1,
+            "state": self.state,
+            "authorization_active": self.authorization_active,
+            "ever_authorized": self.ever_authorized,
+            "hardware_initialized": self.hardware_initialized,
+            "timekeeper_started": self.start_time is not None,
+            "last_command_rpm": self.last_command_rpm,
+            "fault_reason": self.fault_reason,
+        }
+
+    def _write_speed(self, rpm):
+        value = float(rpm)
+        if not math.isfinite(value):
+            raise ValueError("rotation command must be finite")
+        self.command.set_speed(value)
+        self.last_command_rpm = value
+        self.command_callback(value)
+
+    def _stop_hardware(self):
+        if not self.hardware_initialized or self.command is None:
+            return
+        self.command.stop()
+        self.last_command_rpm = 0.0
+        self.command_callback(0.0)
+
+    def _fault(self, reason):
+        if self.state in {self.FAULT, self.STOPPED}:
+            return
+        self.fault_reason = str(reason)
+        self.authorization_active = False
+        self.state = self.FAULT
+        try:
+            self._stop_hardware()
+        except Exception as exc:  # Preserve the latch even if neutral fails.
+            self.fault_reason += f"; neutral command failed: {exc}"
+
+    def fault(self, reason):
+        """Publicly latch one fail-closed node or hardware fault."""
+
+        self._fault(reason)
+
+    def update_authorization(self, authorized, observed_at=None):
+        """Consume one recorder-owned gate heartbeat."""
+
+        now = self.monotonic_clock() if observed_at is None else float(observed_at)
+        if not bool(authorized):
+            if self.ever_authorized:
+                self._fault("rotation authorization was revoked")
+            return
+        if self.state in {self.FAULT, self.STOPPED}:
+            return
+        self.last_authorization_at = now
+        self.authorization_active = True
+        if self.ever_authorized:
+            return
+        try:
+            self.pi_object, self.command = self.hardware_factory()
+        except Exception as exc:
+            self._fault(f"rotation hardware initialization failed: {exc}")
+            return
+        self.hardware_initialized = True
+        self.ever_authorized = True
+        self.state = self.ALIGNING
+
+    def _authorization_fresh(self, now):
+        return bool(
+            self.authorization_active
+            and self.last_authorization_at is not None
+            and now - self.last_authorization_at <= self.authorization_stale_sec
+        )
+
+    def tick(
+        self,
+        angular_position_rad,
+        now=None,
+        wall_now=None,
+        encoder_observed_at=None,
+    ):
+        """Advance alignment, nonblocking settle, or configured full rotation."""
+
+        now = self.monotonic_clock() if now is None else float(now)
+        wall_now = self.wall_clock() if wall_now is None else float(wall_now)
+        if self.state in {self.WAITING, self.FAULT, self.STOPPED}:
+            return self.status()
+        if not self._authorization_fresh(now):
+            self._fault("rotation authorization heartbeat became stale")
+            return self.status()
+        if (
+            encoder_observed_at is None
+            or now - float(encoder_observed_at) > self.encoder_stale_sec
+        ):
+            self._fault("encoder heartbeat became stale")
+            return self.status()
+        if angular_position_rad is None or not math.isfinite(
+            float(angular_position_rad)
+        ):
+            self._fault("encoder angle is missing or nonfinite")
+            return self.status()
+        if self.state == self.ALIGNING:
+            angle = float(angular_position_rad)
+            current = angle % (2.0 * math.pi)
+            counterclockwise_error = (self.starting_angle - current) % (
+                2.0 * math.pi
+            )
+            clockwise_error = (current - self.starting_angle) % (2.0 * math.pi)
+            shortest_error = min(counterclockwise_error, clockwise_error)
+            if shortest_error <= math.radians(7.0):
+                self._stop_hardware()
+                self.settle_until = now + self.settle_sec
+                self.spin_direction = None
+                self.state = self.SETTLING
+                return self.status()
+            if self.spin_direction is None:
+                self.spin_direction = counterclockwise_error <= clockwise_error
+            self._write_speed(15.0 if self.spin_direction else -15.0)
+            return self.status()
+        if self.state == self.SETTLING:
+            if now >= self.settle_until:
+                self.start_time = wall_now
+                self.state = self.RUNNING
+            return self.status()
+        if self.state == self.RUNNING:
+            angle = float(angular_position_rad)
+            signed_angle = angle - 2.0 * math.pi if angle > math.pi else angle
+            elapsed = wall_now - self.start_time
+            speed_rad_sec = float(
+                self.spin_profile.velocity_output(
+                    elapsed,
+                    signed_angle,
+                    self.spin_direction,
+                )
+            )
+            speed_rpm = speed_rad_sec * 60.0 / (2.0 * math.pi)
+            self._write_speed(speed_rpm)
+            if speed_rpm > 0.0:
+                self.spin_direction = True
+            elif speed_rpm < 0.0:
+                self.spin_direction = False
+        return self.status()
+
+    def close(self):
+        """Release GPIO exactly once; preauthorization close performs no write."""
+
+        if self.closed:
+            return
+        self.closed = True
+        if self.hardware_initialized:
+            try:
+                self._stop_hardware()
+            except Exception as exc:
+                self.fault_reason = (
+                    f"{self.fault_reason}; " if self.fault_reason else ""
+                ) + f"shutdown neutral command failed: {exc}"
+                self.state = self.FAULT
+            finally:
+                try:
+                    self.pi_object.stop()
+                except Exception as exc:
+                    self.fault_reason = (
+                        f"{self.fault_reason}; " if self.fault_reason else ""
+                    ) + f"GPIO release failed: {exc}"
+                    self.state = self.FAULT
+        self.authorization_active = False
+        if self.state != self.FAULT:
+            self.state = self.STOPPED
+
+
+def parse_phase09_rotation_arguments(arguments=None):
+    """Parse the legacy positional shape plus selected-only gate arguments."""
+
+    parser = argparse.ArgumentParser(
+        description="Recorder-gated Phase 09 rotating photoresistor owner."
+    )
+    parser.add_argument("input_encoder_topic")
+    parser.add_argument("output_timekeeper_topic")
+    parser.add_argument("config")
+    parser.add_argument("--starting-position", type=float, default=-90.0)
+    parser.add_argument(
+        "--rotation-authorized-topic",
+        default=CANONICAL_ROTATION_AUTHORIZED_TOPIC,
+    )
+    parser.add_argument("--status-topic", default=CANONICAL_ROTATION_STATUS_TOPIC)
+    parser.add_argument(
+        "--command-topic",
+        default=CANONICAL_ROTATION_COMMAND_TOPIC,
+    )
+    parser.add_argument("--authorization-stale-sec", type=float, default=0.50)
+    parser.add_argument("--encoder-stale-sec", type=float, default=0.50)
+    parser.add_argument("--settle-sec", type=float, default=10.0)
+    parsed = parser.parse_args(arguments)
+    canonical = {
+        "rotation_authorized_topic": CANONICAL_ROTATION_AUTHORIZED_TOPIC,
+        "status_topic": CANONICAL_ROTATION_STATUS_TOPIC,
+        "command_topic": CANONICAL_ROTATION_COMMAND_TOPIC,
+    }
+    for name, expected in canonical.items():
+        if getattr(parsed, name) != expected:
+            parser.error(f"--{name.replace('_', '-')} must remain {expected}")
+    return parsed
+
+
+class Phase09RotationNode(Node):
+    """ROS owner for the Phase 09 two-stage rotating sensor mechanism."""
+
+    def __init__(self, options, hardware_factory=_physical_hardware_factory):
+        super().__init__("phase09_rotation")
+        self.options = options
+        self.angular_position = None
+        self.angular_position_observed_at = None
+        self.timekeeper_publisher = self.create_publisher(
+            Timekeeper, options.output_timekeeper_topic, 50
+        )
+        self.status_publisher = self.create_publisher(String, options.status_topic, 10)
+        self.command_publisher = self.create_publisher(
+            Float64, options.command_topic, 10
+        )
+        self.encoder_subscription = self.create_subscription(
+            StampedFloat64MultiArray,
+            options.input_encoder_topic,
+            self._encoder_callback,
+            10,
+        )
+        self.authorization_subscription = self.create_subscription(
+            Bool,
+            options.rotation_authorized_topic,
+            self._authorization_callback,
+            10,
+        )
+        self.machine = RotationStateMachine(
+            load_spin_profile(options.config),
+            hardware_factory,
+            self._publish_command,
+            starting_angle_deg=options.starting_position,
+            authorization_stale_sec=options.authorization_stale_sec,
+            encoder_stale_sec=options.encoder_stale_sec,
+            settle_sec=options.settle_sec,
+        )
+        self.timer = self.create_timer(0.05, self._tick)
+        self._publish_status()
+
+    def _encoder_callback(self, message):
+        if message.data:
+            self.angular_position = float(message.data[0])
+            self.angular_position_observed_at = time.monotonic()
+
+    def _authorization_callback(self, message):
+        if bool(message.data):
+            publishers = {
+                _endpoint_name(endpoint)
+                for endpoint in self.get_publishers_info_by_topic(
+                    self.options.rotation_authorized_topic
+                )
+            }
+            if publishers != {CANONICAL_ROTATION_AUTHORITY}:
+                self.machine.fault(
+                    "rotation authorization publisher is not the exact "
+                    f"recorder authority: {sorted(publishers)}"
+                )
+                self._publish_status()
+                return
+        self.machine.update_authorization(bool(message.data))
+
+    def _publish_command(self, rpm):
+        message = Float64()
+        message.data = float(rpm)
+        self.command_publisher.publish(message)
+
+    def _publish_status(self):
+        message = String()
+        message.data = json.dumps(
+            self.machine.status(),
+            allow_nan=False,
+            separators=(",", ":"),
+            sort_keys=True,
+        )
+        self.status_publisher.publish(message)
+
+    def _tick(self):
+        try:
+            self.machine.tick(
+                self.angular_position,
+                encoder_observed_at=self.angular_position_observed_at,
+            )
+        except Exception as exc:  # Hardware/profile failures must stop and latch.
+            self.machine.fault(f"rotation tick failed: {exc}")
+            self.get_logger().error(str(self.machine.fault_reason))
+        if self.machine.start_time is not None:
+            message = Timekeeper()
+            message.start_time = self.machine.start_time
+            message.mode = "real time"
+            self.timekeeper_publisher.publish(message)
+        self._publish_status()
+
+    def destroy_node(self):
+        self.machine.close()
+        self._publish_status()
+        return super().destroy_node()
+
+
+def main(args=None):
+    """Run the Phase 09 recorder-gated rotation owner."""
+
+    process_arguments = sys.argv if args is None else [sys.argv[0], *args]
+    options = parse_phase09_rotation_arguments(
+        remove_ros_args(args=process_arguments)[1:]
+    )
+    rclpy.init(args=args)
+    node = Phase09RotationNode(options)
+    try:
+        rclpy.spin(node)
+    except KeyboardInterrupt:
+        pass
+    finally:
+        node.destroy_node()
+        rclpy.try_shutdown()
+
+
+if __name__ == "__main__":
+    main()
