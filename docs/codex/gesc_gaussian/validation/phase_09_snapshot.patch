+def configuration_evidence_errors(run_directory, metadata):
+    """Return physical retained-input completeness and integrity faults."""
+
+    if metadata.get("mode") != "physical":
+        return []
+    evidence = metadata.get("configuration_evidence")
+    if not isinstance(evidence, dict):
+        return ["physical configuration_evidence metadata is missing"]
+    manifest_relative = evidence.get("manifest_path")
+    if not isinstance(manifest_relative, str) or not manifest_relative:
+        return ["physical configuration evidence manifest path is missing"]
+    run_directory = Path(run_directory).resolve()
+    try:
+        manifest_path = (run_directory / manifest_relative).resolve(strict=True)
+        manifest_path.relative_to(run_directory)
+    except (OSError, ValueError):
+        return ["physical configuration evidence manifest escapes or is missing"]
+    try:
+        manifest = _load_yaml(manifest_path)
+    except (OSError, yaml.YAMLError) as exc:
+        return [f"physical configuration evidence manifest unreadable: {exc}"]
+    if not isinstance(manifest, dict) or manifest.get("schema_version") != 1:
+        return ["physical configuration evidence manifest schema is invalid"]
+
+    errors = []
+    required = set(PHYSICAL_REQUIRED_EVIDENCE_LABELS)
+    metadata_required = evidence.get("required_labels")
+    if (
+        not isinstance(metadata_required, list)
+        or any(not isinstance(label, str) for label in metadata_required)
+        or set(metadata_required) != required
+    ):
+        errors.append(
+            "metadata physical configuration evidence required labels changed"
+        )
+    declared_required = manifest.get("required_labels")
+    if (
+        not isinstance(declared_required, list)
+        or any(not isinstance(label, str) for label in declared_required)
+        or set(declared_required) != required
+    ):
+        errors.append("physical configuration evidence required labels changed")
+    files = manifest.get("files")
+    if not isinstance(files, list):
+        return [*errors, "physical configuration evidence files are invalid"]
+    labels = []
+    retained_paths = []
+    for item in files:
+        if not isinstance(item, dict):
+            errors.append("physical configuration evidence entry is invalid")
+            continue
+        label = item.get("label")
+        retained_relative = item.get("retained_path")
+        if not isinstance(label, str):
+            errors.append("physical configuration evidence label is invalid")
+            continue
+        labels.append(label)
+        if not isinstance(retained_relative, str) or not retained_relative:
+            errors.append(f"physical evidence retained path is invalid: {label}")
+            continue
+        retained_paths.append(retained_relative)
+        try:
+            retained_path = (
+                run_directory / retained_relative
+            ).resolve(strict=True)
+            retained_path.relative_to(run_directory)
+        except (OSError, ValueError):
+            errors.append(
+                f"physical evidence retained path escapes or is missing: {label}"
+            )
+            continue
+        if not retained_path.is_file():
+            errors.append(f"physical evidence is not a regular file: {label}")
+            continue
+        if retained_path.stat().st_size != item.get("size_bytes"):
+            errors.append(f"physical evidence size mismatch: {label}")
+        try:
+            retained_hash = _retained_sha256(retained_path)
+        except OSError as exc:
+            errors.append(f"physical evidence unreadable: {label}: {exc}")
+            continue
+        if retained_hash != item.get("sha256"):
+            errors.append(f"physical evidence SHA-256 mismatch: {label}")
+    if len(labels) != len(set(labels)):
+        errors.append("physical configuration evidence labels are duplicated")
+    if len(retained_paths) != len(set(retained_paths)):
+        errors.append("physical configuration retained paths are duplicated")
+    missing = sorted(required - set(labels))
+    if missing:
+        errors.append(
+            "physical configuration evidence labels are missing: "
+            + ", ".join(missing)
+        )
+    if evidence.get("files") != files:
+        errors.append("metadata configuration evidence differs from manifest")
+    return errors
+
+
+def _read_bag(bag_directory, expected_types, report):
+    storage_options = rosbag2_py.StorageOptions(
+        uri=str(bag_directory), storage_id="sqlite3"
+    )
+    converter_options = rosbag2_py.ConverterOptions("", "")
+    reader = rosbag2_py.SequentialReader()
+    reader.open(storage_options, converter_options)
+    bag_types = {
+        item.name: item.type for item in reader.get_all_topics_and_types()
+    }
+    messages = {topic: [] for topic in bag_types}
+    classes = {}
+    for topic, type_name in bag_types.items():
+        try:
+            classes[topic] = get_message(type_name)
+        except (AttributeError, ModuleNotFoundError, ValueError) as exc:
+            if topic in expected_types:
+                report["failures"].append(
+                    f"cannot load required type {type_name} for {topic}: {exc}"
+                )
+    while reader.has_next():
+        topic, serialized, bag_stamp = reader.read_next()
+        message_class = classes.get(topic)
+        message = None
+        if message_class is not None:
+            message = deserialize_message(serialized, message_class)
+        messages.setdefault(topic, []).append((int(bag_stamp), message))
+    return bag_types, messages
+
