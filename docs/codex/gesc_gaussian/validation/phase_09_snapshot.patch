+    assert payload.raw_cost_v == -2.5
+    assert payload.source_score == pytest.approx(0.5)
+    assert math.isfinite(payload.source_score)
+    with pytest.raises(ValueError, match="outside the calibrated range"):
+        build_voltage_payload(
