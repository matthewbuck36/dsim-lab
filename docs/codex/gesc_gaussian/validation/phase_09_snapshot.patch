+def test_calibrated_document_enforces_range_device_and_score(tmp_path):
+    calibration = load_calibration(
+        _write_calibration(
+            tmp_path,
+            status="calibrated",
+            motion_ready=True,
+            serial_device="/dev/serial/by-id/usb-DSIM_Photoresistor_01",
+            voltage_range_v={"minimum": 0.25, "maximum": 4.75},
+            source_score={
+                "enabled": True,
+                "minimum_voltage_v": 0.5,
+                "maximum_voltage_v": 4.5,
+            },
+        )
+    )
+    payload = build_voltage_payload(
+        parse_photoresistor_line("v: 2.5, r: 1000"),
+        calibration=calibration,
+        source_score_enabled=True,
