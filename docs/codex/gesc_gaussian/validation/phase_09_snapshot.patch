+    assert args["pde_odom_topic"] == "/odom"
+    assert args["algorithm_pose_topic"] == "$(var pde_odom_topic)"
+    assert args["gaussian_fill_pose_topic"] == "$(var algorithm_pose_topic)"
+
+    selected_commands = "\n".join(_commands(executables))
+    assert "--input_odom_topic $(var algorithm_pose_topic)" in selected_commands
+    assert "-r /odom:=$(var algorithm_pose_topic)" in selected_commands
+    assert "-p pose_topic:=$(var gaussian_fill_pose_topic)" in selected_commands
+    assert "-p pose_topic:=$(var algorithm_pose_topic)" in selected_commands
+
+
+def test_selected_graph_has_one_command_owner_and_no_evaluator_inputs():
+    _, _, executables = _launch()
+    commands = _commands(executables)
+    command_owners = [
+        command
+        for command in commands
+        if "ros2 run ros_esc controller_node" in command and "/cmd_vel" in command
+    ]
+    assert len(command_owners) == 1
+
+    text = LAUNCH_PATH.read_text(encoding="utf-8")
+    assert "pkill" not in text
+    for forbidden in (
+        "light_source_",
+        "source_x",
+        "source_y",
+        "global_source",
+        "evaluation_role",
+        "relative_lumen",
+        "room_bounds_",
+        "proximity_stop",
+    ):
+        assert forbidden not in text
+
+
+def test_phase09_vicon_is_conditional_evaluation_only_and_not_legacy_odom():
+    _, args, executables = _launch()
+    text = LAUNCH_PATH.read_text(encoding="utf-8").lower()
+    assert "data_collection_node" not in text
+    assert "pkill" not in text
+    assert args["enable_vicon_evaluation"] == "False"
+    evidence_nodes = [
+        item
+        for item in executables
+        if "phase09_vicon_evidence_node" in item.attrib.get("cmd", "")
+    ]
+    assert len(evidence_nodes) == 1
