+import threading
+from types import SimpleNamespace
+
+import pytest
+from rclpy.parameter import Parameter
+import yaml
+
+from ros_esc.experiment_recording import record_run as recorder
+from ros_esc.experiment_recording.record_run import (
+    PHYSICAL_CANONICAL_TARGET_VALUES,
+    PHYSICAL_TARGET_PREFIX,
+    REQUIRED_PHYSICAL_NODE_PARAMETERS,
+    RecordingCoordinator,
+    enforce_required_node_parameters,
+    load_manifest,
+    operational_config_for_mode,
+    operational_heartbeat_errors,
+    operational_message_error,
+    required_node_parameter_errors,
+    required_parameter_snapshot_errors,
+    resolve_operational_heartbeat_aliases,
+    validate_operational_target_coupling,
+)
+from ros_esc.experiment_recording.validate_run import (
+    source_cost_semantics_valid,
+)
+
+
+PACKAGE_ROOT = Path(__file__).resolve().parents[1]
+MANIFEST = PACKAGE_ROOT / "ros_esc/experiment_recording/topic_manifest.yaml"
+
+
+def _stamp(sec=1, nanosec=0):
+    return SimpleNamespace(sec=sec, nanosec=nanosec)
+
+
+def _physical_source(score_valid=False):
+    return SimpleNamespace(
+        SOURCE_PHYSICAL=2,
+        SOURCE_SIMULATION=1,
+        source_mode=2,
+        stamp=_stamp(),
+        source_timestamp_valid=True,
+        source_timestamp=0.25,
+        channel_count=1,
+        raw_sensor_valid=True,
+        raw_cost_valid=True,
+        source_score_valid=score_valid,
+        raw_sensor_value=[2.5],
+        raw_cost=[-2.5],
+        source_score=[0.5 if score_valid else float("nan")],
+    )
+
+
+def _pose(stamp=None):
+    value = SimpleNamespace(
+        pose=SimpleNamespace(
+            pose=SimpleNamespace(
+                position=SimpleNamespace(x=0.0, y=0.0, z=0.0),
+                orientation=SimpleNamespace(x=0.0, y=0.0, z=0.0, w=1.0),
+            )
+        )
+    )
+    if stamp is not None:
+        value.header = SimpleNamespace(stamp=stamp)
+    return value
+
+
+def _imu():
+    return SimpleNamespace(
+        header=SimpleNamespace(stamp=_stamp()),
+        orientation=SimpleNamespace(x=0.0, y=0.0, z=0.0, w=1.0),
+        angular_velocity=SimpleNamespace(x=0.0, y=0.0, z=0.01),
+        linear_acceleration=SimpleNamespace(x=0.0, y=0.0, z=9.81),
+    )
+
+
+def _physical_target(**overrides):
+    values = dict(PHYSICAL_CANONICAL_TARGET_VALUES)
+    values.update(
+        photoresistor_serial_port=(
+            "/dev/serial/by-id/usb-DSIM_Photoresistor_01"
+        ),
+        photoresistor_calibration_file="/tmp/reviewed-calibration.yaml",
+    )
+    values.update(overrides)
+    return [*PHYSICAL_TARGET_PREFIX, *(f"{name}:={value}" for name, value in values.items())]
+
+
+def test_manifest_requires_complete_physical_heartbeat_and_time_contract():
+    manifest = load_manifest(MANIFEST)
+    config = operational_config_for_mode(manifest, "physical")
+
+    assert config["physical_schema_version"] == 1
+    assert config["heartbeat_aliases"] == [
+        "source_cost",
+        "pose",
+        "imu",
+        "filter_output_legacy",
+        "timekeeper",
+    ]
+    assert config["profile_heartbeat_aliases"] == {
+        "robust_gaussian_v1": ["algorithm_state", "supervisor_command"]
+    }
+    assert config["heartbeat_stale_sec"] == 0.5
+    assert config["required_node_parameters"] == REQUIRED_PHYSICAL_NODE_PARAMETERS
+    assert resolve_operational_heartbeat_aliases(
+        config,
+        {"algorithm_profile": "robust_gaussian_v1"},
+    ) == [
+        "source_cost",
+        "pose",
+        "imu",
+        "filter_output_legacy",
+        "timekeeper",
+        "algorithm_state",
+        "supervisor_command",
+    ]
+    by_alias = {entry["alias"]: entry for entry in manifest["topics"]}
+    assert by_alias["imu"]["modes"] == ["physical"]
+    assert "physical" in by_alias["encoder"]["modes"]
+
+
+def test_manifest_rejects_physical_bypass_or_time_drift(tmp_path):
+    document = yaml.safe_load(MANIFEST.read_text(encoding="utf-8"))
+    bypass = copy.deepcopy(document)
+    del bypass["operational_readiness"]["physical"]["physical_schema_version"]
+    path = tmp_path / "bypass.yaml"
+    path.write_text(yaml.safe_dump(bypass), encoding="utf-8")
+    with pytest.raises(ValueError, match="physical mode must not configure"):
+        load_manifest(path)
+
+    drift = copy.deepcopy(document)
+    drift["operational_readiness"]["physical"]["required_node_parameters"][
+        "/custom_controller"
+    ]["use_sim_time"] = True
+    path.write_text(yaml.safe_dump(drift), encoding="utf-8")
+    with pytest.raises(ValueError, match="use_sim_time=false"):
+        load_manifest(path)
+
+
+def test_physical_target_is_canonical_and_has_no_evaluator_inputs():
+    config = operational_config_for_mode(load_manifest(MANIFEST), "physical")
+    metadata = {"algorithm_profile": "robust_gaussian_v1"}
+    coupling = validate_operational_target_coupling(
+        config,
+        metadata,
+        _physical_target(),
+    )
+    assert coupling["mode"] == "physical"
+    assert coupling["serial_device_by_id"].startswith("/dev/serial/by-id/")
+
+    with pytest.raises(ValueError, match="not canonical"):
+        validate_operational_target_coupling(
+            config,
+            metadata,
+            _physical_target(known_source_count="3"),
+        )
+    with pytest.raises(ValueError, match="evaluator-only"):
+        validate_operational_target_coupling(
+            config,
+            metadata,
+            [*_physical_target(), "light_source_1_x:=1.0"],
+        )
+
+
+def test_physical_source_uses_positive_sensor_and_negative_raw_cost():
+    source = _physical_source(score_valid=False)
+    assert operational_message_error(
+        "source_cost", source, "physical", "robust_gaussian_v1"
+    ) is None
+    assert source_cost_semantics_valid(source, "physical") is True
+
+    source.raw_cost = [2.5]
+    assert "physical source-cost" in operational_message_error(
+        "source_cost", source, "physical", "robust_gaussian_v1"
+    )
+    assert source_cost_semantics_valid(source, "physical") is False
+
+
+def test_physical_source_score_is_optional_but_validated_when_present():
+    source = _physical_source(score_valid=True)
+    assert operational_message_error(
+        "source_cost", source, "physical", "robust_gaussian_v1"
+    ) is None
+    assert source_cost_semantics_valid(source, "physical") is True
+
+    source.source_score = [float("nan")]
+    assert operational_message_error(
+        "source_cost", source, "physical", "robust_gaussian_v1"
+    ) is not None
+    assert source_cost_semantics_valid(source, "physical") is False
+
+
+def test_physical_pose_imu_and_timekeeper_require_finite_real_time_data():
+    pose = _pose(_stamp())
+    imu = _imu()
+    timekeeper = SimpleNamespace(start_time=1.0, mode="real time")
+    assert operational_message_error(
+        "pose", pose, "physical", "robust_gaussian_v1"
+    ) is None
+    assert operational_message_error(
+        "imu", imu, "physical", "robust_gaussian_v1"
+    ) is None
+    assert operational_message_error(
+        "timekeeper", timekeeper, "physical", "robust_gaussian_v1"
+    ) is None
+
+    pose.header.stamp = _stamp(0, 0)
+    assert "pose" in operational_message_error(
+        "pose", pose, "physical", "robust_gaussian_v1"
+    )
+    imu.orientation.w = 0.0
+    assert "IMU" in operational_message_error(
+        "imu", imu, "physical", "robust_gaussian_v1"
+    )
+    timekeeper.mode = "sim time"
+    assert "timekeeper" in operational_message_error(
+        "timekeeper", timekeeper, "physical", "robust_gaussian_v1"
+    )
+
+
+def test_each_missing_or_stale_physical_heartbeat_fails_closed():
+    aliases = (
+        "source_cost",
+        "pose",
+        "imu",
+        "filter_output_legacy",
+        "timekeeper",
+        "algorithm_state",
+        "supervisor_command",
+    )
+    observed = {alias: 10.0 for alias in aliases}
+    assert operational_heartbeat_errors(observed, 10.4, 0.5) == []
+    for alias in aliases:
+        missing = dict(observed)
+        missing[alias] = None
+        assert any(
+            f"missing: {alias}" in error
+            for error in operational_heartbeat_errors(missing, 10.4, 0.5)
+        )
+        stale = dict(observed)
+        stale[alias] = 9.0
+        assert any(
+            f"stale: {alias}" in error
+            for error in operational_heartbeat_errors(stale, 10.4, 0.5)
+        )
+
+
+def test_runtime_algorithm_state_may_advance_after_authorization():
