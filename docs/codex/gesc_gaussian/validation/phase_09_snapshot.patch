+#!/usr/bin/env python3
+
+"""No-hardware Timekeeper used only by Phase 09 stationary preflight."""
+
+import argparse
+import json
+import sys
+import time
+
+import rclpy
+from rclpy.node import Node
+from rclpy.utilities import remove_ros_args
+from ros_esc_interfaces.msg import Timekeeper
+from std_msgs.msg import Float64, String
+
+from .phase09_rotation_node import (
+    CANONICAL_ROTATION_COMMAND_TOPIC,
+    CANONICAL_ROTATION_STATUS_TOPIC,
+)
+
+
+def parse_stationary_timekeeper_arguments(arguments=None):
+    parser = argparse.ArgumentParser(
+        description="Publish a no-hardware physical Timekeeper for preflight."
+    )
+    parser.add_argument("output_timekeeper_topic")
+    parser.add_argument("--status-topic", default=CANONICAL_ROTATION_STATUS_TOPIC)
+    parser.add_argument("--command-topic", default=CANONICAL_ROTATION_COMMAND_TOPIC)
+    parsed = parser.parse_args(arguments)
+    if parsed.status_topic != CANONICAL_ROTATION_STATUS_TOPIC:
+        parser.error("--status-topic must remain the Phase 09 status topic")
+    if parsed.command_topic != CANONICAL_ROTATION_COMMAND_TOPIC:
+        parser.error("--command-topic must remain the Phase 09 command topic")
+    return parsed
+
+
+class Phase09StationaryTimekeeperNode(Node):
+    """Publish graph heartbeats without importing pigpio or writing PWM."""
+
+    def __init__(self, options):
+        super().__init__("phase09_stationary_timekeeper")
+        self.start_time = time.time()
+        self.timekeeper_publisher = self.create_publisher(
+            Timekeeper, options.output_timekeeper_topic, 50
+        )
+        self.status_publisher = self.create_publisher(String, options.status_topic, 10)
+        self.command_publisher = self.create_publisher(
+            Float64, options.command_topic, 10
+        )
+        self.timer = self.create_timer(0.05, self.publish_heartbeats)
+
+    def publish_heartbeats(self):
+        timekeeper = Timekeeper()
+        timekeeper.start_time = self.start_time
+        timekeeper.mode = "real time"
+        self.timekeeper_publisher.publish(timekeeper)
+        command = Float64()
+        command.data = 0.0
+        self.command_publisher.publish(command)
+        status = String()
+        status.data = json.dumps({
+            "schema_version": 1,
+            "state": "PASSIVE_STATIONARY_PREFLIGHT",
+            "authorization_active": False,
+            "ever_authorized": False,
+            "hardware_initialized": False,
+            "timekeeper_started": True,
+            "last_command_rpm": 0.0,
+            "fault_reason": None,
+        }, separators=(",", ":"), sort_keys=True)
+        self.status_publisher.publish(status)
+
+
+def main(args=None):
+    """Run the no-hardware stationary preflight heartbeat owner."""
+
+    process_arguments = sys.argv if args is None else [sys.argv[0], *args]
+    options = parse_stationary_timekeeper_arguments(
+        remove_ros_args(args=process_arguments)[1:]
+    )
+    rclpy.init(args=args)
+    node = Phase09StationaryTimekeeperNode(options)
+    try:
+        rclpy.spin(node)
+    except KeyboardInterrupt:
+        pass
+    finally:
+        node.destroy_node()
+        rclpy.try_shutdown()
+
+
+if __name__ == "__main__":
+    main()
