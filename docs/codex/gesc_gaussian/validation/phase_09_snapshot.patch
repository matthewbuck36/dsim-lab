index 0000000000000000000000000000000000000000..1f6149e8e5cf7cb8f6e6aaf763c9e60108230f97
--- /dev/null
+++ b/turtlebot3_vehicle_nodes/bash_scripts/light_esc_experiments/voltage_cost_values/gesc_gaussian_two_source_voltage.bash
@@ -0,0 +1,649 @@
+#!/usr/bin/env bash
+
+# Phase 09 selected physical entry point. The operator ends a run with Ctrl+C.
+set -euo pipefail
+
+usage() {
+    echo "usage: $0 [--scenario primary|secondary] [--serial-device /dev/serial/by-id/...] [--calibration-file PATH] [--metadata-file PATH] [--site-config-dir PATH] [--operator NAME] [--runs-root PATH] [--check-only | --stationary-preflight | --approve-stationary RUN_DIR --reviewer NAME]" >&2
+}
+
+PHASE09_SCENARIO="primary"
+PHASE09_SERIAL_DEVICE=""
+PHASE09_CALIBRATION_FILE=""
+PHASE09_METADATA_FILE=""
+PHASE09_SITE_CONFIG_DIR="${PHASE09_SITE_CONFIG_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/dsim-lab/phase09}"
+PHASE09_OPERATOR=""
+PHASE09_RUNS_ROOT="${HOME}/Experiments/GESC-Gaussian/runs/phase09_physical"
+PHASE09_WORKSPACE="${PHASE09_ROS2_WS:-${HOME}/ros2_ws}"
+PHASE09_ROS_SETUP="${PHASE09_ROS_SETUP:-/opt/ros/humble/setup.bash}"
+PHASE09_CHECK_ONLY="False"
+PHASE09_STATIONARY_PREFLIGHT="False"
+PHASE09_APPROVE_STATIONARY=""
+PHASE09_REVIEWER=""
+
+while (($#)); do
+    case "$1" in
+        --scenario|--serial-device|--calibration-file|--metadata-file|--site-config-dir|--operator|--runs-root|--approve-stationary|--reviewer)
+            if (($# < 2)) || [[ -z "$2" ]]; then
+                usage
+                exit 2
+            fi
+            ;;
+    esac
+    case "$1" in
+        --scenario)
+            PHASE09_SCENARIO="${2:-}"
+            shift 2
+            ;;
+        --serial-device)
+            PHASE09_SERIAL_DEVICE="${2:-}"
+            shift 2
+            ;;
+        --calibration-file)
+            PHASE09_CALIBRATION_FILE="${2:-}"
+            shift 2
+            ;;
+        --metadata-file)
+            PHASE09_METADATA_FILE="${2:-}"
+            shift 2
+            ;;
+        --site-config-dir)
+            PHASE09_SITE_CONFIG_DIR="${2:-}"
+            shift 2
+            ;;
+        --operator)
+            PHASE09_OPERATOR="${2:-}"
+            shift 2
+            ;;
+        --runs-root)
+            PHASE09_RUNS_ROOT="${2:-}"
+            shift 2
+            ;;
+        --check-only)
+            PHASE09_CHECK_ONLY="True"
+            shift
+            ;;
+        --stationary-preflight)
+            PHASE09_STATIONARY_PREFLIGHT="True"
+            shift
+            ;;
+        --approve-stationary)
+            PHASE09_APPROVE_STATIONARY="${2:-}"
+            shift 2
+            ;;
+        --reviewer)
+            PHASE09_REVIEWER="${2:-}"
+            shift 2
+            ;;
+        -h|--help)
+            usage
+            exit 0
+            ;;
+        *)
+            usage
+            exit 2
+            ;;
+    esac
+done
+
+PHASE09_MODE_COUNT=0
+[[ "$PHASE09_CHECK_ONLY" == "True" ]] && PHASE09_MODE_COUNT=$((PHASE09_MODE_COUNT + 1))
+[[ "$PHASE09_STATIONARY_PREFLIGHT" == "True" ]] && PHASE09_MODE_COUNT=$((PHASE09_MODE_COUNT + 1))
+[[ -n "$PHASE09_APPROVE_STATIONARY" ]] && PHASE09_MODE_COUNT=$((PHASE09_MODE_COUNT + 1))
+if ((PHASE09_MODE_COUNT > 1)); then
