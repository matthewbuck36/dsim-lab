+                self.handshake_pending = False
+                return handshake, ("192.168.1.36", 40000)
+            raise BlockingIOError
+
+        def sendto(self, payload, endpoint):
+            self.sent.append((payload, endpoint))
+
+        def close(self):
+            self.closed = True
+
+    class FakeViconClient:
+        def __init__(self):
+            self.frame_calls = 0
+            self.pose_queries = []
+
+        def GetFrame(self):
+            self.frame_calls += 1
+            if self.frame_calls == 1:
+                return True
+            raise KeyboardInterrupt
+
+        def GetFrameNumber(self):
