+++ b/ros_esc/ros_esc/experiment_recording/validate_run.py
@@ -0,0 +1,1989 @@
+#!/usr/bin/env python3
+
+"""Offline run-completeness validator for unified GESC/Gaussian recordings."""
+
+import argparse
+import hashlib
+import json
+import math
+from pathlib import Path
+import sys
+
+from rclpy.serialization import deserialize_message
+import rosbag2_py
+from rosidl_runtime_py.utilities import get_message
+import yaml
+
+from .record_run import (
+    DEFAULT_TIMESTAMP_ORDERING,
+    MULTI_PUBLISHER_TIMESTAMP_ORDERING,
+    OPERATIONAL_RECORDING_MAXIMUM_GAP_SEC,
+    PHYSICAL_OPERATIONAL_HEARTBEATS,
+    PHYSICAL_REQUIRED_EVIDENCE_LABELS,
+    REQUIRED_METADATA,
+    VALID_PROFILES_BY_MODE,
+    atomic_json,
+    expected_publisher_error,
+    parse_rotation_status_message,
+    parse_vicon_status_message,
+    preauthorization_lifecycle_errors,
+    rotation_status_error,
+    topic_evidence_contract_errors,
+)
+
+
+FORBIDDEN_CONSOLE_MARKERS = (
+    "traceback (most recent call last)",
+    "rclerror",
+    "publisher's context is invalid",
+    "failed to terminate",
+)
+MOTION_COVERAGE_ALIASES = {
+    "source_cost",
+    "cost_breakdown",
+    "gesc_diagnostics",
+    "control_diagnostics",
+    "algorithm_state",
+    "pose",
+    "command_final",
+    "command_array_final",
+}
+PHYSICAL_MOTION_COVERAGE_ALIASES = {
+    "vicon_evaluation_pose",
+    "vicon_evaluation_status",
+    "imu",
+    "encoder",
+    "rotation_status",
+    "rotation_command",
+}
+FILL_EVENT_TYPES = {20, 22, 23}
+FILL_OWNER_EVENT_TYPES = set(range(20, 27))
+
+
+def _stamp_nanoseconds(stamp):
+    return int(stamp.sec) * 1_000_000_000 + int(stamp.nanosec)
+
+
+def _message_stamp_nanoseconds(message):
+    """Return a typed absolute ROS stamp, excluding legacy float timestamps."""
+
+    if hasattr(message, "stamp"):
+        return _stamp_nanoseconds(message.stamp)
+    if hasattr(message, "header") and hasattr(message.header, "stamp"):
+        return _stamp_nanoseconds(message.header.stamp)
+    return None
+
+
+def source_cost_semantics_valid(message, mode):
+    """Validate simulation or physical source ownership without requiring a score."""
+
+    if message is None:
+        return False
+    if mode == 'simulation':
+        return bool(
+            message.source_mode == message.SOURCE_SIMULATION
+            and message.raw_cost_valid
+            and message.source_score_valid
+            and not message.raw_sensor_valid
+        )
+    if mode != 'physical':
+        return False
+    try:
+        raw_sensor = tuple(float(value) for value in message.raw_sensor_value)
+        raw_cost = tuple(float(value) for value in message.raw_cost)
+        source_score = tuple(float(value) for value in message.source_score)
+        stamp = _message_stamp_nanoseconds(message)
+        source_timestamp = float(message.source_timestamp)
+        channel_count = int(message.channel_count)
+    except (AttributeError, TypeError, ValueError):
+        return False
+    score_valid = bool(message.source_score_valid)
+    return bool(
+        message.source_mode == message.SOURCE_PHYSICAL
+        and stamp is not None
+        and stamp > 0
+        and message.source_timestamp_valid
+        and math.isfinite(source_timestamp)
+        and source_timestamp >= 0.0
+        and message.raw_sensor_valid
+        and message.raw_cost_valid
+        and channel_count == 1
+        and len(raw_sensor) == 1
+        and len(raw_cost) == 1
+        and all(math.isfinite(value) for value in (*raw_sensor, *raw_cost))
+        and math.isclose(
+            raw_cost[0],
+            -raw_sensor[0],
+            rel_tol=0.0,
+            abs_tol=1e-9,
+        )
+        and (
+            not score_valid
+            or (
+                len(source_score) == 1
+                and math.isfinite(source_score[0])
+                and 0.0 <= source_score[0] <= 1.0
+            )
+        )
+    )
+
+
+def vicon_evaluation_semantics_valid(message, bag_stamp=None):
+    """Validate physical Vicon evidence without comparing it to control odom."""
+
+    if message is None:
+        return False
+    try:
+        stamp = _message_stamp_nanoseconds(message)
+        pose = message.pose
+        numeric = tuple(float(value) for value in (
+            pose.position.x,
+            pose.position.y,
+            pose.position.z,
+            pose.orientation.x,
+            pose.orientation.y,
+            pose.orientation.z,
+            pose.orientation.w,
+        ))
+    except (AttributeError, TypeError, ValueError):
+        return False
+    quaternion_norm = math.sqrt(sum(value * value for value in numeric[3:]))
+    receipt_coherent = (
+        bag_stamp is None
+        or stamp is not None
+        and abs(int(bag_stamp) - int(stamp)) <= 1_000_000_000
+    )
+    return bool(
+        stamp is not None
+        and stamp > 0
+        and str(message.header.frame_id) == "vicon_world"
+        and all(math.isfinite(value) for value in numeric)
+        and math.isclose(
+            quaternion_norm,
+            1.0,
+            rel_tol=0.0,
+            abs_tol=1e-3,
+        )
+        and receipt_coherent
+    )
+
+
+def vicon_status_interval_errors(records, tracking, interval_start, interval_end):
+    """Validate advancing identity-bearing Vicon status over one interval."""
+
+    if not isinstance(tracking, dict):
+        return ["evaluation_tracking metadata is missing"]
+    expected_subject = tracking.get("subject_name")
+    expected_segment = tracking.get("segment_name")
+    expected_hash = tracking.get("server_script_sha256")
+    try:
+        stale_sec = float(tracking.get("stale_sec"))
+    except (TypeError, ValueError):
+        stale_sec = float("nan")
+    if (
+        not isinstance(expected_subject, str)
+        or not expected_subject
+        or expected_subject != expected_subject.strip()
+        or not isinstance(expected_segment, str)
+        or not expected_segment
+        or expected_segment != expected_segment.strip()
+        or not isinstance(expected_hash, str)
+        or len(expected_hash) != 64
+        or any(char not in "0123456789abcdef" for char in expected_hash)
+        or not math.isfinite(stale_sec)
+        or not 0.1 <= stale_sec <= 2.0
+    ):
+        return ["evaluation_tracking commissioned identity is invalid"]
+    selected = [
+        (stamp, message)
+        for stamp, message in records
+        if interval_start <= stamp <= interval_end
+    ]
+    if not selected:
+        return ["Vicon status is absent from the required interval"]
+    errors = []
+    if len(selected) < 2:
+        errors.append(
+            "Vicon status requires at least two advancing samples"
+        )
+    if (
+        selected[0][0] > interval_start + 1_000_000_000
+        or selected[-1][0] < interval_end - 1_000_000_000
+    ):
+        errors.append("Vicon status does not span the required interval")
+    for (previous_stamp, _), (current_stamp, _) in zip(selected, selected[1:]):
+        if current_stamp - previous_stamp > int((stale_sec + 0.1) * 1e9):
+            errors.append({
+                "bag_timestamp": current_stamp,
+                "error": "Vicon status receipt gap exceeded freshness bound",
+            })
+    previous_session = None
+    previous_sequence = None
+    previous_frame = None
+    for stamp, message in selected:
+        try:
+            status = parse_vicon_status_message(message)
+            integer_fields = {
+                name: status[name]
+                for name in (
+                    "sequence",
+                    "tracker_frame",
+                    "accepted_packets",
+                    "rejected_packets",
+                )
+            }
+            if any(type(value) is not int for value in integer_fields.values()):
+                raise ValueError("status counters are not exact integers")
+            age_value = status["last_valid_age_sec"]
+            if type(age_value) not in (int, float):
+                raise ValueError("status age is not an exact number")
+            age = float(age_value)
+            session = status["server_session"]
+            sequence = integer_fields["sequence"]
+            frame = integer_fields["tracker_frame"]
+            if (
+                type(status["schema_version"]) is not int
+                or status["schema_version"] != 1
+                or status["protocol_magic"] != "DSIM_PHASE09_VICON"
+                or type(status["protocol_version"]) is not int
+                or status["protocol_version"] != 1
+                or status["valid"] is not True
+                or status["reason"] != "ok"
+                or status["subject_name"] != expected_subject
+                or status["segment_name"] != expected_segment
+                or status["server_script_sha256"] != expected_hash
+                or not isinstance(session, str)
+                or len(session) != 32
+                or any(char not in "0123456789abcdef" for char in session)
+                or sequence <= 0
+                or frame <= 0
+                or integer_fields["accepted_packets"] <= 0
+                or integer_fields["rejected_packets"] < 0
+                or status["translation_occluded"] is not False
+                or status["rotation_occluded"] is not False
+                or not math.isfinite(age)
+                or not 0.0 <= age <= stale_sec
+            ):
+                raise ValueError("status content is not commissioned and valid")
+            if previous_session is not None and session != previous_session:
+                raise ValueError("server session changed")
+            if previous_sequence is not None and sequence <= previous_sequence:
+                raise ValueError("packet sequence did not advance")
+            if previous_frame is not None and frame <= previous_frame:
+                raise ValueError("Tracker frame did not advance")
+            previous_session = session
+            previous_sequence = sequence
+            previous_frame = frame
+        except (AttributeError, KeyError, TypeError, ValueError) as exc:
+            errors.append({"bag_timestamp": stamp, "error": str(exc)})
+    return errors
+
+
+def rotation_status_interval_errors(
+    records,
+    interval_start,
+    interval_end,
+    *,
+    stationary_preflight,
+    readiness_start=None,
+    readiness_end=None,
+):
+    """Validate passive or staged real rotation evidence over one interval."""
+
+    selected = [
+        (stamp, message)
+        for stamp, message in records
+        if interval_start <= stamp
+        and (not stationary_preflight or stamp <= interval_end)
+    ]
+    if not selected:
+        return ["rotation status is absent from the required interval"]
+    errors = []
+    if (
+        selected[0][0] > interval_start + 1_000_000_000
+        or selected[-1][0] < interval_end - 1_000_000_000
+    ):
+        errors.append("rotation status does not span the required interval")
+    for (previous_stamp, _), (current_stamp, _) in zip(selected, selected[1:]):
+        if current_stamp - previous_stamp > 600_000_000:
+            errors.append({
+                "bag_timestamp": current_stamp,
+                "error": "rotation status receipt gap exceeded 0.6 seconds",
+            })
+    if not stationary_preflight:
+        preauthorization = [
+            (stamp, message)
+            for stamp, message in records
+            if stamp < interval_start
+        ]
+        if not preauthorization:
+            errors.append(
+                "rotation status lacks preauthorization "
+                "WAITING_AUTHORIZATION evidence"
+            )
+        elif preauthorization[-1][0] < interval_start - 1_000_000_000:
+            errors.append(
+                "rotation WAITING evidence is stale at authorization"
+            )
+        for stamp, message in preauthorization:
+            status_error = rotation_status_error(
+                message,
+                False,
+                False,
+            )
+            if status_error is not None:
+                errors.append({
+                    "bag_timestamp": stamp,
+                    "error": (
+                        "rotation was not passive WAITING before "
+                        "authorization"
+                    ),
+                })
+    parsed = []
+    terminal_fault_seen = False
+    for stamp, message in selected:
+        try:
+            status = parse_rotation_status_message(message)
+        except (TypeError, ValueError) as exc:
+            errors.append({"bag_timestamp": stamp, "error": str(exc)})
+            continue
+        parsed.append((stamp, status, message))
+        if stationary_preflight:
+            status_error = rotation_status_error(message, True)
+            if status_error is not None:
+                errors.append({"bag_timestamp": stamp, "error": status_error})
+            continue
+        state = status.get("state")
+        boolean_names = (
+            "authorization_active",
+            "ever_authorized",
+            "hardware_initialized",
+            "timekeeper_started",
+        )
+        basic_valid = bool(
+            type(status.get("schema_version")) is int
+            and status.get("schema_version") == 1
+            and state in {
+                "WAITING_AUTHORIZATION",
+                "ALIGNING",
+                "SETTLING",
+                "RUNNING",
+                "FAULT",
+            }
+            and all(type(status.get(name)) is bool for name in boolean_names)
+            and status.get("fault_reason") is None
+        )
+        command = status.get("last_command_rpm")
+        if command is not None and type(command) not in (int, float):
+            basic_valid = False
+        try:
+            command = None if command is None else float(command)
+        except (TypeError, ValueError):
+            basic_valid = False
+            command = None
+        terminal_fault = bool(
+            type(status.get("schema_version")) is int
+            and status.get("schema_version") == 1
+            and state == "FAULT"
+            and all(type(status.get(name)) is bool for name in boolean_names)
+            and interval_end is not None
+            and stamp >= interval_end
+            and readiness_end is not None
+            and stamp >= readiness_end
+            and status.get("authorization_active") is False
+            and status.get("ever_authorized") is True
+            and status.get("hardware_initialized") is True
+            and status.get("timekeeper_started") is True
+            and command is not None
+            and math.isfinite(command)
+            and math.isclose(command, 0.0, abs_tol=1e-9)
+            and status.get("fault_reason")
+            == "rotation authorization was revoked"
+        )
+        if terminal_fault:
+            terminal_fault_seen = True
+            continue
+        if not stationary_preflight and stamp > interval_end:
+            errors.append({
+                "bag_timestamp": stamp,
+                "error": (
+                    "rotation status transition content is invalid after "
+                    "authorization ended"
+                ),
+            })
+            continue
+        if state == "WAITING_AUTHORIZATION":
+            basic_valid = basic_valid and bool(
+                status.get("authorization_active") is False
+                and status.get("ever_authorized") is False
+                and status.get("hardware_initialized") is False
+                and status.get("timekeeper_started") is False
+                and command is None
+            )
+        else:
+            basic_valid = basic_valid and bool(
+                status.get("authorization_active") is True
+                and status.get("ever_authorized") is True
+                and status.get("hardware_initialized") is True
+            )
+        if state == "SETTLING":
+            basic_valid = basic_valid and bool(
+                status.get("timekeeper_started") is False
+                and command is not None
+                and math.isfinite(command)
+                and math.isclose(command, 0.0, abs_tol=1e-9)
+            )
+        if state == "RUNNING":
+            basic_valid = basic_valid and bool(
+                status.get("timekeeper_started") is True
+                and command is not None
+                and math.isfinite(command)
+                and not math.isclose(command, 0.0, abs_tol=1e-9)
+            )
+        if not basic_valid:
+            errors.append({
+                "bag_timestamp": stamp,
+                "error": "rotation status transition content is invalid",
+            })
+    if not stationary_preflight:
+        if not terminal_fault_seen:
+            errors.append(
+                "rotation lacks terminal authorization-revoked zero status"
+            )
+        running_before_ready = [
+            message
+            for stamp, _, message in parsed
+            if readiness_start is not None and stamp <= readiness_start
+            and rotation_status_error(message, False) is None
+        ]
+        if not running_before_ready:
+            errors.append("rotation never proved RUNNING before base readiness")
+        for stamp, status, message in parsed:
+            if (
+                readiness_start is not None
+                and readiness_end is not None
+                and readiness_start <= stamp <= readiness_end
+                and status.get("state") != "FAULT"
+            ):
+                status_error = rotation_status_error(message, False)
+                if status_error is not None:
+                    errors.append({
+                        "bag_timestamp": stamp,
+                        "error": "rotation was not RUNNING during base readiness",
+                    })
+    return errors
+
