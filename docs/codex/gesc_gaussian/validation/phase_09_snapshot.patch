+def test_runtime_fault_publishes_readiness_false_then_stop_true():
+    coordinator = object.__new__(RecordingCoordinator)
+    coordinator._state_lock = threading.RLock()
+    coordinator.ready = True
+    coordinator.preauthorization_monitoring_closed = True
+    coordinator.last_operational_snapshot = {"passed": True}
+    coordinator.operational_errors = lambda: ["operational heartbeat stale: imu"]
+    publications = []
+    coordinator.publish_ready = lambda: publications.append(
+        ("ready", coordinator.ready)
+    )
+    coordinator.stop_publisher = SimpleNamespace(
+        publish=lambda message: publications.append(("stop", message.data))
+    )
+
+    errors = coordinator.revoke_if_unsafe()
+    assert errors == ["operational heartbeat stale: imu"]
+    assert coordinator.ready is False
+    assert publications == [("ready", False), ("stop", True)]
+    assert coordinator.last_operational_snapshot["runtime_revocation_errors"]
+
+
+def test_shutdown_order_and_final_zero_contract_are_preserved():
+    coordinator = object.__new__(RecordingCoordinator)
+    coordinator._state_lock = threading.RLock()
+    coordinator.ready = True
+    coordinator.preauthorization_monitoring_closed = False
+    publications = []
+    coordinator.publish_ready = lambda: publications.append(
+        ("ready", coordinator.ready)
+    )
+    coordinator.stop_publisher = SimpleNamespace(
+        publish=lambda message: publications.append(("stop", message.data))
+    )
+    coordinator.request_stop()
+    assert publications == [("ready", False), ("stop", True)]
+
+    coordinator.zero_observed_at = {
+        "/cmd_vel": 4.0,
+        "/turtlebot3/control_value_chatter": 4.1,
+        "/gesc_gaussian/control_diagnostics": 4.2,
+    }
+    assert coordinator.final_zero_after(4.0) is True
+    assert coordinator.final_zero_after(4.15) is False
