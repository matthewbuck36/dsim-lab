+def _sha256_file(path):
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _sha256_path(path):
+    """Hash one file or one deterministic, symlink-free directory tree."""
+
+    path = Path(path).resolve(strict=True)
+    if path.is_file():
+        return _sha256_file(path)
+    if not path.is_dir():
+        raise ValueError(f"evidence path is neither a file nor directory: {path}")
+    entries = sorted(path.rglob("*"), key=lambda item: item.relative_to(path).as_posix())
+    files = []
+    for entry in entries:
+        if entry.is_symlink() or not (entry.is_file() or entry.is_dir()):
+            raise ValueError(f"evidence tree contains an unsupported entry: {entry}")
+        if entry.is_file():
+            files.append(entry)
+    if not files:
+        raise ValueError(f"evidence directory contains no files: {path}")
+    digest = hashlib.sha256(b"DSIM_PHASE09_TREE_V1\0")
+    for entry in files:
+        relative = entry.relative_to(path).as_posix().encode("utf-8")
+        digest.update(relative)
+        digest.update(b"\0")
+        digest.update(str(entry.stat().st_size).encode("ascii"))
+        digest.update(b"\0")
+        with entry.open("rb") as stream:
+            for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+                digest.update(chunk)
+        digest.update(b"\0")
+    return digest.hexdigest()
+
+
+def _finite_number(value):
+    if isinstance(value, bool):
+        return None
+    try:
+        number = float(value)
+    except (TypeError, ValueError):
+        return None
+    return number if math.isfinite(number) else None
+
+
+def _ordered_interval(value):
+    if not isinstance(value, (list, tuple)) or len(value) != 2:
+        return None
+    lower = _finite_number(value[0])
+    upper = _finite_number(value[1])
+    if lower is None or upper is None or lower > upper:
+        return None
+    return lower, upper
+
+
+def _nonempty_mapping(value):
+    return isinstance(value, dict) and bool(value)
+
+
+def _utc_timestamp_valid(value):
+    text = str(value).strip()
+    if not text:
+        return False
+    try:
+        parsed = dt.datetime.fromisoformat(text.replace("Z", "+00:00"))
+    except ValueError:
+        return False
+    return parsed.tzinfo is not None and parsed.utcoffset() == dt.timedelta(0)
+
+
+def _artifact_path(calibration_path, artifacts, stem):
+    """Resolve one declared evidence artifact without accepting links."""
+
+    requested = artifacts.get(f"{stem}_path")
+    expected_hash = str(artifacts.get(f"{stem}_sha256", ""))
+    if not requested or not _SHA256_RE.fullmatch(expected_hash):
+        return None
+    artifact_path = Path(str(requested)).expanduser()
+    if not artifact_path.is_absolute():
+        artifact_path = Path(calibration_path).parent / artifact_path
+    try:
+        artifact_path = artifact_path.resolve(strict=True)
+    except OSError:
+        return None
+    return artifact_path
+
+
+def _artifact_matches(calibration_path, artifacts, stem):
+    artifact_path = _artifact_path(calibration_path, artifacts, stem)
+    if artifact_path is None:
+        return False
+    expected_hash = str(artifacts.get(f"{stem}_sha256", ""))
+    try:
+        return _sha256_path(artifact_path) == expected_hash
+    except (OSError, ValueError):
+        return False
+
+
+def _structured_artifact(calibration_path, artifacts, stem):
+    """Load one hash-verified YAML/JSON mapping artifact."""
+
+    artifact_path = _artifact_path(calibration_path, artifacts, stem)
+    if (
+        artifact_path is None
+        or not artifact_path.is_file()
+        or not _artifact_matches(calibration_path, artifacts, stem)
+    ):
+        return None
+    try:
+        document = yaml.safe_load(artifact_path.read_text(encoding="utf-8"))
+    except (OSError, UnicodeError, yaml.YAMLError):
+        return None
+    return document if isinstance(document, dict) else None
+
+
+def _raw_calibration_bag_checks(calibration_path, artifacts):
+    """Require a hash-verified, readable rosbag2 sqlite3 data set."""
+
+    bag_path = _artifact_path(calibration_path, artifacts, "raw_calibration_bag")
+    if (
+        bag_path is None
+        or not bag_path.is_dir()
+        or not _artifact_matches(
+            calibration_path,
+            artifacts,
+            "raw_calibration_bag",
+        )
+    ):
+        return False
+    try:
+        metadata = yaml.safe_load(
+            (bag_path / "metadata.yaml").read_text(encoding="utf-8")
+        )
+    except (OSError, UnicodeError, yaml.YAMLError):
+        return False
+    information = (
+        metadata.get("rosbag2_bagfile_information")
+        if isinstance(metadata, dict)
+        else None
+    )
+    if not isinstance(information, dict):
+        return False
+    relative_files = information.get("relative_file_paths")
+    declared_total = information.get("message_count")
+    declared_topics = information.get("topics_with_message_count")
+    if (
+        information.get("storage_identifier") != "sqlite3"
+        or not isinstance(relative_files, list)
+        or not relative_files
+        or any(
+            not isinstance(name, str)
+            or not name.endswith(".db3")
+            or Path(name).name != name
+            for name in relative_files
+        )
+        or len(set(relative_files)) != len(relative_files)
+        or type(declared_total) is not int
+        or declared_total <= 0
+        or not isinstance(declared_topics, list)
+        or not declared_topics
+    ):
+        return False
+    database_files = [bag_path / name for name in relative_files]
+    if (
+        {path.name for path in bag_path.glob("*.db3")} != set(relative_files)
+        or not all(path.is_file() and path.stat().st_size > 0 for path in database_files)
+    ):
+        return False
+
+    metadata_counts = {}
+    for item in declared_topics:
+        topic = item.get("topic_metadata") if isinstance(item, dict) else None
+        count = item.get("message_count") if isinstance(item, dict) else None
+        if (
+            not isinstance(topic, dict)
+            or not isinstance(topic.get("name"), str)
+            or not topic["name"].startswith("/")
+            or not isinstance(topic.get("type"), str)
+            or not topic["type"]
+            or type(count) is not int
+            or count < 0
+        ):
+            return False
+        key = (topic["name"], topic["type"])
+        if key in metadata_counts:
+            return False
+        metadata_counts[key] = count
+    if sum(metadata_counts.values()) != declared_total:
+        return False
+
+    database_counts = {}
+    try:
+        for database_path in database_files:
+            connection = sqlite3.connect(
+                database_path.as_uri() + "?mode=ro&immutable=1",
+                uri=True,
+            )
+            try:
+                if connection.execute("PRAGMA quick_check").fetchone() != ("ok",):
+                    return False
+                tables = {
+                    row[0]
+                    for row in connection.execute(
+                        "SELECT name FROM sqlite_master WHERE type='table'"
+                    )
+                }
+                if not {"topics", "messages"}.issubset(tables):
+                    return False
+                rows = connection.execute(
+                    "SELECT topics.name, topics.type, COUNT(messages.id) "
+                    "FROM topics LEFT JOIN messages "
+                    "ON messages.topic_id = topics.id "
+                    "GROUP BY topics.name, topics.type"
+                ).fetchall()
+                for name, message_type, count in rows:
+                    key = (str(name), str(message_type))
+                    database_counts[key] = database_counts.get(key, 0) + int(count)
+            finally:
+                connection.close()
+    except (OSError, sqlite3.DatabaseError, TypeError, ValueError):
+        return False
+    return bool(
+        database_counts == metadata_counts
+        and sum(database_counts.values()) == declared_total
+    )
+
+
+def _resolved_configuration_checks(
+    calibration_document,
+    calibration_path,
+    artifacts,
+):
+    """Bind the reviewed acquisition settings to one retained mapping."""
+
+    document = _structured_artifact(
+        calibration_path,
+        artifacts,
+        "resolved_configuration",
+    )
+    expected = {
+        "schema_version": 1,
+        "serial_protocol": _SERIAL_PROTOCOL,
+        "serial_device": calibration_document.get("serial_device"),
+        "baud_rate": 9600,
+        "firmware_sha256": _PHOTORESISTOR_FIRMWARE_SHA256,
+        "rotation_period_sec": 3.0,
+    }
+    return document == expected
+
+
+def _calculation_output_checks(
+    calibration_document,
+    calibration_path,
+    artifacts,
+):
+    """Cross-couple every reported result to a hash-linked calculation file."""
+
+    document = _structured_artifact(
+        calibration_path,
+        artifacts,
+        "calculation_output",
+    )
+    expected = {
+        "schema_version": 1,
+        "raw_calibration_bag_sha256": artifacts.get(
+            "raw_calibration_bag_sha256"
+        ),
+        "resolved_configuration_sha256": artifacts.get(
+            "resolved_configuration_sha256"
+        ),
+        "measurements": calibration_document.get("measurements"),
+        "analysis": calibration_document.get("analysis"),
+    }
+    return document == expected
+
+
+def _finite_series(value, minimum_length=1):
+    if not isinstance(value, list) or len(value) < minimum_length:
+        return None
+    series = [_finite_number(item) for item in value]
+    return None if any(item is None for item in series) else tuple(series)
+
+
+def _analysis_condition_checks(
+    analysis,
+    measurements,
+    condition,
+    voltage_min,
+    voltage_max,
+):
+    series = _finite_series(
+        analysis.get(f"{condition}_per_rotation_minimum_raw_cost_v"),
+        minimum_length=5,
+    )
+    reported_median = _finite_number(
+        analysis.get(f"{condition}_median_raw_cost_v")
+    )
+    reported_mad = _finite_number(analysis.get(f"{condition}_mad_raw_cost_v"))
+    interval = _ordered_interval(
+        measurements.get(f"{condition}_raw_cost_interval_v")
+    )
+    rotations = measurements.get(f"{condition}_complete_rotations")
+    if (
+        series is None
+        or reported_median is None
+        or reported_mad is None
+        or not isinstance(rotations, int)
+        or isinstance(rotations, bool)
+        or len(series) != rotations
+        or voltage_min is None
+        or voltage_max is None
+    ):
+        return False
+    computed_median = statistics.median(series)
+    computed_mad = statistics.median(
+        abs(value - computed_median) for value in series
+    )
+    expected_interval = (
+        computed_median - 3.0 * computed_mad,
+        computed_median + 3.0 * computed_mad,
+    )
+    return bool(
+        reported_mad >= 0.0
+        and all(-voltage_max <= value <= -voltage_min for value in series)
+        and math.isclose(
+            reported_median,
+            computed_median,
+            rel_tol=0.0,
+            abs_tol=1e-9,
+        )
+        and math.isclose(
+            reported_mad,
+            computed_mad,
+            rel_tol=0.0,
+            abs_tol=1e-9,
+        )
+        and interval is not None
+        and -voltage_max <= interval[0] <= interval[1] <= -voltage_min
+        and all(
+            math.isclose(
+                actual,
+                expected,
+                rel_tol=0.0,
+                abs_tol=1e-9,
+            )
+            for actual, expected in zip(interval, expected_interval)
+        )
+    )
+
+
+def _vicon_evaluation_checks(evaluation_tracking):
+    checks = {}
+    if not isinstance(evaluation_tracking, dict):
+        return {"metadata.vicon.mapping": False}
+    for key, value in _VICON_EVALUATION_FIXED_CONTRACT.items():
+        checks[f"metadata.vicon.{key}"] = evaluation_tracking.get(key) == value
+    for key in ("subject_name", "segment_name"):
+        value = evaluation_tracking.get(key)
+        checks[f"metadata.vicon.{key}"] = bool(
+            isinstance(value, str)
+            and value
+            and value == value.strip()
+            and len(value) <= 128
+            and all(ord(char) >= 32 for char in value)
+        )
+    checks["metadata.vicon.server_script_sha256"] = bool(
+        _SHA256_RE.fullmatch(
+            str(evaluation_tracking.get("server_script_sha256", ""))
+        )
+    )
+    expected_keys = {
+        *_VICON_EVALUATION_FIXED_CONTRACT,
+        "subject_name",
+        "segment_name",
+        "server_script_sha256",
+    }
+    checks["metadata.vicon.no_unreviewed_fields"] = (
+        set(evaluation_tracking) == expected_keys
+    )
+    return checks
+
