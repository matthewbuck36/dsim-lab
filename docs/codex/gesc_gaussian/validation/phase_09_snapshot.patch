+def approve_phase09_stationary_preflight(
+    template_path,
+    run_directory,
+    reviewer,
+    *,
+    reviewed_at_utc=None,
+):
+    """Atomically bind one reviewed stationary PASS to a persistent template."""
+
+    template_path = Path(template_path).resolve(strict=True)
+    run_directory = Path(run_directory).expanduser().resolve(strict=True)
+    if not run_directory.is_dir():
+        raise ValueError("stationary preflight run directory is unavailable")
+    reviewer_name = _reviewed_person(reviewer, "reviewer")
+    reviewed = (
+        str(reviewed_at_utc).strip()
+        if reviewed_at_utc is not None
+        else dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z")
+    )
+    if not _utc_timestamp_valid(reviewed):
+        raise ValueError("stationary preflight review requires a UTC timestamp")
+    template = _load_yaml_mapping(template_path, "Phase 09 metadata template")
+    readiness = template.get("physical_readiness")
+    if not isinstance(readiness, dict) or readiness.get(
+        "stationary_graph_verified"
+    ) is not False:
+        raise ValueError("stationary graph gate must be false before approval")
+    if any(
+        readiness.get(name) is not False
+        for name in _PHASE09_RUN_READINESS_FIELDS
+    ):
+        raise ValueError("persistent metadata contains run authorization")
+
+    try:
+        # MBuck 2026-08-01: Approval never trusts a previously written PASS.
+        # Re-run the sole offline validator against the retained bag first.
+        from ros_esc.experiment_recording.validate_run import (
+            validate_run_directory,
+        )
+        fresh_report = validate_run_directory(
+            run_directory,
+            write_report=True,
+        )
+        if fresh_report.get("passed") is not True:
+            raise ValueError("fresh offline validation did not pass")
+        completeness = json.loads(
+            (run_directory / "completeness.json").read_text(encoding="utf-8")
+        )
+        run_metadata = _load_yaml_mapping(
+            run_directory / "metadata.yaml",
+            "stationary preflight metadata",
+        )
+        evidence_manifest = _load_yaml_mapping(
+            run_directory / "configuration" / "manifest.yaml",
+            "stationary preflight evidence manifest",
+        )
+    except (ImportError, OSError, json.JSONDecodeError, ValueError) as exc:
+        raise ValueError(f"stationary preflight evidence is unreadable: {exc}") from exc
+    recording = run_metadata.get("recording")
+    checks = {
+        "completeness passed": isinstance(completeness, dict)
+        and completeness.get("passed") is True,
+        "physical mode": run_metadata.get("mode") == "physical",
+        "scenario unchanged": run_metadata.get("scenario_id")
+        == template.get("scenario_id"),
+        "recording mapping": isinstance(recording, dict),
+        "stationary mode": isinstance(recording, dict)
+        and recording.get("stationary_preflight") is True,
+        "stationary pass": isinstance(recording, dict)
+        and recording.get("stationary_preflight_passed") is True,
+        "readiness never true": isinstance(recording, dict)
+        and recording.get("readiness_ever_true") is False,
+        "clean completion": isinstance(recording, dict)
+        and recording.get("complete") is True
+        and recording.get("final_zero_observed") is True
+        and not recording.get("run_error"),
+    }
+    evidence_files = evidence_manifest.get("files", [])
+    retained_template = next(
+        (
+            item for item in evidence_files
+            if isinstance(item, dict) and item.get("label") == "metadata_template"
+        ),
+        None,
+    )
+    template_hash_before_approval = _sha256_file(template_path)
+    checks["template hash coupled"] = bool(
+        isinstance(retained_template, dict)
+        and retained_template.get("sha256") == template_hash_before_approval
+    )
+    failed = [name for name, passed in checks.items() if not passed]
+    if failed:
+        raise ValueError(
+            "stationary preflight approval is blocked; failed: " + ", ".join(failed)
+        )
+
+    completeness_path = run_directory / "completeness.json"
+    retained_paths = {
+        "metadata_sha256": run_directory / "metadata.yaml",
+        "completeness_sha256": completeness_path,
+        "resolved_topics_sha256": run_directory / "resolved_topics.yaml",
+        "resolved_parameters_sha256": run_directory / "resolved_parameters.yaml",
+        "configuration_manifest_sha256": (
+            run_directory / "configuration" / "manifest.yaml"
+        ),
+        "bag_tree_sha256": run_directory / "bag",
+    }
+    try:
+        retained_hashes = {
+            name: _sha256_path(path)
+            for name, path in retained_paths.items()
+        }
+    except (OSError, ValueError) as exc:
+        raise ValueError(
+            f"stationary preflight retained evidence cannot be sealed: {exc}"
+        ) from exc
+    evidence = {
+        "schema_version": 1,
+        "passed": True,
+        "run_directory": str(run_directory),
+        "template_sha256_before_approval": template_hash_before_approval,
+        "readiness_ever_true": False,
+        "reviewed_at_utc": reviewed,
+        "reviewed_by": reviewer_name,
+        **retained_hashes,
+    }
+    updated = copy.deepcopy(template)
+    updated["physical_readiness"]["stationary_graph_verified"] = True
+    updated["stationary_graph_evidence"] = evidence
+    temporary = template_path.with_name(template_path.name + ".tmp")
+    temporary.write_text(
+        yaml.safe_dump(updated, sort_keys=False),
+        encoding="utf-8",
+    )
+    os.replace(temporary, template_path)
+    return evidence
