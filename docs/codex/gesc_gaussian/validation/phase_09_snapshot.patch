+def test_slow_terminal_cannot_block_durable_logging_or_ros_callbacks(tmp_path):
+    started = threading.Event()
+    release = threading.Event()
+
+    class SlowTerminal:
+        def write(self, _value):
+            started.set()
+            release.wait(timeout=5.0)
+
+        def flush(self):
+            return None
+
+    log_path = tmp_path / "slow-terminal.log"
+    console = recorder._ConsoleCapture(log_path)
+    console.enable_terminal(SlowTerminal())
+    began = time.monotonic()
+    console.log("live", "passive diagnostic")
+    elapsed = time.monotonic() - began
+    assert started.wait(timeout=1.0)
+    began = time.monotonic()
+    console.log("heartbeat", "still durable")
+    second_elapsed = time.monotonic() - began
+    release.set()
+    console.close()
+
+    assert elapsed < 0.1
+    assert second_elapsed < 0.1
+    text = log_path.read_text(encoding="utf-8")
+    assert "passive diagnostic" in text
+    assert "still durable" in text
+
