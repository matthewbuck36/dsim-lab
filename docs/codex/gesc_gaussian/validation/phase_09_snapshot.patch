+def _recursive_keys(value):
+    if isinstance(value, dict):
+        for key, item in value.items():
+            yield str(key)
+            yield from _recursive_keys(item)
+    elif isinstance(value, list):
+        for item in value:
+            yield from _recursive_keys(item)
